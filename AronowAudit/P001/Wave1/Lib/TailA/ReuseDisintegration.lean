import AronowAudit.P001.Wave1.Lib.TailA.MatchingLaw
import AronowAudit.P001.Wave1.Lib.TailA.ReuseProbability

/-! Independent uniform response marks for score-conditional matching calculations. -/

noncomputable section
open MeasureTheory ProbabilityTheory
open scoped BigOperators ENNReal NNReal
namespace AronowAudit.P001.TailA
local instance instDecidableReuseDisintegration (p : Prop) : Decidable p := Classical.propDecidable p
set_option maxHeartbeats 1000000

/-- An independent uniform response mark. -/
def ReuseUniform : Measure ℝ := volume.restrict (Set.Icc 0 1)

instance instProbabilityReuseUniform : IsProbabilityMeasure ReuseUniform := by
  constructor
  norm_num [ReuseUniform,Real.volume_Icc]

/-- The threshold construction retains its exact score-dependent response probability. -/
def reuseResponse (p u : ℝ) : Bool := decide (u ≤ p)

theorem reuse_response_measurable : Measurable (fun x : ℝ × ℝ => reuseResponse x.1 x.2) := by
  apply measurable_to_bool
  change MeasurableSet {x : ℝ × ℝ | decide (x.2 ≤ x.1) = true}
  simpa only [decide_eq_true_eq] using
    (measurableSet_le (measurable_snd : Measurable (fun x : ℝ × ℝ => x.2)) measurable_fst)

theorem reuse_response_threshold (θ : unitInterval) :
    MeasurePreserving (reuseResponse θ) ReuseUniform (bernoulliMeasure true false θ) := by
  have hm : Measurable (reuseResponse θ) :=
    reuse_response_measurable.comp (measurable_const.prodMk measurable_id)
  refine ⟨hm,Measure.ext_of_singleton (fun b => ?_)⟩
  rw [Measure.map_apply hm (measurableSet_singleton b)]
  cases b with
  | true =>
    have hs : reuseResponse θ ⁻¹' ({true} : Set Bool) = Set.Iic (θ : ℝ) := by
      ext x
      simp only [Set.mem_preimage,Set.mem_singleton_iff,reuseResponse,decide_eq_true_eq,Set.mem_Iic]
    rw [hs,ReuseUniform,Measure.restrict_apply measurableSet_Iic]
    have hi : Set.Iic (θ : ℝ) ∩ Set.Icc (0 : ℝ) 1 = Set.Icc (0 : ℝ) (θ : ℝ) := by
      ext x
      simp only [Set.mem_inter_iff,Set.mem_Iic,Set.mem_Icc]
      constructor
      · exact fun h => ⟨h.2.1,h.1⟩
      · exact fun h => ⟨h.2,h.1,h.2.trans θ.2.2⟩
    rw [hi,Real.volume_Icc]
    rw [bernoulliMeasure_apply θ (measurableSet_singleton _)]
    norm_num [unitInterval.toNNReal,ENNReal.ofReal,unitInterval.coe_symm_eq,
      Real.toNNReal_of_nonneg θ.2.1,Real.toNNReal_of_nonneg (sub_nonneg.mpr θ.2.2)]
    rfl
  | false =>
    have hs : reuseResponse θ ⁻¹' ({false} : Set Bool) = Set.Ioi (θ : ℝ) := by
      ext x
      simp only [Set.mem_preimage,Set.mem_singleton_iff,reuseResponse,decide_eq_false_iff_not,
        not_le,Set.mem_Ioi]
    rw [hs,ReuseUniform,Measure.restrict_apply measurableSet_Ioi]
    have hi : Set.Ioi (θ : ℝ) ∩ Set.Icc (0 : ℝ) 1 = Set.Ioc (θ : ℝ) (1 : ℝ) := by
      ext x
      simp only [Set.mem_inter_iff,Set.mem_Ioi,Set.mem_Icc,Set.mem_Ioc]
      constructor
      · exact fun h => ⟨h.1,h.2.2⟩
      · exact fun h => ⟨h.1,θ.2.1.trans h.1.le,h.2⟩
    rw [hi,Real.volume_Ioc]
    rw [bernoulliMeasure_apply θ (measurableSet_singleton _)]
    norm_num [unitInterval.toNNReal,ENNReal.ofReal,unitInterval.coe_symm_eq,
      Real.toNNReal_of_nonneg θ.2.1,Real.toNNReal_of_nonneg (sub_nonneg.mpr θ.2.2)]
    rfl

theorem reuse_design_projection :
    MeasurePreserving (fun z : MatchUnit => (z.1,z.2.1)) matchingUnitLaw MatchingDesignLaw := by
  refine ⟨measurable_fst.prodMk measurable_snd.fst,?_⟩
  rw [← matching_unit_factorization,Measure.map_map
    (measurable_fst.prodMk measurable_snd.fst) MeasurableEquiv.prodAssoc.measurable]
  change (MatchingDesignLaw.prod matchingFairSign).map Prod.fst = MatchingDesignLaw
  simp only [Measure.map_fst_prod,measure_univ,one_smul]

/-- The exact design law is generated by an independent uniform response mark. -/
theorem reuse_design_source :
    MeasurePreserving (fun x : ℝ × ℝ => (x.1,reuseResponse x.1 x.2))
      (MatchingScoreLaw.prod ReuseUniform) MatchingDesignLaw := by
  have hm : Measurable (fun x : ℝ × ℝ => (x.1,reuseResponse x.1 x.2)) :=
    measurable_fst.prodMk reuse_response_measurable
  refine ⟨hm,?_⟩
  apply Measure.ext_of_lintegral
  intro f hf
  rw [lintegral_map hf hm]
  have hfm : Measurable (fun x : ℝ × ℝ => f (x.1,reuseResponse x.1 x.2)) := hf.comp hm
  rw [lintegral_prod _ hfm.aemeasurable]
  rw [← reuse_design_projection.lintegral_comp hf]
  rw [matching_lintegral (fun z => f (z.1,z.2.1))
    (hf.comp (measurable_fst.prodMk measurable_snd.fst))]
  change (∫⁻ p, ∫⁻ u, f (p,reuseResponse p u) ∂ReuseUniform
    ∂(2 : ℝ≥0∞) • volume.restrict (Set.Icc (1/4 : ℝ) (3/4))) = _
  rw [lintegral_smul_measure]
  simp only [smul_eq_mul]
  have hinner : Measurable (fun p => ∫⁻ u, f (p,reuseResponse p u) ∂ReuseUniform) :=
    (hf.comp hm).lintegral_prod_right'
  rw [← lintegral_const_mul _ hinner]
  apply lintegral_congr_ae
  filter_upwards [ae_restrict_mem measurableSet_Icc] with p hp
  let θ : unitInterval := ⟨p,by constructor <;> linarith [hp.1,hp.2]⟩
  have ht : (∫⁻ u, f (p,reuseResponse p u) ∂ReuseUniform) =
      ∫⁻ b, f (p,b) ∂bernoulliMeasure true false θ :=
    (reuse_response_threshold θ).lintegral_comp (Measurable.of_discrete (f := fun b => f (p,b)))
  rw [ht,bernoulliMeasure_def,lintegral_add_measure,
    lintegral_smul_measure,lintegral_smul_measure]
  simp only [lintegral_dirac,smul_eq_mul]
  have hθ : (unitInterval.toNNReal θ : ℝ≥0∞) = ENNReal.ofReal p := by
    simp only [ENNReal.ofReal,unitInterval.toNNReal,θ,Real.toNNReal_of_nonneg
      (show 0 ≤ p by linarith [hp.1])]
    rfl
  have hθ' : (unitInterval.toNNReal (unitInterval.symm θ) : ℝ≥0∞) = ENNReal.ofReal (1-p) := by
    simp only [ENNReal.ofReal,unitInterval.toNNReal,unitInterval.coe_symm_eq,θ,
      Real.toNNReal_of_nonneg (show 0 ≤ 1-p by linarith [hp.2])]
    rfl
  change 2*((unitInterval.toNNReal θ : ℝ≥0∞)*f (p,true)+
    (unitInterval.toNNReal (unitInterval.symm θ) : ℝ≥0∞)*f (p,false)) = _
  rw [hθ,hθ']
  ring

/-- Reattach independent response marks at every original score. -/
def reuseDesignAssemble {n : ℕ} (p u : Fin n → ℝ) : Fin n → MatchingDesign :=
  fun i => (p i,reuseResponse (p i) (u i))

theorem reuse_design_assemble_measurable (n : ℕ) :
    Measurable (fun x : (Fin n → ℝ) × (Fin n → ℝ) => reuseDesignAssemble x.1 x.2) := by
  apply measurable_pi_lambda
  intro i
  have hc : Measurable (fun x : (Fin n → ℝ) × (Fin n → ℝ) => (x.1 i,x.2 i)) :=
    ((measurable_pi_apply i).comp measurable_fst).prodMk
      ((measurable_pi_apply i).comp measurable_snd)
  have hr := reuse_response_measurable.comp hc
  simpa only [reuseDesignAssemble,Function.comp_def] using
    ((measurable_pi_apply i).comp measurable_fst).prodMk hr

theorem reuse_design_product_source (n : ℕ) :
    MeasurePreserving (fun x : (Fin n → ℝ) × (Fin n → ℝ) => reuseDesignAssemble x.1 x.2)
      ((Measure.pi fun _ : Fin n => MatchingScoreLaw).prod
        (Measure.pi fun _ : Fin n => ReuseUniform)) (MatchingDesignProduct n) := by
  have hpi := measurePreserving_pi (fun _ : Fin n => MatchingScoreLaw.prod ReuseUniform)
    (fun _ => MatchingDesignLaw) (fun _ => reuse_design_source)
  have hs := measurePreserving_arrowProdEquivProdArrow ℝ ℝ (Fin n)
    (fun _ => MatchingScoreLaw) (fun _ => ReuseUniform)
  exact hpi.comp (hs.symm (MeasurableEquiv.arrowProdEquivProdArrow ℝ ℝ (Fin n)))

/-- Fubini for the score/response-mark source. -/
theorem reuse_design_integral {n : ℕ} {f : (Fin n → MatchingDesign) → ℝ}
    (hf : Measurable f) (hi : Integrable f (MatchingDesignProduct n)) :
    mean (MatchingDesignProduct n) f =
      mean (Measure.pi fun _ : Fin n => MatchingScoreLaw) (fun p =>
        mean (Measure.pi fun _ : Fin n => ReuseUniform) (fun u => f (reuseDesignAssemble p u))) := by
  unfold mean
  rw [← (reuse_design_product_source n).map_eq,
    integral_map (reuse_design_assemble_measurable n).aemeasurable hf.aestronglyMeasurable]
  exact integral_prod _ ((reuse_design_product_source n).integrable_comp_of_integrable hi)

/-- Disintegrate a sign-independent sample functional using independent response marks. -/
theorem reuse_response_disintegration {n : ℕ} {F : (Fin n → MatchUnit) → ℝ}
    (hf : Measurable F) (hi : Integrable F (MatchProduct n))
    (hF : ∀ d e, F (matchingAssemble d e) = F (matchingAssemble d (fun _ => false))) :
    mean (MatchProduct n) F =
      mean (Measure.pi fun _ : Fin n => MatchingScoreLaw) (fun p =>
        mean (Measure.pi fun _ : Fin n => ReuseUniform) (fun u =>
          F (matchingAssemble (reuseDesignAssemble p u) (fun _ => false)))) := by
  let G (d : Fin n → MatchingDesign) : ℝ := F (matchingAssemble d (fun _ => false))
  have hm : Measurable G := hf.comp ((matching_assemble_measurable n).comp
    (measurable_id.prodMk measurable_const))
  have hinner (d : Fin n → MatchingDesign) :
      mean (signProductLaw n) (fun e => F (matchingAssemble d e)) = G d := by
    calc
      _ = ∫ _e : Fin n → Bool, G d ∂signProductLaw n :=
        integral_congr_ae (ae_of_all _ (hF d))
      _ = G d := by simp
  have hdi : Integrable G (MatchingDesignProduct n) := by
    have h := ((matching_sign_factorization n).integrable_comp_of_integrable hi).integral_prod_left
    change Integrable (fun d => mean (signProductLaw n)
      (fun e => F (matchingAssemble d e))) (MatchingDesignProduct n) at h
    simpa only [hinner] using h
  rw [matching_sign_expectation hf hi]
  simp_rw [hinner]
  exact reuse_design_integral hm hdi

/-- Under fixed scores, the independent response marks have the product Bernoulli law. -/
theorem reuse_responses_law {n : ℕ} (θ : Fin n → unitInterval) :
    MeasurePreserving (fun u : Fin n → ℝ => fun i => reuseResponse (θ i) (u i))
      (Measure.pi fun _ : Fin n => ReuseUniform) (ReuseResponseLaw θ) :=
    measurePreserving_pi (fun _ : Fin n => ReuseUniform)
      (fun i => bernoulliMeasure true false (θ i)) (fun i => reuse_response_threshold (θ i))

theorem reuse_response_integral {n : ℕ} (θ : Fin n → unitInterval)
    (g : (Fin n → Bool) → ℝ) :
    mean (Measure.pi fun _ : Fin n => ReuseUniform)
      (fun u => g (fun i => reuseResponse (θ i) (u i))) = mean (ReuseResponseLaw θ) g := by
  unfold mean
  rw [← (reuse_responses_law θ).map_eq,
    integral_map (reuse_responses_law θ).measurable.aemeasurable
      (Measurable.of_discrete (f := g)).aestronglyMeasurable]

/-- The pinned central response is literally true, rather than a conditional probability. -/
theorem reuse_pinned_response_integral {n : ℕ} (θ : Fin n → unitInterval)
    (f : (Fin (n+1) → Bool) → ℝ) :
    mean (ReuseResponseLaw (Fin.cases 1 θ)) f =
      mean (ReuseResponseLaw θ) (fun r => f (Fin.cases true r)) := by
  unfold mean ReuseResponseLaw
  rw [← ((measurePreserving_piFinSuccAbove
    (fun i : Fin (n+1) => bernoulliMeasure true false (Fin.cases 1 θ i)) 0).symm).integral_comp']
  simp only [Fin.cases_zero,Fin.cases_succ,Fin.zero_succAbove,bernoulliMeasure_one,
    MeasurableEquiv.piFinSuccAbove_symm_apply,Fin.insertNthEquiv,Fin.insertNth_zero]
  rw [integral_prod _ Integrable.of_finite]
  simp only [integral_dirac]
  rfl

/-- Almost every score vector lies in the stated support and has distinct coordinates. -/
theorem reuse_scores_good (n : ℕ) :
    ∀ᵐ p ∂Measure.pi (fun _ : Fin n => MatchingScoreLaw),
      (∀ i, p i ∈ Set.Icc (1/4 : ℝ) (3/4)) ∧ Function.Injective p := by
  have hs : ∀ᵐ p ∂Measure.pi (fun _ : Fin n => MatchingScoreLaw),
      ∀ i, p i ∈ Set.Icc (1/4 : ℝ) (3/4) := by
    apply ae_all_iff.mpr
    intro i
    have hscalar : ∀ᵐ p ∂MatchingScoreLaw, p ∈ Set.Icc (1/4 : ℝ) (3/4) :=
      Measure.ae_smul_measure (ae_restrict_mem measurableSet_Icc) 2
    have hmapped : ∀ᵐ p ∂(Measure.pi (fun _ : Fin n => MatchingScoreLaw)).map (fun p => p i),
        p ∈ Set.Icc (1/4 : ℝ) (3/4) := by
      rw [(measurePreserving_eval (fun _ : Fin n => MatchingScoreLaw) i).map_eq]
      exact hscalar
    exact ae_of_ae_map (measurable_pi_apply i).aemeasurable hmapped
  have hi : ∀ᵐ p ∂Measure.pi (fun _ : Fin n => MatchingScoreLaw), Function.Injective p := by
    have hall : ∀ᵐ p ∂Measure.pi (fun _ : Fin n => MatchingScoreLaw),
        ∀ i j, i ≠ j → p i ≠ p j := by
      apply ae_all_iff.mpr
      intro i
      apply ae_all_iff.mpr
      intro j
      by_cases hij : i = j
      · exact ae_of_all _ (fun _ h => False.elim (h hij))
      · exact (matching_score_ne i j hij).mono (fun _ h _ => h)
    filter_upwards [hall] with p hp
    intro i j hij
    by_contra hne
    exact hp i j hne hij
  exact hs.and hi

/-- A fixed pinned score is distinct from every independent score almost surely. -/
theorem reuse_pinned_scores_good (n : ℕ) (p₀ : ℝ) :
    ∀ᵐ p ∂Measure.pi (fun _ : Fin n => MatchingScoreLaw),
      Function.Injective (Fin.cases p₀ p) := by
  have hneq : ∀ᵐ p ∂Measure.pi (fun _ : Fin n => MatchingScoreLaw), ∀ i, p i ≠ p₀ := by
    apply ae_all_iff.mpr
    intro i
    exact matching_score_avoid i (fun _ => p₀) measurable_const (fun _ _ => rfl)
  filter_upwards [reuse_scores_good n,hneq] with p hp hn
  intro i
  refine Fin.cases ?_ (fun i => ?_) i
  · intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · intro _; rfl
    · intro h
      exact False.elim (hn j (by simpa using h.symm))
  · intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · intro h
      exact False.elim (hn i (by simpa using h))
    · intro h
      exact congrArg Fin.succ (hp.2 (by simpa using h))

/-- A uniform conditional bound transfers to the actual iid matching experiment. -/
theorem reuse_transfer_conditional_bound {n : ℕ}
    (f : (Fin n → ℝ) → (Fin n → Bool) → ℝ) {C : ℝ}
    (hf : Measurable (fun z : Fin n → MatchUnit => f (fun i => (z i).1) (fun i => (z i).2.1)))
    (hi : Integrable (fun z : Fin n → MatchUnit => f (fun i => (z i).1) (fun i => (z i).2.1)) (MatchProduct n))
    (h0 : ∀ p r, 0 ≤ f p r)
    (hb : ∀ p, Function.Injective p → ∀ θ : Fin n → unitInterval,
      (∀ i, (1/4 : ℝ) ≤ θ i) → mean (ReuseResponseLaw θ) (f p) ≤ C) :
    mean (MatchProduct n) (fun z => f (fun i => (z i).1) (fun i => (z i).2.1)) ≤ C := by
  rw [reuse_response_disintegration hf hi (fun _ _ => rfl)]
  have hle : (∫ p, mean (Measure.pi fun _ : Fin n => ReuseUniform)
      (fun u => f p (fun i => reuseResponse (p i) (u i)))
      ∂Measure.pi (fun _ : Fin n => MatchingScoreLaw)) ≤
        ∫ _p : Fin n → ℝ, C ∂Measure.pi (fun _ : Fin n => MatchingScoreLaw) := by
    apply integral_mono_of_nonneg
    · exact ae_of_all _ (fun p => integral_nonneg (fun u => h0 p _))
    · exact integrable_const _
    · filter_upwards [reuse_scores_good n] with p hp
      let θ : Fin n → unitInterval := fun i => ⟨p i,by constructor <;> linarith [(hp.1 i).1,(hp.1 i).2]⟩
      have hθ : ∀ i, (1/4 : ℝ) ≤ θ i := fun i => (hp.1 i).1
      change mean (Measure.pi fun _ : Fin n => ReuseUniform)
        (fun u => f p (fun i => reuseResponse (θ i) (u i))) ≤ C
      rw [reuse_response_integral θ (f p)]
      exact hb p hp.2 θ hθ
  simpa only [mean,matchingAssemble,reuseDesignAssemble,integral_const,probReal_univ,
    smul_eq_mul,one_mul] using hle

/-- Transfer for the explicitly pinned experiment, with an independent true central response. -/
theorem reuse_transfer_pinned_bound {n : ℕ} (p₀ : ℝ)
    (f : (Fin (n+1) → ℝ) → (Fin (n+1) → Bool) → ℝ) {C : ℝ}
    (hf : Measurable (fun z : Fin n → MatchUnit =>
      f (Fin.cases p₀ (fun i => (z i).1)) (Fin.cases true (fun i => (z i).2.1))))
    (hi : Integrable (fun z : Fin n → MatchUnit =>
      f (Fin.cases p₀ (fun i => (z i).1)) (Fin.cases true (fun i => (z i).2.1))) (MatchProduct n))
    (h0 : ∀ p r, 0 ≤ f p r)
    (hb : ∀ p, Function.Injective p → ∀ θ : Fin (n+1) → unitInterval,
      (∀ i, (1/4 : ℝ) ≤ θ i) → mean (ReuseResponseLaw θ) (f p) ≤ C) :
    mean (MatchProduct n) (fun z =>
      f (Fin.cases p₀ (fun i => (z i).1)) (Fin.cases true (fun i => (z i).2.1))) ≤ C := by
  rw [reuse_response_disintegration hf hi (fun _ _ => rfl)]
  have hle : (∫ p, mean (Measure.pi fun _ : Fin n => ReuseUniform)
      (fun u => f (Fin.cases p₀ p) (Fin.cases true (fun i => reuseResponse (p i) (u i))))
      ∂Measure.pi (fun _ : Fin n => MatchingScoreLaw)) ≤
        ∫ _p : Fin n → ℝ, C ∂Measure.pi (fun _ : Fin n => MatchingScoreLaw) := by
    apply integral_mono_of_nonneg
    · exact ae_of_all _ (fun p => integral_nonneg (fun u => h0 _ _))
    · exact integrable_const _
    · filter_upwards [reuse_scores_good n,reuse_pinned_scores_good n p₀] with p hp hpin
      let θ : Fin n → unitInterval := fun i => ⟨p i,by constructor <;> linarith [(hp.1 i).1,(hp.1 i).2]⟩
      have hθ : ∀ i : Fin (n+1), (1/4 : ℝ) ≤ (Fin.cases 1 θ i : unitInterval) := by
        intro i
        refine Fin.cases ?_ (fun i => ?_) i
        · norm_num
        · exact (hp.1 i).1
      change mean (Measure.pi fun _ : Fin n => ReuseUniform)
        (fun u => (fun r => f (Fin.cases p₀ p) (Fin.cases true r))
          (fun i => reuseResponse (θ i) (u i))) ≤ C
      rw [reuse_response_integral θ (fun r => f (Fin.cases p₀ p) (Fin.cases true r)),
        ← reuse_pinned_response_integral θ (f (Fin.cases p₀ p))]
      exact hb _ hpin (Fin.cases 1 θ) hθ
  simpa only [mean,matchingAssemble,reuseDesignAssemble,integral_const,probReal_univ,
    smul_eq_mul,one_mul] using hle

theorem reuse_pin_scores (n : ℕ) (p : ℝ) (z : Fin n → MatchUnit) :
    (fun i => (pin n p z i).1) = Fin.cases p (fun i => (z i).1) := by
  funext i
  exact Fin.cases rfl (fun _ => rfl) i

theorem reuse_pin_responses (n : ℕ) (p : ℝ) (z : Fin n → MatchUnit) :
    (fun i => (pin n p z i).2.1) = Fin.cases true (fun i => (z i).2.1) := by
  funext i
  exact Fin.cases rfl (fun _ => rfl) i

theorem reuse_pin_map_measurable (n : ℕ) (p : ℝ) : Measurable (pin n p) :=
  (matching_pin_measurable n).comp (measurable_const.prodMk measurable_id)

end AronowAudit.P001.TailA
