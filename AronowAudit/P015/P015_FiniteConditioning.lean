import Mathlib.Probability.Independence.Basic
import Mathlib.Probability.Kernel.Condexp
import Mathlib.Probability.Independence.Conditional
import Mathlib.Tactic
namespace AronowAudit.P015.FiniteConditioning
open MeasureTheory ProbabilityTheory Set Filter
open scoped ENNReal ProbabilityTheory Topology
noncomputable section
set_option backward.isDefEq.respectTransparency false

/-- On a positive fiber of a measurable covariate, its conditional expectation
is the ordinary expectation for the normalized restricted law. -/
lemma condExp_on_fiber {Ω B : Type*} [mΩ : MeasurableSpace Ω] [mB : MeasurableSpace B]
    [MeasurableSingletonClass B] (μ : Measure Ω) [IsFiniteMeasure μ]
    (X : Ω → B) (hX : Measurable X) (x : B) (f : Ω → ℝ) (hf : Integrable f μ) :
    μ[f | MeasurableSpace.comap X inferInstance] =ᵐ[μ.restrict {s | X s=x}]
      (fun _=> ∫ s,f s∂μ[|{s | X s=x}]) := by
  let m := MeasurableSpace.comap X mB
  let S : Set Ω := {s | X s=x}
  have hm : m ≤ mΩ := hX.comap_le
  have hS : MeasurableSet[mΩ] S := hX (measurableSet_singleton x)
  have hSm : MeasurableSet[m] S := ⟨{x},measurableSet_singleton x,rfl⟩
  by_cases hzero : μ S=0
  · rw [show {s | X s=x}=S from rfl,Measure.restrict_eq_zero.mpr hzero]
    rfl
  refine (condExp_restrict_ae_eq_restrict hm hSm hf).symm.trans ?_
  refine (ae_eq_condExp_of_forall_setIntegral_eq hm hf.restrict
    (fun t ht hfin=>by rw [integrableOn_const_iff];exact Or.inr hfin) ?_
    stronglyMeasurable_const.aestronglyMeasurable).symm
  intro t ht hfin
  rcases ht with ⟨A,hA,rfl⟩
  have hAt : MeasurableSet[mΩ] (X ⁻¹' A) := hX hA
  by_cases hx : x∈A
  · have hinter : (X ⁻¹' A)∩S=S := by
      ext s
      simp only [mem_inter_iff,mem_preimage,S,mem_setOf_eq]
      constructor
      · exact And.right
      · intro h
        exact ⟨h ▸ hx,h⟩
    rw [Measure.restrict_restrict hAt,hinter]
    simp only [integral_const,Measure.real,Measure.restrict_apply_univ,smul_eq_mul,
      ProbabilityTheory.cond,integral_smul_measure,ENNReal.toReal_inv]
    change (μ S).toReal*((μ S).toReal⁻¹*(∫s in S,f s∂μ))=(∫s in S,f s∂μ)
    rw [mul_inv_cancel_left₀ (ENNReal.toReal_ne_zero.mpr ⟨hzero,measure_ne_top _ _⟩)]
  · have hinter : (X ⁻¹' A)∩S=∅ := by
      ext s
      simp only [mem_inter_iff,mem_preimage,S,mem_setOf_eq,mem_empty_iff_false,iff_false]
      rintro ⟨ha,heq⟩
      exact hx (heq ▸ ha)
    rw [Measure.restrict_restrict hAt,hinter]
    simp

/-- For a finite supported covariate, independence in each normalized fiber
implies conditional independence for the sigma algebra generated by that covariate. -/
lemma condIndep_of_fiber_indep {Ω B E F : Type*} [mΩ : MeasurableSpace Ω]
    [MeasurableSpace B] [MeasurableSingletonClass B] [MeasurableSpace E] [MeasurableSpace F]
    [StandardBorelSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : Ω → B) (hX : Measurable X) (S : Finset B) (hs : ∀ᵐ ω∂μ,X ω∈S)
    (f : Ω → E) (g : Ω → F) (hf : Measurable f) (hg : Measurable g)
    (hind : ∀x∈S,IndepFun f g μ[|{ω | X ω=x}]) :
    CondIndepFun (MeasurableSpace.comap X inferInstance) hX.comap_le f g μ := by
  rw [condIndepFun_iff_condExp_inter_preimage_eq_mul hf hg]
  intro A C hA hC
  have hfa : MeasurableSet (f ⁻¹' A) := hf hA
  have hgc : MeasurableSet (g ⁻¹' C) := hg hC
  have hboth : MeasurableSet (f ⁻¹' A∩g ⁻¹' C) := hfa.inter hgc
  have hx (x : B) (hx : x∈S) : ∀ᵐ ω∂μ,X ω=x →
      (μ⟦f ⁻¹' A∩g ⁻¹' C | MeasurableSpace.comap X inferInstance⟧) ω=
        (μ⟦f ⁻¹' A | MeasurableSpace.comap X inferInstance⟧) ω*
          (μ⟦g ⁻¹' C | MeasurableSpace.comap X inferInstance⟧) ω := by
    apply (ae_restrict_iff' (hX (measurableSet_singleton x))).mp
    have h1 := condExp_on_fiber μ X hX x ((f ⁻¹' A∩g ⁻¹' C).indicator (fun _=>(1:ℝ)))
      ((integrable_const 1).indicator hboth)
    have h2 := condExp_on_fiber μ X hX x ((f ⁻¹' A).indicator (fun _=>(1:ℝ)))
      ((integrable_const 1).indicator hfa)
    have h3 := condExp_on_fiber μ X hX x ((g ⁻¹' C).indicator (fun _=>(1:ℝ)))
      ((integrable_const 1).indicator hgc)
    have hfact := congrArg ENNReal.toReal ((hind x hx).measure_inter_preimage_eq_mul A C hA hC)
    simp only [ENNReal.toReal_mul] at hfact
    filter_upwards [h1,h2,h3] with ω h1 h2 h3
    rw [h1,h2,h3]
    rw [integral_indicator_const (1:ℝ) hboth,integral_indicator_const (1:ℝ) hfa,integral_indicator_const (1:ℝ) hgc]
    simpa only [smul_eq_mul,mul_one,Measure.real] using hfact
  have hall := (eventually_all_finset S).mpr hx
  filter_upwards [hs,hall] with ω hω hωall
  exact hωall (X ω) hω rfl

/-- Identify a conditional mean by its ordinary mean on every supported fiber. -/
lemma condExp_eq_of_fiber_integrals {Ω B : Type*} [MeasurableSpace Ω]
    [MeasurableSpace B] [MeasurableSingletonClass B] (μ : Measure Ω) [IsFiniteMeasure μ]
    (X : Ω → B) (hX : Measurable X) (S : Finset B) (hs : ∀ᵐ ω∂μ,X ω∈S)
    (f : Ω → ℝ) (hf : Integrable f μ) (m : B → ℝ)
    (hmean : ∀x∈S,(∫ω,f ω∂μ[|{s | X s=x}])=m x) :
    μ[f | MeasurableSpace.comap X inferInstance] =ᵐ[μ] (fun ω=>m (X ω)) := by
  have hx (x : B) (hx : x∈S) : ∀ᵐ ω∂μ,X ω=x →
      μ[f | MeasurableSpace.comap X inferInstance] ω=m (X ω) := by
    apply (ae_restrict_iff' (hX (measurableSet_singleton x))).mp
    filter_upwards [condExp_on_fiber μ X hX x f hf,ae_restrict_mem (hX (measurableSet_singleton x))] with ω hω heq
    change X ω=x at heq
    rw [hω,hmean x hx,heq]
  filter_upwards [hs,(eventually_all_finset S).mpr hx] with ω hω hall
  exact hall (X ω) hω rfl

end
end AronowAudit.P015.FiniteConditioning
