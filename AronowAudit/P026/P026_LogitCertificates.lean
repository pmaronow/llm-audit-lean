def expPolynomial (t:ℝ):ℝ:=∑k∈range 24,t^k/(k.factorial:ℝ)
def expError (t:ℝ):ℝ:=|t|^24*((25:ℝ)/(((Nat.factorial 24:ℕ):ℝ)*24))

lemma exp_bounds_from_quarter (t l u L U:ℝ) (ht:|t/4|≤1) (hl:0≤l)
    (hpl:l≤expPolynomial (t/4)-expError (t/4))
    (hpu:expPolynomial (t/4)+expError (t/4)≤u)
    (hL:L≤l^4) (hU:u^4≤U):L≤Real.exp t∧Real.exp t≤U:=by
  have he:=Real.exp_bound (n:=24) ht (by norm_num)
  change |Real.exp (t/4)-expPolynomial (t/4)|≤expError (t/4) at he
  obtain ⟨heL,heU⟩:=abs_le.mp he
  have hlE:l≤Real.exp (t/4):=by linarith
  have huE:Real.exp (t/4)≤u:=by linarith
  have hex:Real.exp t=(Real.exp (t/4))^4:=by
    rw [←Real.exp_nat_mul]
    congr 1
    ring
  rw [hex]
  exact ⟨hL.trans (pow_le_pow_left₀ hl hlE 4),
    (pow_le_pow_left₀ (Real.exp_pos _).le huE 4).trans hU⟩

def logisticRatio (t:ℝ):ℝ:=Real.exp t/(1+Real.exp t)

lemma probability_bounds_from_exp (t L U p q:ℝ) (hL:0≤L)
    (he:L≤Real.exp t∧Real.exp t≤U)
    (hp:p≤L/(1+L)) (hq:U/(1+U)≤q):p≤logisticRatio t∧logisticRatio t≤q:=by
  have hu:0≤U:=le_trans (Real.exp_pos t).le he.2
  have hlo:0<1+L:=by positivity
  have hhi:0<1+U:=by positivity
  have hex:0<1+Real.exp t:=by positivity
  refine ⟨hp.trans ?_,le_trans ?_ hq⟩
  · unfold logisticRatio
    rw [div_le_div_iff₀ hlo hex]
    nlinarith [he.1]
  · unfold logisticRatio
    rw [div_le_div_iff₀ hex hhi]
    nlinarith [he.2]

