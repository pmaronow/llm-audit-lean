/-!
# P036: corrected unadjusted regression and HC2 claims

Source: Aronow et al., *Information and Access to United Nations Diplomatic
Missions*, printed pp. 595–596 (PDF pp. 2–3). P036-T1 and P036-T2.
The latter uses a finite-population setting and makes no claim about the
four adjusted specifications. Units may be any finite type, thus including
`Fin 189` in the paper.
-/

namespace AronowAudit.P036

open scoped BigOperators
open Finset

noncomputable section

/-- Corrected Section III, pp. 595–596: “Peers represents the peer assignment
indicator.” Membership in the peer arm gives one; world affairs gives zero. -/
def peers {ι : Type*} (peerArm : Set ι) (i : ι) : ℝ :=
  peerArm.indicator (fun _ => 1) i

/-- Section II, p. 595: “any response”, “for any type of reply to the email”.
The set argument consists of missions with such a reply. -/
def anyResponse {ι : Type*} (replied : Set ι) (i : ι) : ℝ :=
  replied.indicator (fun _ => 1) i

/-- Section II, p. 595: “interest response” for “emails that had some indication
of interest”. The table note requires this set to be a subset of `replied`. -/
def interestResponse {ι : Type*} (interested : Set ι) (i : ι) : ℝ :=
  interested.indicator (fun _ => 1) i

open MeasureTheory

/-- Section III, p. 596: “X represents the vector of covariates, including
country-level covariates and indicators for region.” This is `Xγ` for a
finite real covariate vector and a real coefficient vector. -/
def covariateContribution {Ω : Type*} {k : ℕ}
    (X : Ω → Fin k → ℝ) (γ : Fin k → ℝ) (ω : Ω) : ℝ :=
  ∑ j, X ω j * γ j

/-- The deterministic part `β₀+β₁ Peers+Xγ` of the displayed regression,
Section III, p. 595. The corrected roles are enforced by types: `Peers`
is a function taking values zero/one and `β₁` is its real coefficient. -/
def linearPredictor {Ω : Type*} {k : ℕ} (peer : Set Ω)
    (X : Ω → Fin k → ℝ) (β₀ β₁ : ℝ) (γ : Fin k → ℝ) (ω : Ω) : ℝ :=
  β₀ + β₁ * peers peer ω + covariateContribution X γ ω

/-- The sigma-algebra generated by the printed regressors `(Peers,X)`,
for the assumption `E[ε|Peers,X]=0`, Section III, p. 596 (T1(i)). -/
def regressorSigma {Ω : Type*} {k : ℕ} (peer : Set Ω)
    (X : Ω → Fin k → ℝ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω => (peers peer ω, X ω)) inferInstance

/-- The sigma-algebra generated by `Peers` when covariates are absent,
for the unadjusted regression in Section III, p. 596 (T1(i)). -/
def assignmentSigma {Ω : Type*} (peer : Set Ω) : MeasurableSpace Ω :=
  MeasurableSpace.comap (peers peer) inferInstance

/-- Conditional mean in an arm of positive probability: the integral
over that arm divided by its probability, T1(i). -/
def conditionalArmMean {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (arm : Set Ω) (Y : Ω → ℝ) : ℝ :=
  (∫ ω in arm, Y ω ∂μ) / μ.real arm

/-- General conditional-expectation step used for the printed regression
assumption, T1(i), Section III p. 596: a measurable integrable predictor
plus an integrable disturbance of conditional mean zero has that predictor
as its conditional mean, almost surely. -/
theorem conditional_mean_of_model {Ω : Type*} [m₀ : MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (m : MeasurableSpace Ω)
    (hm : m ≤ m₀) (Y f ε : Ω → ℝ)
    (hf : Integrable f μ) (he : Integrable ε μ)
    (hfm : StronglyMeasurable[m] f)
    (hmodel : Y =ᵐ[μ] (fun ω => f ω + ε ω))
    (hzero : μ[ε | m] =ᵐ[μ] (fun _ => 0)) :
    μ[Y | m] =ᵐ[μ] f := by
  have hcongr := condExp_congr_ae hmodel (m := m)
  have hadd := condExp_add hf he m
  rw [condExp_of_stronglyMeasurable hm hfm hf] at hadd
  filter_upwards [hcongr, hadd, hzero] with ω h₁ h₂ h₃
  simpa [h₃] using h₁.trans h₂

/-- Corrected Section III model, T1(i): under the printed zero conditional
mean assumption on ε and the target's integrability hypotheses,
`E[Y|Peers,X]=β₀+β₁ Peers+Xγ` almost surely. This uses the actual
sigma-algebra generated by the regressors and a probability measure. -/
theorem corrected_model_conditional_mean {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] {k : ℕ}
    (peer : Set Ω) (hpeer : MeasurableSet peer) (X : Ω → Fin k → ℝ)
    (hX : Measurable X) (β₀ β₁ : ℝ) (γ : Fin k → ℝ) (Y ε : Ω → ℝ)
    (he : Integrable ε μ) (hxγ : Integrable (covariateContribution X γ) μ)
    (hmodel : Y =ᵐ[μ] (fun ω => linearPredictor peer X β₀ β₁ γ ω + ε ω))
    (hzero : μ[ε | regressorSigma peer X] =ᵐ[μ] (fun _ => 0)) :
    μ[Y | regressorSigma peer X] =ᵐ[μ] linearPredictor peer X β₀ β₁ γ := by
  have hp : Measurable (peers peer) := measurable_const.indicator hpeer
  have hpi : Integrable (peers peer) μ := (integrable_const (1 : ℝ)).indicator hpeer
  have hf : Integrable (linearPredictor peer X β₀ β₁ γ) μ :=
    ((integrable_const β₀).add (hpi.const_mul β₁)).add hxγ
  have ht : Measurable[regressorSigma peer X] (fun ω => (peers peer ω, X ω)) :=
    comap_measurable _
  have hp' : Measurable[regressorSigma peer X] (peers peer) := measurable_fst.comp ht
  have hx' : Measurable[regressorSigma peer X] (covariateContribution X γ) := by
    apply Finset.measurable_fun_sum
    intro j hj
    exact ((measurable_pi_apply j).comp (measurable_snd.comp ht)).mul measurable_const
  have hfm : StronglyMeasurable[regressorSigma peer X] (linearPredictor peer X β₀ β₁ γ) :=
    ((measurable_const.add (measurable_const.mul hp')).add hx').stronglyMeasurable
  exact conditional_mean_of_model μ (regressorSigma peer X)
    ((hp.prodMk hX).comap_le) Y _ ε hf he hfm hmodel hzero

/-- Corrected unadjusted model, T1(i), Section III p. 596: if both arms
have positive probability and the disturbance has conditional mean zero
given the peer indicator, the control conditional mean is β₀ and the
peer-minus-control conditional mean is β₁. -/
theorem unadjusted_conditional_means {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (peer : Set Ω)
    (hpeer : MeasurableSet peer) (β₀ β₁ : ℝ) (Y ε : Ω → ℝ)
    (he : Integrable ε μ)
    (hmodel : Y =ᵐ[μ] (fun ω => β₀ + β₁ * peers peer ω + ε ω))
    (hzero : μ[ε | assignmentSigma peer] =ᵐ[μ] (fun _ => 0))
    (hp₀ : 0 < μ.real peer) (hp₁ : μ.real peer < 1) :
    conditionalArmMean μ peer Y - conditionalArmMean μ peerᶜ Y = β₁ ∧
    conditionalArmMean μ peerᶜ Y = β₀ := by
  classical
  let f : Ω → ℝ := fun ω => β₀ + β₁ * peers peer ω
  have hp : Measurable (peers peer) := measurable_const.indicator hpeer
  have hpi : Integrable (peers peer) μ := (integrable_const (1 : ℝ)).indicator hpeer
  have hf : Integrable f μ := (integrable_const β₀).add (hpi.const_mul β₁)
  have hfm : StronglyMeasurable[assignmentSigma peer] f :=
    (measurable_const.add (measurable_const.mul (comap_measurable (peers peer)))).stronglyMeasurable
  have hm : assignmentSigma peer ≤ ‹MeasurableSpace Ω› := hp.comap_le
  have hcond := conditional_mean_of_model μ (assignmentSigma peer) hm Y f ε hf he hfm hmodel hzero
  have hY : Integrable Y μ := (hf.add he).congr hmodel.symm
  have hA : MeasurableSet[assignmentSigma peer] peer := by
    refine ⟨{(1 : ℝ)}, measurableSet_singleton 1, ?_⟩
    ext ω
    by_cases h : ω ∈ peer <;> simp [peers, h]
  have hI₁ : (∫ ω in peer, Y ω ∂μ) = μ.real peer * (β₀ + β₁) := by
    calc
      _ = ∫ ω in peer, μ[Y | assignmentSigma peer] ω ∂μ :=
        (setIntegral_condExp hm hY hA).symm
      _ = ∫ ω in peer, f ω ∂μ :=
        setIntegral_congr_ae hpeer (hcond.mono fun ω h _ => h)
      _ = ∫ _ω in peer, (β₀ + β₁) ∂μ := by
        apply setIntegral_congr_fun hpeer
        intro ω hω
        simp [f, peers, hω]
      _ = _ := by simp [setIntegral_const, smul_eq_mul]
  have hI₀ : (∫ ω in peerᶜ, Y ω ∂μ) = μ.real peerᶜ * β₀ := by
    calc
      _ = ∫ ω in peerᶜ, μ[Y | assignmentSigma peer] ω ∂μ :=
        (setIntegral_condExp hm hY hA.compl).symm
      _ = ∫ ω in peerᶜ, f ω ∂μ :=
        setIntegral_congr_ae hpeer.compl (hcond.mono fun ω h _ => h)
      _ = ∫ _ω in peerᶜ, β₀ ∂μ := by
        apply setIntegral_congr_fun hpeer.compl
        intro ω hω
        have hn : ω ∉ peer := hω
        simp [f, peers, hn]
      _ = _ := by simp [setIntegral_const, smul_eq_mul]
  have hnc : μ.real peerᶜ ≠ 0 := by
    rw [probReal_compl_eq_one_sub hpeer]
    linarith
  have hmp : conditionalArmMean μ peer Y = β₀ + β₁ := by
    unfold conditionalArmMean
    rw [hI₁]
    field_simp
  have hmc : conditionalArmMean μ peerᶜ Y = β₀ := by
    unfold conditionalArmMean
    rw [hI₀]
    field_simp
  rw [hmp, hmc]
  constructor <;> ring

/-- Section III, p. 596: the “difference-in-means” uses the sample mean in
each assignment arm. The formula and unit index are supplied in target T1. -/
def armMean {ι : Type*} (s : Finset ι) (Y : ι → ℝ) : ℝ :=
  (∑ i ∈ s, Y i) / (s.card : ℝ)

/-- Sum of squared deviations from an arm mean, for the OLS residuals and
the sample variance in P036-T2. -/
def armSS {ι : Type*} (s : Finset ι) (Y : ι → ℝ) : ℝ :=
  ∑ i ∈ s, (Y i - armMean s Y) ^ 2

/-- Sample variance with divisor `n_w - 1`, as in P036-T2;
this is not a population variance. -/
def sampleVariance {ι : Type*} (s : Finset ι) (Y : ι → ℝ) : ℝ :=
  armSS s Y / ((s.card : ℝ) - 1)

/-- The OLS objective for “an ordinary least squares (OLS) regression of the
outcomes on an indicator for assignment to peer treatment”, Section III,
p. 595, with an intercept and no covariates (specifications (1) and (4)). -/
def rss {ι : Type*} [Fintype ι] (s : Finset ι) (Y : ι → ℝ)
    (b₀ b₁ : ℝ) : ℝ :=
  ∑ i, (Y i - b₀ - b₁ * peers (s : Set ι) i) ^ 2

/-- Candidate intercept and peer coefficient. `ols_unique_minimizer` proves
that these are exactly the unique minimizer of the OLS objective, as claimed
by the corrected Section III passage, pp. 595–596. -/
def olsCoefficients {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) : ℝ × ℝ :=
  (armMean sᶜ Y, armMean s Y - armMean sᶜ Y)

/-- The corrected assignment indicator is binary (T1(i), Section III). -/
theorem peers_binary {ι : Type*} (s : Set ι) (i : ι) :
    peers s i = 0 ∨ peers s i = 1 := by
  classical
  by_cases h : i ∈ s <;> simp [peers, h]

/-- Table 1 note, p. 595: “Interest responses are a subset of any
responses.” The hypothesis carries the paper's subset relation. -/
theorem interest_is_subset {ι : Type*} (replied interested : Set ι)
    (h : interested ⊆ replied) (i : ι) :
    interestResponse interested i ≤ anyResponse replied i := by
  classical
  by_cases hi : i ∈ interested
  · simp [interestResponse, anyResponse, hi, h hi]
  · simp [interestResponse, hi, anyResponse]
    by_cases hr : i ∈ replied <;> simp [hr]

/-- The sum of the peer indicators equals the treated arm size, T1's n₁. -/
theorem sum_peers {ι : Type*} [Fintype ι] [DecidableEq ι] (s : Finset ι) :
    ∑ i, peers (s : Set ι) i = (s.card : ℝ) := by
  classical
  simp [peers, Set.indicator, ← Finset.sum_filter]

/-- The centered observations sum to zero in each nonempty arm; finite
lemma for the difference-in-means OLS identity, Section III, p. 596. -/
theorem arm_centered_sum {ι : Type*} (s : Finset ι) (Y : ι → ℝ)
    (hs : 0 < s.card) : ∑ i ∈ s, (Y i - armMean s Y) = 0 := by
  have hn : (s.card : ℝ) ≠ 0 := by exact_mod_cast hs.ne'
  simp only [sum_sub_distrib, sum_const, nsmul_eq_mul, armMean]
  field_simp
  <;> ring

/-- Within an arm, the squared-error objective decomposes into its value
at the sample mean and a positive quadratic term (finite lemma for T1(ii)). -/
theorem arm_square_decomposition {ι : Type*} (s : Finset ι) (Y : ι → ℝ)
    (hs : 0 < s.card) (b : ℝ) :
    (∑ i ∈ s, (Y i - b) ^ 2) =
      armSS s Y + (s.card : ℝ) * (b - armMean s Y) ^ 2 := by
  have hz := arm_centered_sum s Y hs
  calc
    (∑ i ∈ s, (Y i - b) ^ 2) =
        ∑ i ∈ s, ((Y i - armMean s Y)^2 +
          2 * (armMean s Y - b) * (Y i - armMean s Y) +
          (b - armMean s Y)^2) := by
            apply sum_congr rfl
            intro i hi
            ring
    _ = armSS s Y + (s.card : ℝ) * (b - armMean s Y)^2 := by
      simp only [sum_add_distrib, ← mul_sum, hz, mul_zero, add_zero,
        sum_const, nsmul_eq_mul, armSS]

/-- The usual computational identity for centered sums of squares;
finite lemma for T2's binary-outcome sample variance. -/
theorem armSS_formula {ι : Type*} (s : Finset ι) (Y : ι → ℝ)
    (hs : 0 < s.card) :
    armSS s Y = (∑ i ∈ s, (Y i)^2) - (∑ i ∈ s, Y i)^2 / (s.card : ℝ) := by
  have hn : (s.card : ℝ) ≠ 0 := by exact_mod_cast hs.ne'
  unfold armSS
  calc
    _ = ∑ i ∈ s, ((Y i)^2 - 2 * armMean s Y * Y i + (armMean s Y)^2) := by
      apply sum_congr rfl
      intro i hi
      ring
    _ = _ := by
      simp only [sum_add_distrib, sum_sub_distrib, ← mul_sum, sum_const, nsmul_eq_mul,
        armMean]
      field_simp
      <;> ring

/-- For k ones among n binary observations, sample variance is
`k(n-k)/(n(n-1))`, T2(e). The hypothesis
records binary outcomes and their count, rather than inventing raw data. -/
theorem binary_sample_variance {ι : Type*} (s : Finset ι) (Y : ι → ℝ)
    (hs : 2 ≤ s.card) (k : ℕ) (hbin : ∀ i ∈ s, Y i = 0 ∨ Y i = 1)
    (hk : ∑ i ∈ s, Y i = (k : ℝ)) :
    sampleVariance s Y = (k : ℝ) * ((s.card : ℝ) - (k : ℝ)) /
      ((s.card : ℝ) * ((s.card : ℝ) - 1)) := by
  have hpos : 0 < s.card := lt_of_lt_of_le (by norm_num : 0 < 2) hs
  have hn : (s.card : ℝ) ≠ 0 := by exact_mod_cast hpos.ne'
  have hm : (s.card : ℝ) - 1 ≠ 0 := by
    have : (2 : ℝ) ≤ s.card := by exact_mod_cast hs
    linarith
  have hsq : (∑ i ∈ s, (Y i)^2) = (k : ℝ) := by
    rw [← hk]
    apply sum_congr rfl
    intro i hi
    rcases hbin i hi with h | h <;> simp [h]
  unfold sampleVariance
  rw [armSS_formula s Y hpos, hk, hsq]
  field_simp
  <;> ring

/-- The full unadjusted objective is the sum of the two arm objectives,
because `Peers` is the regressor and `b₁` is its real coefficient (T1(i–ii)). -/
theorem rss_partition {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) (b₀ b₁ : ℝ) :
    rss s Y b₀ b₁ = (∑ i ∈ s, (Y i - (b₀ + b₁)) ^ 2) +
      ∑ i ∈ sᶜ, (Y i - b₀) ^ 2 := by
  classical
  rw [rss, ← sum_add_sum_compl s]
  congr 1
  · apply sum_congr rfl
    intro i hi
    simp [peers, hi, sub_sub]
  · apply sum_congr rfl
    intro i hi
    have h : i ∉ s := by simpa using hi
    simp [peers, h]

/-- Exact quadratic decomposition of OLS without covariates, Section III,
p. 596 (T1(ii)); both arms must be nonempty. -/
theorem rss_decomposition {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) (h₁ : 0 < s.card) (h₀ : 0 < sᶜ.card)
    (b₀ b₁ : ℝ) :
    rss s Y b₀ b₁ = armSS s Y + armSS sᶜ Y +
      (s.card : ℝ) * (b₀ + b₁ - armMean s Y)^2 +
      (sᶜ.card : ℝ) * (b₀ - armMean sᶜ Y)^2 := by
  rw [rss_partition, arm_square_decomposition s Y h₁,
    arm_square_decomposition sᶜ Y h₀]
  ring

/-- Corrected Section III, p. 596, T1(ii): OLS on an intercept and the
binary assignment regressor has a unique minimizer, with intercept the
world-affairs mean and peer coefficient the difference of arm means.
The biconditional identifies *all* global minimizers, not just a solution
of the normal equations. -/
theorem ols_unique_minimizer {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) (h₁ : 0 < s.card) (h₀ : 0 < sᶜ.card)
    (b : ℝ × ℝ) :
    (∀ c : ℝ × ℝ, rss s Y b.1 b.2 ≤ rss s Y c.1 c.2) ↔
      b = olsCoefficients s Y := by
  have hn₁ : 0 < (s.card : ℝ) := by exact_mod_cast h₁
  have hn₀ : 0 < (sᶜ.card : ℝ) := by exact_mod_cast h₀
  have hbest : rss s Y (armMean sᶜ Y) (armMean s Y - armMean sᶜ Y) =
      armSS s Y + armSS sᶜ Y := by
    rw [rss_decomposition s Y h₁ h₀]
    ring
  constructor
  · intro hb
    have hh := hb (olsCoefficients s Y)
    simp only [olsCoefficients] at hh
    rw [hbest, rss_decomposition s Y h₁ h₀] at hh
    have hsq₁ := sq_nonneg (b.1 + b.2 - armMean s Y)
    have hsq₀ := sq_nonneg (b.1 - armMean sᶜ Y)
    have hmul₁ := mul_nonneg hn₁.le hsq₁
    have hmul₀ := mul_nonneg hn₀.le hsq₀
    have hz₁ : (b.1 + b.2 - armMean s Y)^2 = 0 := by nlinarith
    have hz₀ : (b.1 - armMean sᶜ Y)^2 = 0 := by nlinarith
    have he₁ : b.1 + b.2 - armMean s Y = 0 := by nlinarith [sq_nonneg (b.1 + b.2 - armMean s Y)]
    have he₀ : b.1 - armMean sᶜ Y = 0 := by nlinarith [sq_nonneg (b.1 - armMean sᶜ Y)]
    apply Prod.ext <;> simp only [olsCoefficients]
    · linarith
    · linarith
  · rintro rfl c
    simp only [olsCoefficients]
    rw [hbest, rss_decomposition s Y h₁ h₀]
    nlinarith [mul_nonneg hn₁.le (sq_nonneg (c.1 + c.2 - armMean s Y)),
      mul_nonneg hn₀.le (sq_nonneg (c.1 - armMean sᶜ Y))]

/-- Table 1, p. 595, as sufficient statistics for the two unadjusted OLS
fits: n₁=94, n₀=95; response counts determine the sample means. -/
def tableCoefficients (k₁ k₀ : ℕ) : ℝ × ℝ :=
  ((k₀ : ℝ) / 95, (k₁ : ℝ) / 94 - (k₀ : ℝ) / 95)

/-- Table 1 and Table 2 column (1): exact any-response coefficient and
control mean, T1(iii); no raw mission-level data are inferred. -/
theorem table_any_coefficients :
    tableCoefficients 10 10 = ((2 : ℝ) / 19, (1 : ℝ) / 893) := by
  norm_num [tableCoefficients]

/-- Table 1 and Table 2 column (4): exact interest-response coefficient
and control mean, T1(iii). -/
theorem table_interest_coefficients :
    tableCoefficients 10 7 = ((7 : ℝ) / 95, (146 : ℝ) / 4465) := by
  norm_num [tableCoefficients]

/-- Rounding a nonnegative real to the displayed three-decimal value;
the half-open interval implements nearest rounding, ties upward. -/
def roundsToThree (x displayed : ℝ) : Prop :=
  displayed - 1 / 2000 ≤ x ∧ x < displayed + 1 / 2000

/-- The four exact T1(iii) coefficients fall in the rounding intervals
of Table 2 columns (1) and (4), printed p. 596. -/
theorem table_coefficient_rounding :
    roundsToThree (tableCoefficients 10 10).2 (1 / 1000) ∧
    roundsToThree (tableCoefficients 10 10).1 (105 / 1000) ∧
    roundsToThree (tableCoefficients 10 7).2 (33 / 1000) ∧
    roundsToThree (tableCoefficients 10 7).1 (74 / 1000) := by
  norm_num [roundsToThree, tableCoefficients]

/-- T2: the two columns of an unadjusted design matrix, `D_i=(1,T_i)'`.
The paper calls `T` “Peers”. -/
def designRow {ι : Type*} (s : Finset ι) (i : ι) (a : Fin 2) : ℝ :=
  if a = 0 then 1 else peers (s : Set ι) i

/-- `D'D=∑_i D_iD_i'`, as in T2(a).
Matrices are represented by their real entries indexed by `Fin 2`. -/
def gram {ι : Type*} [Fintype ι] (s : Finset ι) (a b : Fin 2) : ℝ :=
  ∑ i, designRow s i a * designRow s i b

/-- Explicit inverse of `D'D`. The theorem
`gram_inverse` certifies both inverse products for nonempty arms. -/
def gramInverse {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (a b : Fin 2) : ℝ :=
  if a = 0 then
    if b = 0 then 1 / (sᶜ.card : ℝ) else -1 / (sᶜ.card : ℝ)
  else
    if b = 0 then -1 / (sᶜ.card : ℝ)
    else 1 / (s.card : ℝ) + 1 / (sᶜ.card : ℝ)

/-- Matrix formula `(D'D)⁻¹D'Y` for the OLS coefficient vector, T2(a).
Entry zero is intercept; entry one is peer slope. -/
def regressionCoefficient {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) (a : Fin 2) : ℝ :=
  ∑ b, gramInverse s a b * ∑ i, designRow s i b * Y i

/-- OLS residual `e_i=Y_i-α̂-τ̂T_i`, T2.
When both arms are nonempty, T1 certifies the coefficients as the unique OLS minimizer. -/
def olsResidual {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) (i : ι) : ℝ :=
  Y i - (olsCoefficients s Y).1 - (olsCoefficients s Y).2 * peers (s : Set ι) i

/-- Leverage `h_i=D_i'(D'D)⁻¹D_i`, T2(a). -/
def leverage {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (i : ι) : ℝ :=
  ∑ a, ∑ b, designRow s i a * gramInverse s a b * designRow s i b

/-- HC2 covariance `(D'D)⁻¹(∑_i e_i²/(1-h_i)D_iD_i')(D'D)⁻¹`,
T2(b). The sum over units is placed outside
the two matrix-entry sums by finite distributivity. -/
def hc2Covariance {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) (a b : Fin 2) : ℝ :=
  ∑ i, ∑ u, ∑ v, gramInverse s a u *
    ((olsResidual s Y i)^2 / (1 - leverage s i) *
      designRow s i u * designRow s i v) * gramInverse s v b

/-- HC2 variance estimate for the coefficient on the peer assignment
indicator: entry (1,1) of the HC2 covariance, T2(b). -/
def hc2Variance {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) : ℝ :=
  hc2Covariance s Y 1 1

/-- The Neyman variance estimate `s₁²/n₁+s₀²/n₀`, T2(b),
for the unadjusted specifications only. -/
def neymanEstimate {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) : ℝ :=
  sampleVariance s Y / (s.card : ℝ) +
    sampleVariance sᶜ Y / (sᶜ.card : ℝ)

/-- The Gram matrix has entries `[[N,n₁],[n₁,n₁]]`, T2(a). -/
theorem gram_entries {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (a b : Fin 2) :
    gram s a b = if a = 0 ∧ b = 0 then (Fintype.card ι : ℝ)
      else (s.card : ℝ) := by
  classical
  have hsq : ∀ i, peers (s : Set ι) i * peers (s : Set ι) i = peers (s : Set ι) i := by
    intro i
    rcases peers_binary (s : Set ι) i with h | h <;> simp [h]
  fin_cases a <;> fin_cases b <;>
    simp [gram, designRow, hsq, sum_peers]

/-- Both products of the explicitly displayed inverse with `D'D` equal
the identity, so the inverse used in the HC2 sandwich is certified, T2(a). -/
theorem gram_inverse {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (h₁ : 0 < s.card) (h₀ : 0 < sᶜ.card) (a b : Fin 2) :
    (∑ c, gramInverse s a c * gram s c b) = (if a = b then 1 else 0) ∧
    (∑ c, gram s a c * gramInverse s c b) = (if a = b then 1 else 0) := by
  have hn₁ : (s.card : ℝ) ≠ 0 := by exact_mod_cast h₁.ne'
  have hn₀ : (sᶜ.card : ℝ) ≠ 0 := by exact_mod_cast h₀.ne'
  have hN : (Fintype.card ι : ℝ) = (s.card : ℝ) + (sᶜ.card : ℝ) := by
    exact_mod_cast (card_add_card_compl s).symm
  constructor <;> (fin_cases a <;> fin_cases b <;>
    simp [Fin.sum_univ_two, gram_entries, gramInverse, hN] <;>
    field_simp <;> ring)

/-- Summing the peer regressor times the outcome picks exactly the peer
arm's total, a finite lemma for the OLS matrix formula, T2(a). -/
theorem sum_peers_mul {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) :
    ∑ i, peers (s : Set ι) i * Y i = ∑ i ∈ s, Y i := by
  classical
  simp [peers, Set.indicator, ite_mul, ← sum_filter]

/-- The matrix coefficient formula agrees with the arm-mean formula
`α̂=Ȳ₀` and `τ̂=Ȳ₁-Ȳ₀`, T2(a). When both arms are nonempty, T1(ii)
certifies that these coefficients are the unique least-squares minimizer. -/
theorem matrix_ols_coefficients {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) :
    (regressionCoefficient s Y 0, regressionCoefficient s Y 1) =
      olsCoefficients s Y := by
  have hsum : (∑ i, Y i) = (∑ i ∈ s, Y i) + ∑ i ∈ sᶜ, Y i :=
    (sum_add_sum_compl s Y).symm
  apply Prod.ext <;>
    simp [regressionCoefficient, Fin.sum_univ_two, gramInverse, designRow,
      sum_peers_mul, hsum, olsCoefficients, armMean] <;> ring

/-- Leverage equals the reciprocal of the size of the unit's assigned
arm, T2(a). -/
theorem leverage_by_arm {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (i : ι) :
    leverage s i = if i ∈ s then 1 / (s.card : ℝ) else 1 / (sᶜ.card : ℝ) := by
  classical
  by_cases hi : i ∈ s <;>
    simp [leverage, Fin.sum_univ_two, designRow, gramInverse, peers, hi] <;> ring

/-- The fitted residual is the observation minus its own arm's sample
mean, T2(a–b). -/
theorem residual_by_arm {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) (i : ι) :
    olsResidual s Y i = if i ∈ s then Y i - armMean s Y
      else Y i - armMean sᶜ Y := by
  classical
  by_cases hi : i ∈ s <;>
    simp [olsResidual, olsCoefficients, peers, hi] <;> ring

/-- T2(b), first equality: the treatment diagonal entry of the genuine
HC2 sandwich has the two stated residual-square arm contributions. -/
theorem hc2_arm_formula {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) :
    hc2Variance s Y =
      (∑ i ∈ s, (olsResidual s Y i)^2 /
        ((s.card : ℝ)^2 * (1 - 1/(s.card : ℝ)))) +
      ∑ i ∈ sᶜ, (olsResidual s Y i)^2 /
        ((sᶜ.card : ℝ)^2 * (1 - 1/(sᶜ.card : ℝ))) := by
  classical
  rw [hc2Variance, hc2Covariance, ← sum_add_sum_compl s]
  congr 1
  · apply sum_congr rfl
    intro i hi
    simp [Fin.sum_univ_two, designRow, gramInverse, leverage_by_arm, peers,
      hi, div_eq_mul_inv, mul_inv_rev, inv_pow] <;> ring
  · apply sum_congr rfl
    intro i hi
    have h : i ∉ s := by simpa using hi
    simp [Fin.sum_univ_two, designRow, gramInverse, leverage_by_arm, peers,
      h, div_eq_mul_inv, mul_inv_rev, inv_pow] <;> ring

/-- Corrected Table 2 note, T2(b): in every assignment with at least two
units in each arm, the unadjusted HC2 variance estimator is exactly the
Neyman estimator. This theorem starts from the HC2 sandwich, not a definition
that simply calls the Neyman expression “HC2”. -/
theorem hc2_eq_neyman {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) (h₁ : 2 ≤ s.card) (h₀ : 2 ≤ sᶜ.card) :
    hc2Variance s Y = neymanEstimate s Y := by
  classical
  have hn₁ : (s.card : ℝ) ≠ 0 := by exact_mod_cast (by omega : s.card ≠ 0)
  have hn₀ : (sᶜ.card : ℝ) ≠ 0 := by exact_mod_cast (by omega : sᶜ.card ≠ 0)
  have hm₁ : (s.card : ℝ) - 1 ≠ 0 := by
    have : (2 : ℝ) ≤ s.card := by exact_mod_cast h₁
    linarith
  have hm₀ : (sᶜ.card : ℝ) - 1 ≠ 0 := by
    have : (2 : ℝ) ≤ sᶜ.card := by exact_mod_cast h₀
    linarith
  rw [hc2_arm_formula]
  have hr₁ : (∑ i ∈ s, (olsResidual s Y i)^2) = armSS s Y := by
    apply sum_congr rfl
    intro i hi
    simp [residual_by_arm, hi, armSS]
  have hr₀ : (∑ i ∈ sᶜ, (olsResidual s Y i)^2) = armSS sᶜ Y := by
    apply sum_congr rfl
    intro i hi
    have h : i ∉ s := by simpa using hi
    simp [residual_by_arm, h, armSS]
  rw [← sum_div, ← sum_div, hr₁, hr₀]
  have hd₁ : (s.card : ℝ)^2 * (1 - 1/(s.card : ℝ)) =
      (s.card : ℝ) * ((s.card : ℝ) - 1) := by field_simp <;> ring
  have hd₀ : (sᶜ.card : ℝ)^2 * (1 - 1/(sᶜ.card : ℝ)) =
      (sᶜ.card : ℝ) * ((sᶜ.card : ℝ) - 1) := by field_simp <;> ring
  rw [hd₁, hd₀]
  unfold neymanEstimate sampleVariance
  field_simp
  <;> ring

/-- Binary-outcome HC2 contribution from an arm of size n and count k,
Table 1, T2(e). Natural counts are cast to
reals before subtraction; only feasible counts are used in the instances. -/
def binaryHC2Arm (n k : ℕ) : ℝ :=
  (k : ℝ) * ((n : ℝ) - (k : ℝ)) / ((n : ℝ)^2 * ((n : ℝ) - 1))

/-- The two-arm binary-outcome HC2 estimate for the paper's n₁=94,n₀=95,
Table 1 p. 595 and Table 2 p. 596, unadjusted columns (1) and (4). -/
def tableHC2 (k₁ k₀ : ℕ) : ℝ :=
  binaryHC2Arm 94 k₁ + binaryHC2Arm 95 k₀

/-- Exact any-response HC2 variance from the two Table 1 counts, T2(e). -/
theorem table_any_hc2 : tableHC2 10 10 = (50039 : ℝ) / 24720919 := by
  norm_num [tableHC2, binaryHC2Arm]

/-- Exact interest-response HC2 variance from the two Table 1 counts,
T2(e). -/
theorem table_interest_hc2 : tableHC2 10 7 = (1080506 : ℝ) / 618022975 := by
  norm_num [tableHC2, binaryHC2Arm]

/-- The actual OLS and HC2 formulas evaluated at any binary outcomes
with Table 1's arm sizes and given response counts equal the sufficient-
statistic formulas used in T1(iii) and T2(e). This connects the table
arithmetic to the proved estimators without selecting invented unit data. -/
theorem table_from_binary_counts {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) (k₁ k₀ : ℕ)
    (hn₁ : s.card = 94) (hn₀ : sᶜ.card = 95)
    (hbin : ∀ i, Y i = 0 ∨ Y i = 1)
    (hk₁ : ∑ i ∈ s, Y i = (k₁ : ℝ)) (hk₀ : ∑ i ∈ sᶜ, Y i = (k₀ : ℝ)) :
    olsCoefficients s Y = tableCoefficients k₁ k₀ ∧
    hc2Variance s Y = tableHC2 k₁ k₀ := by
  have h₁ : 2 ≤ s.card := by rw [hn₁]; norm_num
  have h₀ : 2 ≤ sᶜ.card := by rw [hn₀]; norm_num
  constructor
  · simp [olsCoefficients, armMean, tableCoefficients, hn₁, hn₀, hk₁, hk₀]
  · rw [hc2_eq_neyman s Y h₁ h₀]
    unfold neymanEstimate
    rw [binary_sample_variance s Y h₁ k₁ (fun i _ => hbin i) hk₁,
      binary_sample_variance sᶜ Y h₀ k₀ (fun i _ => hbin i) hk₀]
    simp [hn₁, hn₀, tableHC2, binaryHC2Arm]
    <;> ring

/-- The exact HC2 standard errors lie in the three-decimal rounding
intervals of Table 2 columns (1) and (4): 0.045 and 0.042, T2(e). -/
theorem table_hc2_se_rounding :
    roundsToThree (Real.sqrt (tableHC2 10 10)) (45 / 1000) ∧
    roundsToThree (Real.sqrt (tableHC2 10 7)) (42 / 1000) := by
  have ha : 0 ≤ tableHC2 10 10 := by norm_num [tableHC2, binaryHC2Arm]
  have hi : 0 ≤ tableHC2 10 7 := by norm_num [tableHC2, binaryHC2Arm]
  have hsa := Real.sq_sqrt ha
  have hsi := Real.sq_sqrt hi
  have hna := Real.sqrt_nonneg (tableHC2 10 10)
  have hni := Real.sqrt_nonneg (tableHC2 10 7)
  generalize hxa : Real.sqrt (tableHC2 10 10) = a at *
  generalize hxi : Real.sqrt (tableHC2 10 7) = b at *
  simp only [table_any_hc2, table_interest_hc2] at *
  unfold roundsToThree
  constructor <;> constructor <;> norm_num <;> nlinarith

/-- Complete randomization of n₁ peer assignments: all size-n₁ subsets
of the finite population (T2), interpreting the printed “94 were randomly
assigned” (Section II, p. 595). -/
def assignments {ι : Type*} [Fintype ι] (n₁ : ℕ) : Finset (Finset ι) :=
  (univ : Finset ι).powersetCard n₁

/-- Expectation over the uniform complete-randomization design, an
arithmetic average over all `assignments`. No outcomes are randomized.
T2(c–d). -/
def designExpectation {ι : Type*} [Fintype ι] (n₁ : ℕ)
    (F : Finset ι → ℝ) : ℝ :=
  Finset.expect (assignments (ι := ι) n₁) F

/-- Variance over assignment alone, T2(c–d):
the design average of squared deviations from the design expectation. -/
def designVariance {ι : Type*} [Fintype ι] (n₁ : ℕ)
    (F : Finset ι → ℝ) : ℝ :=
  designExpectation n₁ (fun s => (F s - designExpectation n₁ F)^2)

/-- Fixed potential outcomes yield `Y_i=Y_i(T_i)`. Neither missing
counterfactuals nor treatment effects are assumed known from the data
in corrected P036-T2. -/
def observedOutcome {ι : Type*} [DecidableEq ι] (s : Finset ι)
    (Y₁ Y₀ : ι → ℝ) (i : ι) : ℝ :=
  if i ∈ s then Y₁ i else Y₀ i

/-- Finite-population mean `μ_w=N⁻¹∑Y_i(w)`, T2(c–d). -/
def populationMean {ι : Type*} [Fintype ι] (Y : ι → ℝ) : ℝ := armMean univ Y

/-- Finite-population variance `S_w²=(N-1)⁻¹∑(Y_i(w)-μ_w)²`;
also applied to individual treatment effects. T2. -/
def populationVariance {ι : Type*} [Fintype ι] (Y : ι → ℝ) : ℝ :=
  armSS univ Y / ((Fintype.card ι : ℝ) - 1)

/-- Fixed individual treatment effects `τ_i=Y_i(1)-Y_i(0)`, T2(c–d). -/
def unitEffect {ι : Type*} (Y₁ Y₀ : ι → ℝ) (i : ι) : ℝ := Y₁ i - Y₀ i

/-- The unadjusted peer coefficient from observed outcomes under an
assignment, T2(c–d), using the OLS minimizer of T1(ii). -/
def estimatedEffect {ι : Type*} [Fintype ι] [DecidableEq ι]
    (Y₁ Y₀ : ι → ℝ) (s : Finset ι) : ℝ :=
  (olsCoefficients s (observedOutcome s Y₁ Y₀)).2

/-- Complete-randomization expectation is taken over exactly `N choose n₁`
assignments, T2's specified randomization model. -/
theorem assignments_card {ι : Type*} [Fintype ι] (n₁ : ℕ) :
    (assignments (ι := ι) n₁).card = (Fintype.card ι).choose n₁ := by
  simp [assignments, card_powersetCard]

/-- The design is nonempty under the target's arm-size assumptions;
this prevents a zero-probability or vacuous randomization model, T2. -/
theorem assignments_nonempty {ι : Type*} [Fintype ι] (n₁ : ℕ)
    (h : n₁ ≤ Fintype.card ι) : (assignments (ι := ι) n₁).Nonempty := by
  rw [← card_pos, assignments_card]
  exact Nat.choose_pos h

/-- A fixed unit belongs to `N-1 choose n₁-1` assignments. Finite
counting lemma for T2(c–d). -/
theorem single_inclusion_count {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n : ℕ) (hn : 1 ≤ n) (i : ι) :
    ((assignments (ι := ι) n).filter (fun s => i ∈ s)).card =
      (Fintype.card ι - 1).choose (n - 1) := by
  have h := card_filter_powersetCard_subset ({i} : Finset ι) univ n
    (subset_univ _) (by simpa using hn)
  simpa [assignments] using h

/-- Two distinct units belong jointly to `N-2 choose n₁-2` assignments.
Finite counting lemma for T2(c–d). -/
theorem pair_inclusion_count {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n : ℕ) (hn : 2 ≤ n) (i j : ι) (hij : i ≠ j) :
    ((assignments (ι := ι) n).filter (fun s => i ∈ s ∧ j ∈ s)).card =
      (Fintype.card ι - 2).choose (n - 2) := by
  have h := card_filter_powersetCard_subset ({i, j} : Finset ι) univ n
    (subset_univ _) (by simpa [hij] using hn)
  simpa [assignments, hij, Finset.insert_subset_iff] using h

/-- Under uniform complete randomization, `E[T_i]=n₁/N`, as used in
T2(c–d). No inclusion probabilities are
postulated as extra hypotheses. -/
theorem expected_peer_indicator {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n : ℕ) (hn : 1 ≤ n) (hN : n ≤ Fintype.card ι) (i : ι) :
    designExpectation (ι := ι) n (fun s => peers (s : Set ι) i) =
      (n : ℝ) / (Fintype.card ι : ℝ) := by
  classical
  have hsum : (∑ s ∈ assignments (ι := ι) n, peers (s : Set ι) i) =
      (((assignments (ι := ι) n).filter (fun s => i ∈ s)).card : ℝ) := by
    simp [peers, Set.indicator, ← sum_filter]
  rw [designExpectation, expect_eq_sum_div_card, hsum, single_inclusion_count n hn,
    assignments_card]
  have hpos : 0 < Fintype.card ι := lt_of_lt_of_le (lt_of_lt_of_le (by norm_num) hn) hN
  have hNe : (Fintype.card ι : ℝ) ≠ 0 := by exact_mod_cast hpos.ne'
  have hCe : ((Fintype.card ι).choose n : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.choose_pos hN).ne'
  have hc : ((Fintype.card ι).choose n : ℝ) * (n : ℝ) =
      (Fintype.card ι : ℝ) * ((Fintype.card ι - 1).choose (n - 1) : ℝ) := by
    exact_mod_cast (by simpa using (Nat.choose_mul (n := Fintype.card ι) (k := n) (s := 1) hn))
  field_simp
  nlinarith [hc]

/-- Under complete randomization, `E[T_i T_j]=n₁(n₁-1)/(N(N-1))`
for distinct units. Finite lemma for T2(c–d). -/
theorem expected_peer_pair {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n : ℕ) (hn : 2 ≤ n) (hN : n ≤ Fintype.card ι) (i j : ι) (hij : i ≠ j) :
    designExpectation (ι := ι) n (fun s => peers (s : Set ι) i * peers (s : Set ι) j) =
      (n : ℝ) * ((n : ℝ) - 1) /
        ((Fintype.card ι : ℝ) * ((Fintype.card ι : ℝ) - 1)) := by
  classical
  have hsum : (∑ s ∈ assignments (ι := ι) n, peers (s : Set ι) i * peers (s : Set ι) j) =
      (((assignments (ι := ι) n).filter (fun s => i ∈ s ∧ j ∈ s)).card : ℝ) := by
    have heq : ∀ s : Finset ι,
        peers (s : Set ι) i * peers (s : Set ι) j =
          if i ∈ s ∧ j ∈ s then 1 else 0 := by
      intro s
      by_cases hi : i ∈ s <;> by_cases hj : j ∈ s <;> simp [peers, hi, hj]
    simp [heq, ← sum_filter]
  rw [designExpectation, expect_eq_sum_div_card, hsum,
    pair_inclusion_count n hn i j hij, assignments_card]
  have hnp : 1 ≤ n := by omega
  have hNp : 1 ≤ Fintype.card ι := le_trans hnp hN
  have hn' : 1 ≤ n - 1 := by omega
  have hN' : 2 ≤ Fintype.card ι := le_trans hn hN
  have hNe : (Fintype.card ι : ℝ) ≠ 0 := by exact_mod_cast (by omega : Fintype.card ι ≠ 0)
  have hNm : (Fintype.card ι : ℝ) - 1 ≠ 0 := by
    have : (2 : ℝ) ≤ Fintype.card ι := by exact_mod_cast hN'
    linarith
  have hCe : ((Fintype.card ι).choose n : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.choose_pos hN).ne'
  have hc₁ : ((Fintype.card ι).choose n : ℝ) * (n : ℝ) =
      (Fintype.card ι : ℝ) * ((Fintype.card ι - 1).choose (n - 1) : ℝ) := by
    exact_mod_cast (by simpa using (Nat.choose_mul (n := Fintype.card ι) (k := n) (s := 1) hnp))
  have hc₂nat : (Fintype.card ι - 1).choose (n - 1) * (n - 1) =
      (Fintype.card ι - 1) * (Fintype.card ι - 2).choose (n - 2) := by
    simpa [Nat.sub_sub] using
      (Nat.choose_mul (n := Fintype.card ι - 1) (k := n - 1) (s := 1) hn')
  have hc₂ : ((Fintype.card ι - 1).choose (n - 1) : ℝ) * ((n : ℝ) - 1) =
      ((Fintype.card ι : ℝ) - 1) * ((Fintype.card ι - 2).choose (n - 2) : ℝ) := by
    have hcast : ((Fintype.card ι - 1).choose (n - 1) : ℝ) * ((n - 1 : ℕ) : ℝ) =
        ((Fintype.card ι - 1 : ℕ) : ℝ) * ((Fintype.card ι - 2).choose (n - 2) : ℝ) := by
      exact_mod_cast hc₂nat
    simpa [Nat.cast_sub hnp, Nat.cast_sub hNp] using hcast
  have hc : ((Fintype.card ι - 2).choose (n - 2) : ℝ) *
      (Fintype.card ι : ℝ) * ((Fintype.card ι : ℝ) - 1) =
      ((Fintype.card ι).choose n : ℝ) * (n : ℝ) * ((n : ℝ) - 1) := by
    calc
      _ = (Fintype.card ι : ℝ) *
          (((Fintype.card ι : ℝ) - 1) * ((Fintype.card ι - 2).choose (n - 2) : ℝ)) := by ring
      _ = (Fintype.card ι : ℝ) *
          (((Fintype.card ι - 1).choose (n - 1) : ℝ) * ((n : ℝ) - 1)) := by rw [hc₂]
      _ = ((Fintype.card ι : ℝ) * ((Fintype.card ι - 1).choose (n - 1) : ℝ)) *
          ((n : ℝ) - 1) := by ring
      _ = _ := by rw [← hc₁]
  field_simp
  nlinarith [hc]

/-- Expected sample total equals the sampling fraction times the
population total. Finite lemma for T2(c). -/
theorem expected_sample_total {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n : ℕ) (hn : 1 ≤ n) (hN : n ≤ Fintype.card ι) (Y : ι → ℝ) :
    designExpectation n (fun s => ∑ i ∈ s, Y i) =
      ((n : ℝ) / (Fintype.card ι : ℝ)) * ∑ i, Y i := by
  classical
  calc
    _ = Finset.expect (assignments (ι := ι) n) (fun s => ∑ i, peers (s : Set ι) i * Y i) := by
      apply expect_congr rfl
      intro s hs
      exact (sum_peers_mul s Y).symm
    _ = ∑ i, Finset.expect (assignments (ι := ι) n) (fun s => peers (s : Set ι) i * Y i) :=
      expect_sum_comm (assignments (ι := ι) n) (univ : Finset ι)
        (fun s i => peers (s : Set ι) i * Y i)
    _ = ∑ i, ((n : ℝ) / (Fintype.card ι : ℝ)) * Y i := by
      apply sum_congr rfl
      intro i hi
      rw [← expect_mul]
      rw [show Finset.expect (assignments (ι := ι) n) (fun s => peers (s : Set ι) i) =
        (n : ℝ) / (Fintype.card ι : ℝ) from expected_peer_indicator n hn hN i]
    _ = _ := (mul_sum _ _ _).symm

/-- The double-sum diagonal/off-diagonal decomposition used with the
one- and two-unit inclusion probabilities, T2(c–d). -/
theorem weighted_pair_sum {ι : Type*} [Fintype ι] [DecidableEq ι]
    (p q : ℝ) (Y : ι → ℝ) :
    (∑ i, ∑ j, (if i = j then p else q) * Y i * Y j) =
      q * (∑ i, Y i)^2 + (p-q) * ∑ i, (Y i)^2 := by
  classical
  calc
    _ = ∑ i, ∑ j, (q * Y i * Y j + if i = j then (p-q) * (Y i)^2 else 0) := by
      apply sum_congr rfl
      intro i hi
      apply sum_congr rfl
      intro j hj
      by_cases h : i = j
      · subst j
        simp
        ring
      · simp [h]
    _ = _ := by
      simp only [sum_add_distrib, sum_ite_eq, mem_univ, if_true, ← mul_sum]
      rw [← sum_mul]
      rw [← mul_sum]
      ring

/-- Exact second moment of a sample total under complete randomization,
from the counted inclusion probabilities, T2(c–d). -/
theorem expected_sample_total_sq {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n : ℕ) (hn : 2 ≤ n) (hN : n ≤ Fintype.card ι) (Y : ι → ℝ) :
    designExpectation n (fun s => (∑ i ∈ s, Y i)^2) =
      ((n : ℝ)*((n : ℝ)-1)/((Fintype.card ι : ℝ)*((Fintype.card ι : ℝ)-1))) *
        (∑ i, Y i)^2 +
      ((n : ℝ)/(Fintype.card ι : ℝ) -
        (n : ℝ)*((n : ℝ)-1)/((Fintype.card ι : ℝ)*((Fintype.card ι : ℝ)-1))) *
        ∑ i, (Y i)^2 := by
  classical
  have hnp : 1 ≤ n := by omega
  have hpair (i j : ι) :
      Finset.expect (assignments (ι := ι) n) (fun s => peers (s : Set ι) i * peers (s : Set ι) j) =
        if i = j then (n : ℝ)/(Fintype.card ι : ℝ)
        else (n : ℝ)*((n : ℝ)-1)/((Fintype.card ι : ℝ)*((Fintype.card ι : ℝ)-1)) := by
    by_cases h : i = j
    · subst j
      simp only [if_true]
      have hs : ∀ s : Finset ι, peers (s : Set ι) i * peers (s : Set ι) i = peers (s : Set ι) i := by
        intro s
        rcases peers_binary (s : Set ι) i with h | h <;> simp [h]
      simp_rw [hs]
      exact expected_peer_indicator n hnp hN i
    · simp only [h, if_false]
      exact expected_peer_pair n hn hN i j h
  calc
    _ = Finset.expect (assignments (ι := ι) n) (fun s =>
          ∑ i, ∑ j, (peers (s : Set ι) i * peers (s : Set ι) j) * Y i * Y j) := by
      apply expect_congr rfl
      intro s hs
      rw [← sum_peers_mul s Y, sq, sum_mul_sum]
      apply sum_congr rfl
      intro i hi
      apply sum_congr rfl
      intro j hj
      ring
    _ = ∑ i, ∑ j, Finset.expect (assignments (ι := ι) n) (fun s =>
          (peers (s : Set ι) i * peers (s : Set ι) j) * Y i * Y j) := by
      simp_rw [expect_sum_comm]
    _ = ∑ i, ∑ j, (if i = j then (n : ℝ)/(Fintype.card ι : ℝ)
          else (n : ℝ)*((n : ℝ)-1)/((Fintype.card ι : ℝ)*((Fintype.card ι : ℝ)-1))) * Y i * Y j := by
      apply sum_congr rfl
      intro i hi
      apply sum_congr rfl
      intro j hj
      rw [← expect_mul, ← expect_mul, hpair]
    _ = _ := weighted_pair_sum _ _ Y

/-- An arm mean depends only on the outcomes in that arm. Finite lemma
for observed potential outcomes in T2(a,c). -/
theorem armMean_congr {ι : Type*} (s : Finset ι) (Y Z : ι → ℝ)
    (h : ∀ i ∈ s, Y i = Z i) : armMean s Y = armMean s Z := by
  unfold armMean
  rw [sum_congr rfl h]

/-- An arm sample variance depends only on the outcomes in that arm.
Finite lemma for T2(d). -/
theorem sampleVariance_congr {ι : Type*} (s : Finset ι) (Y Z : ι → ℝ)
    (h : ∀ i ∈ s, Y i = Z i) : sampleVariance s Y = sampleVariance s Z := by
  unfold sampleVariance armSS
  rw [armMean_congr s Y Z h]
  congr 1
  apply sum_congr rfl
  intro i hi
  rw [h i hi]

/-- The observed arm means and sample variances use the corresponding
potential-outcome array, T2(a,d). -/
theorem observed_arm_quantities {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y₁ Y₀ : ι → ℝ) :
    armMean s (observedOutcome s Y₁ Y₀) = armMean s Y₁ ∧
    armMean sᶜ (observedOutcome s Y₁ Y₀) = armMean sᶜ Y₀ ∧
    sampleVariance s (observedOutcome s Y₁ Y₀) = sampleVariance s Y₁ ∧
    sampleVariance sᶜ (observedOutcome s Y₁ Y₀) = sampleVariance sᶜ Y₀ := by
  have h₁ : ∀ i ∈ s, observedOutcome s Y₁ Y₀ i = Y₁ i := by
    intro i hi
    simp [observedOutcome, hi]
  have h₀ : ∀ i ∈ sᶜ, observedOutcome s Y₁ Y₀ i = Y₀ i := by
    intro i hi
    have h : i ∉ s := by simpa using hi
    simp [observedOutcome, h]
  exact ⟨armMean_congr s _ _ h₁, armMean_congr sᶜ _ _ h₀,
    sampleVariance_congr s _ _ h₁, sampleVariance_congr sᶜ _ _ h₀⟩

/-- Sample means are unbiased for finite-population means under complete
randomization, T2(c). -/
theorem expected_sample_mean {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n : ℕ) (hn : 1 ≤ n) (hN : n ≤ Fintype.card ι) (Y : ι → ℝ) :
    designExpectation n (fun s => armMean s Y) = populationMean Y := by
  have hnpos : 0 < n := lt_of_lt_of_le (by norm_num) hn
  have hne : (n : ℝ) ≠ 0 := by exact_mod_cast hnpos.ne'
  calc
    _ = Finset.expect (assignments (ι := ι) n) (fun s => (∑ i ∈ s, Y i)/(n : ℝ)) := by
      apply expect_congr rfl
      intro s hs
      have hc : s.card = n := (mem_powersetCard.mp hs).2
      simp [armMean, hc]
    _ = designExpectation n (fun s => ∑ i ∈ s, Y i) / (n : ℝ) :=
      (expect_div _ _ _).symm
    _ = populationMean Y := by
      rw [expected_sample_total n hn hN Y]
      unfold populationMean armMean
      simp only [card_univ]
      field_simp
      <;> ring

/-- Unbiasedness of sample variance with divisor n-1 under sampling
without replacement, T2(d). -/
theorem expected_sample_variance {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n : ℕ) (hn : 2 ≤ n) (hN : n ≤ Fintype.card ι) (Y : ι → ℝ) :
    designExpectation n (fun s => sampleVariance s Y) = populationVariance Y := by
  have hnp : 1 ≤ n := by omega
  have hnpos : 0 < n := by omega
  have hNpos : 0 < Fintype.card ι := lt_of_lt_of_le hnpos hN
  have hne : (n : ℝ) ≠ 0 := by exact_mod_cast hnpos.ne'
  have hNm : (Fintype.card ι : ℝ) - 1 ≠ 0 := by
    have : (2 : ℝ) ≤ Fintype.card ι := by exact_mod_cast (le_trans hn hN)
    linarith
  have hnm : (n : ℝ) - 1 ≠ 0 := by
    have : (2 : ℝ) ≤ n := by exact_mod_cast hn
    linarith
  have hNe : (Fintype.card ι : ℝ) ≠ 0 := by exact_mod_cast hNpos.ne'
  calc
    _ = Finset.expect (assignments (ι := ι) n) (fun s =>
          ((∑ i ∈ s, (Y i)^2) - (∑ i ∈ s, Y i)^2/(n : ℝ))/((n : ℝ)-1)) := by
      apply expect_congr rfl
      intro s hs
      have hc : s.card = n := (mem_powersetCard.mp hs).2
      have hp : 0 < s.card := by simpa [hc] using hnpos
      simp only [sampleVariance, armSS_formula s Y hp, hc]
    _ = (designExpectation n (fun s => ∑ i ∈ s, (Y i)^2) -
          designExpectation n (fun s => (∑ i ∈ s, Y i)^2)/(n : ℝ))/((n : ℝ)-1) := by
      simp only [designExpectation, ← expect_div, expect_sub_distrib]
    _ = populationVariance Y := by
      rw [expected_sample_total n hnp hN (fun i => (Y i)^2),
        expected_sample_total_sq n hn hN Y]
      unfold populationVariance
      rw [armSS_formula univ Y (by simpa using hNpos)]
      simp only [card_univ]
      field_simp
      <;> ring

/-- Complementation interchanges uniform complete randomization of n₁
units and of n₀ units, when n₁+n₀=N. Finite lemma for the control-arm
moments in T2(c–d). -/
theorem design_complement {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n₁ n₀ : ℕ) (hN : n₁ + n₀ = Fintype.card ι) (F : Finset ι → ℝ) :
    designExpectation n₁ (fun s => F sᶜ) = designExpectation n₀ F := by
  have h₁ : ∀ s ∈ assignments (ι := ι) n₁, sᶜ ∈ assignments (ι := ι) n₀ := by
    intro s hs
    have hc : s.card = n₁ := (mem_powersetCard.mp hs).2
    apply mem_powersetCard.mpr
    refine ⟨subset_univ _, ?_⟩
    rw [card_compl, hc, ← hN]
    omega
  have h₀ : ∀ s ∈ assignments (ι := ι) n₀, sᶜ ∈ assignments (ι := ι) n₁ := by
    intro s hs
    have hc : s.card = n₀ := (mem_powersetCard.mp hs).2
    apply mem_powersetCard.mpr
    refine ⟨subset_univ _, ?_⟩
    rw [card_compl, hc, ← hN]
    omega
  exact expect_nbij' (fun s => sᶜ) (fun s => sᶜ) h₁ h₀
    (fun s _ => compl_compl s) (fun s _ => compl_compl s) (fun _ _ => rfl)

/-- The OLS peer coefficient is unbiased for the average potential-outcome
difference under complete randomization, T2(c). -/
theorem randomization_unbiased_effect {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n₁ n₀ : ℕ) (h₁ : 2 ≤ n₁) (h₀ : 2 ≤ n₀)
    (hN : n₁ + n₀ = Fintype.card ι) (Y₁ Y₀ : ι → ℝ) :
    designExpectation n₁ (estimatedEffect Y₁ Y₀) = populationMean Y₁ - populationMean Y₀ := by
  have heq (s : Finset ι) : estimatedEffect Y₁ Y₀ s = armMean s Y₁ - armMean sᶜ Y₀ := by
    unfold estimatedEffect olsCoefficients
    rw [(observed_arm_quantities s Y₁ Y₀).1, (observed_arm_quantities s Y₁ Y₀).2.1]
  simp_rw [designExpectation, heq, expect_sub_distrib]
  change designExpectation n₁ (fun s => armMean s Y₁) -
    designExpectation n₁ (fun s => armMean sᶜ Y₀) = _
  rw [design_complement n₁ n₀ hN (fun s => armMean s Y₀),
    expected_sample_mean n₁ (by omega) (by omega) Y₁,
    expected_sample_mean n₀ (by omega) (by omega) Y₀]

/-- Both observed sample variances are unbiased for their respective
fixed potential-outcome population variances, T2(d). -/
theorem randomization_unbiased_variances {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n₁ n₀ : ℕ) (h₁ : 2 ≤ n₁) (h₀ : 2 ≤ n₀)
    (hN : n₁ + n₀ = Fintype.card ι) (Y₁ Y₀ : ι → ℝ) :
    designExpectation n₁ (fun s => sampleVariance s (observedOutcome s Y₁ Y₀)) = populationVariance Y₁ ∧
    designExpectation n₁ (fun s => sampleVariance sᶜ (observedOutcome s Y₁ Y₀)) = populationVariance Y₀ := by
  constructor
  · have heq (s : Finset ι) := (observed_arm_quantities s Y₁ Y₀).2.2.1
    simp_rw [heq]
    exact expected_sample_variance n₁ h₁ (by omega) Y₁
  · have heq (s : Finset ι) := (observed_arm_quantities s Y₁ Y₀).2.2.2
    simp_rw [heq]
    rw [design_complement n₁ n₀ hN (fun s => sampleVariance s Y₀)]
    exact expected_sample_variance n₀ h₀ (by omega) Y₀

/-- Design variance equals the second moment minus the squared first
moment on a nonempty complete-randomization space, T2(c). -/
theorem designVariance_second_moment {ι : Type*} [Fintype ι]
    (n : ℕ) (hN : n ≤ Fintype.card ι) (F : Finset ι → ℝ) :
    designVariance n F = designExpectation n (fun s => (F s)^2) -
      (designExpectation n F)^2 := by
  have hs := assignments_nonempty (ι := ι) n hN
  unfold designVariance designExpectation
  calc
    _ = Finset.expect (assignments (ι := ι) n) (fun s =>
        (F s)^2 - 2 * Finset.expect (assignments (ι := ι) n) F * F s +
          (Finset.expect (assignments (ι := ι) n) F)^2) := by
      apply expect_congr rfl
      intro s hs
      ring
    _ = _ := by
      simp only [expect_add_distrib, expect_sub_distrib, ← mul_expect, expect_const hs]
      ring

/-- Shifting a statistic by a fixed real constant does not change its
design variance, T2(c). -/
theorem designVariance_sub_const {ι : Type*} [Fintype ι]
    (n : ℕ) (hN : n ≤ Fintype.card ι) (F : Finset ι → ℝ) (c : ℝ) :
    designVariance n (fun s => F s - c) = designVariance n F := by
  have he : designExpectation n (fun s => F s - c) = designExpectation n F - c := by
    simp [designExpectation, expect_sub_distrib, expect_const (assignments_nonempty n hN)]
  unfold designVariance
  rw [he]
  apply expect_congr rfl
  intro s hs
  ring

/-- Design variance respects equality on the actual assignments; its
two expectations use the same uniform finite design, T2(c). -/
theorem designVariance_congr {ι : Type*} [Fintype ι]
    (n : ℕ) (F G : Finset ι → ℝ) (h : ∀ s ∈ assignments (ι := ι) n, F s = G s) :
    designVariance n F = designVariance n G := by
  have he : designExpectation n F = designExpectation n G := expect_congr rfl h
  unfold designVariance
  rw [he]
  apply expect_congr rfl
  intro s hs
  rw [h s hs]

/-- Exact sampling-without-replacement variance of a sample total,
T2(c), derived from the counted moments. -/
theorem sample_total_variance {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n : ℕ) (hn : 2 ≤ n) (hN : n ≤ Fintype.card ι) (Y : ι → ℝ) :
    designVariance n (fun s => ∑ i ∈ s, Y i) =
      (n : ℝ) * ((Fintype.card ι : ℝ) - (n : ℝ)) /
        ((Fintype.card ι : ℝ) * ((Fintype.card ι : ℝ)-1)) *
      ((∑ i, (Y i)^2) - (∑ i, Y i)^2/(Fintype.card ι : ℝ)) := by
  have hNp : 2 ≤ Fintype.card ι := le_trans hn hN
  have hNe : (Fintype.card ι : ℝ) ≠ 0 := by exact_mod_cast (by omega : Fintype.card ι ≠ 0)
  have hNm : (Fintype.card ι : ℝ) - 1 ≠ 0 := by
    have : (2 : ℝ) ≤ Fintype.card ι := by exact_mod_cast hNp
    linarith
  rw [designVariance_second_moment n hN,
    expected_sample_total_sq n hn hN Y, expected_sample_total n (by omega) hN Y]
  field_simp
  <;> ring

/-- Expansion of a finite sum of squared linear combinations, for the
exact potential-outcome variance identity, T2(c). -/
theorem sum_linear_combination_sq {ι : Type*} [Fintype ι]
    (u v : ℝ) (A B : ι → ℝ) :
    (∑ i, (u * A i + v * B i)^2) =
      u^2 * (∑ i, (A i)^2) + v^2 * (∑ i, (B i)^2) +
        2*u*v*(∑ i, A i * B i) := by
  calc
    _ = ∑ i, (u^2*(A i)^2 + v^2*(B i)^2 + 2*u*v*(A i*B i)) := by
      apply sum_congr rfl
      intro i hi
      ring
    _ = _ := by simp only [sum_add_distrib, ← mul_sum]

/-- Exact finite-population Neyman variance of the unadjusted peer
coefficient, T2(c). The expectation and variance
are uniform sums over assignments and all potential outcomes are fixed. -/
theorem randomization_variance_identity {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n₁ n₀ : ℕ) (h₁ : 2 ≤ n₁) (h₀ : 2 ≤ n₀)
    (hN : n₁ + n₀ = Fintype.card ι) (Y₁ Y₀ : ι → ℝ) :
    designVariance n₁ (estimatedEffect Y₁ Y₀) =
      populationVariance Y₁ / (n₁ : ℝ) + populationVariance Y₀ / (n₀ : ℝ) -
        populationVariance (unitEffect Y₁ Y₀) / (Fintype.card ι : ℝ) := by
  have hn₁ : (n₁ : ℝ) ≠ 0 := by exact_mod_cast (by omega : n₁ ≠ 0)
  have hn₀ : (n₀ : ℝ) ≠ 0 := by exact_mod_cast (by omega : n₀ ≠ 0)
  have hnp : 0 < Fintype.card ι := by omega
  have hNr : (Fintype.card ι : ℝ) = (n₁ : ℝ) + (n₀ : ℝ) := by exact_mod_cast hN.symm
  have hne : (n₁ : ℝ) + (n₀ : ℝ) ≠ 0 := by
    have : (2 : ℝ) ≤ n₁ := by exact_mod_cast h₁
    have : (2 : ℝ) ≤ n₀ := by exact_mod_cast h₀
    linarith
  have hnm : (n₁ : ℝ) + (n₀ : ℝ) - 1 ≠ 0 := by
    have : (2 : ℝ) ≤ n₁ := by exact_mod_cast h₁
    have : (2 : ℝ) ≤ n₀ := by exact_mod_cast h₀
    linarith
  let A : ι → ℝ := fun i => (1/(n₁ : ℝ))*Y₁ i + (1/(n₀ : ℝ))*Y₀ i
  let c : ℝ := (∑ i, Y₀ i)/(n₀ : ℝ)
  have heq : ∀ s ∈ assignments (ι := ι) n₁, estimatedEffect Y₁ Y₀ s = (∑ i ∈ s, A i) - c := by
    intro s hs
    have hc₁ : s.card = n₁ := (mem_powersetCard.mp hs).2
    have hc₀ : sᶜ.card = n₀ := by rw [card_compl, hc₁, ← hN]; omega
    have hsum := sum_add_sum_compl s Y₀
    unfold estimatedEffect olsCoefficients
    rw [(observed_arm_quantities s Y₁ Y₀).1, (observed_arm_quantities s Y₁ Y₀).2.1]
    simp only [armMean, hc₁, hc₀, A, c, sum_add_distrib, ← mul_sum]
    rw [← hsum]
    field_simp
    <;> ring
  rw [designVariance_congr n₁ _ _ heq,
    designVariance_sub_const n₁ (by omega) (fun s => ∑ i ∈ s, A i) c,
    sample_total_variance n₁ h₁ (by omega) A]
  have hA : (∑ i, A i) = (1/(n₁ : ℝ))*(∑ i, Y₁ i) + (1/(n₀ : ℝ))*(∑ i, Y₀ i) := by
    simp only [A, sum_add_distrib, ← mul_sum]
  have hAsq : (∑ i, (A i)^2) =
      (1/(n₁ : ℝ))^2*(∑ i, (Y₁ i)^2) + (1/(n₀ : ℝ))^2*(∑ i, (Y₀ i)^2) +
        2*(1/(n₁ : ℝ))*(1/(n₀ : ℝ))*(∑ i, Y₁ i * Y₀ i) :=
    sum_linear_combination_sq _ _ Y₁ Y₀
  have hτ : (∑ i, unitEffect Y₁ Y₀ i) = (∑ i, Y₁ i) - ∑ i, Y₀ i := by
    simp only [unitEffect, sum_sub_distrib]
  have hτsq : (∑ i, (unitEffect Y₁ Y₀ i)^2) =
      (∑ i, (Y₁ i)^2) + (∑ i, (Y₀ i)^2) - 2*(∑ i, Y₁ i * Y₀ i) := by
    have he := sum_linear_combination_sq (1 : ℝ) (-1 : ℝ) Y₁ Y₀
    simpa [unitEffect, sub_eq_add_neg] using he
  unfold populationVariance
  rw [armSS_formula univ Y₁ (by simpa using hnp),
    armSS_formula univ Y₀ (by simpa using hnp),
    armSS_formula univ (unitEffect Y₁ Y₀) (by simpa using hnp), hA, hAsq, hτ, hτsq]
  simp only [card_univ, hNr]
  field_simp
  <;> ring

/-- T2(c–d): the unadjusted difference
in means is unbiased, has the exact Neyman randomization variance, and
both sample variances are unbiased for their finite-population variances.
All arrays are arbitrary fixed real potential outcomes. -/
theorem complete_randomization_moments {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n₁ n₀ : ℕ) (h₁ : 2 ≤ n₁) (h₀ : 2 ≤ n₀)
    (hN : n₁ + n₀ = Fintype.card ι) (Y₁ Y₀ : ι → ℝ) :
    designExpectation n₁ (estimatedEffect Y₁ Y₀) =
        populationMean Y₁ - populationMean Y₀ ∧
    designVariance n₁ (estimatedEffect Y₁ Y₀) =
        populationVariance Y₁ / (n₁ : ℝ) + populationVariance Y₀ / (n₀ : ℝ) -
          populationVariance (unitEffect Y₁ Y₀) / (Fintype.card ι : ℝ) ∧
    designExpectation n₁ (fun s => sampleVariance s (observedOutcome s Y₁ Y₀)) =
        populationVariance Y₁ ∧
    designExpectation n₁ (fun s => sampleVariance sᶜ (observedOutcome s Y₁ Y₀)) =
        populationVariance Y₀ := by
  exact ⟨randomization_unbiased_effect n₁ n₀ h₁ h₀ hN Y₁ Y₀,
    randomization_variance_identity n₁ n₀ h₁ h₀ hN Y₁ Y₀,
    randomization_unbiased_variances n₁ n₀ h₁ h₀ hN Y₁ Y₀⟩

/-- Expected unadjusted HC2 variance equals `S₁²/n₁+S₀²/n₀`, T2(d),
derived from the sandwich identity and unbiased sample variances on the
uniform assignment space. -/
theorem expected_hc2_variance {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n₁ n₀ : ℕ) (h₁ : 2 ≤ n₁) (h₀ : 2 ≤ n₀)
    (hN : n₁ + n₀ = Fintype.card ι) (Y₁ Y₀ : ι → ℝ) :
    designExpectation n₁ (fun s => hc2Variance s (observedOutcome s Y₁ Y₀)) =
      populationVariance Y₁ / (n₁ : ℝ) + populationVariance Y₀ / (n₀ : ℝ) := by
  have heq : ∀ s ∈ assignments (ι := ι) n₁,
      hc2Variance s (observedOutcome s Y₁ Y₀) =
        sampleVariance s (observedOutcome s Y₁ Y₀)/(n₁ : ℝ) +
        sampleVariance sᶜ (observedOutcome s Y₁ Y₀)/(n₀ : ℝ) := by
    intro s hs
    have hc₁ : s.card = n₁ := (mem_powersetCard.mp hs).2
    have hc₀ : sᶜ.card = n₀ := by rw [card_compl, hc₁, ← hN]; omega
    rw [hc2_eq_neyman s _ (by simpa [hc₁] using h₁) (by simpa [hc₀] using h₀)]
    simp only [neymanEstimate, hc₁, hc₀]
  calc
    _ = designExpectation n₁ (fun s =>
        sampleVariance s (observedOutcome s Y₁ Y₀)/(n₁ : ℝ) +
        sampleVariance sᶜ (observedOutcome s Y₁ Y₀)/(n₀ : ℝ)) := expect_congr rfl heq
    _ = _ := by
      simp only [designExpectation, expect_add_distrib, ← expect_div]
      change designExpectation n₁ (fun s => sampleVariance s (observedOutcome s Y₁ Y₀))/(n₁ : ℝ) +
        designExpectation n₁ (fun s => sampleVariance sᶜ (observedOutcome s Y₁ Y₀))/(n₀ : ℝ) = _
      rw [(randomization_unbiased_variances n₁ n₀ h₁ h₀ hN Y₁ Y₀).1,
        (randomization_unbiased_variances n₁ n₀ h₁ h₀ hN Y₁ Y₀).2]

/-- Finite-population variance is nonnegative with the target's positive
divisor N-1, T2(d). -/
theorem populationVariance_nonneg {ι : Type*} [Fintype ι]
    (hN : 2 ≤ Fintype.card ι) (Y : ι → ℝ) : 0 ≤ populationVariance Y := by
  have hNr : (2 : ℝ) ≤ Fintype.card ι := by exact_mod_cast hN
  unfold populationVariance armSS
  exact div_nonneg (sum_nonneg (fun i hi => sq_nonneg _)) (by linarith)

/-- Finite-population variance is zero exactly for a constant array;
applied to individual treatment effects in T2(d). -/
theorem populationVariance_zero_iff_constant {ι : Type*} [Fintype ι]
    (hN : 2 ≤ Fintype.card ι) (Y : ι → ℝ) :
    populationVariance Y = 0 ↔ ∃ c : ℝ, ∀ i, Y i = c := by
  have hNe : (Fintype.card ι : ℝ) ≠ 0 := by exact_mod_cast (by omega : Fintype.card ι ≠ 0)
  have hNm : (Fintype.card ι : ℝ) - 1 ≠ 0 := by
    have : (2 : ℝ) ≤ Fintype.card ι := by exact_mod_cast hN
    linarith
  unfold populationVariance armSS
  rw [div_eq_zero_iff]
  simp only [hNm, or_false, sum_sq_eq_zero_iff]
  constructor
  · intro h
    refine ⟨armMean univ Y, ?_⟩
    intro i
    have hi := h i (mem_univ i)
    linarith
  · rintro ⟨c, hc⟩
    have hm : armMean univ Y = c := by
      unfold armMean
      simp only [hc, sum_const, card_univ, nsmul_eq_mul]
      field_simp
    intro i hi
    rw [hc i, hm]
    ring

/-- Corrected Table 2 note, p. 596, restricted to specifications (1) and
(4), T2(d): HC2 is conservative *in expectation* over complete randomization,
with the exact gap `S_τ²/N`; equality holds exactly for constant unit effects.
This asserts neither a pointwise bound nor a bound for expected square roots. -/
theorem corrected_hc2_conservativeness {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n₁ n₀ : ℕ) (h₁ : 2 ≤ n₁) (h₀ : 2 ≤ n₀)
    (hN : n₁ + n₀ = Fintype.card ι) (Y₁ Y₀ : ι → ℝ) :
    let E := designExpectation n₁ (fun s => hc2Variance s (observedOutcome s Y₁ Y₀))
    let V := designVariance n₁ (estimatedEffect Y₁ Y₀)
    E - V = populationVariance (unitEffect Y₁ Y₀) / (Fintype.card ι : ℝ) ∧
    V ≤ E ∧
    (E = V ↔ ∃ c : ℝ, ∀ i, unitEffect Y₁ Y₀ i = c) := by
  dsimp only
  have hNp : 2 ≤ Fintype.card ι := by omega
  have hNe : (Fintype.card ι : ℝ) ≠ 0 := by exact_mod_cast (by omega : Fintype.card ι ≠ 0)
  have hNnonneg : (0 : ℝ) ≤ Fintype.card ι := Nat.cast_nonneg _
  have hgap :
      designExpectation n₁ (fun s => hc2Variance s (observedOutcome s Y₁ Y₀)) -
        designVariance n₁ (estimatedEffect Y₁ Y₀) =
          populationVariance (unitEffect Y₁ Y₀)/(Fintype.card ι : ℝ) := by
    rw [expected_hc2_variance n₁ n₀ h₁ h₀ hN Y₁ Y₀,
      randomization_variance_identity n₁ n₀ h₁ h₀ hN Y₁ Y₀]
    ring
  have hnonneg : 0 ≤ populationVariance (unitEffect Y₁ Y₀)/(Fintype.card ι : ℝ) :=
    div_nonneg (populationVariance_nonneg hNp _) hNnonneg
  refine ⟨hgap, by linarith, ?_⟩
  constructor
  · intro he
    have hz : populationVariance (unitEffect Y₁ Y₀)/(Fintype.card ι : ℝ) = 0 := by linarith
    have hz' : populationVariance (unitEffect Y₁ Y₀) = 0 :=
      (div_eq_zero_iff.mp hz).resolve_right hNe
    exact (populationVariance_zero_iff_constant hNp _).mp hz'
  · intro hc
    have hz := (populationVariance_zero_iff_constant hNp (unitEffect Y₁ Y₀)).mpr hc
    rw [hz, zero_div] at hgap
    linarith

end
