import AronowAudit.P045.P045_Spillover

/-!
# Blueprint: refutation of `AronowAudit.P045.missing_ties_bias_as_printed` (P045-T28)

Record: P045-T28 / `AronowAudit.P045.missing_ties_bias_as_printed`; resolution `refute`.
Frozen contract (P045_Spillover.lean:4697), readings R1-R2 of p. 303: for every design,
network, schedule and exposure `k ≠ d00`,
(R1) correct exposure probabilities and defined zero-deletion ratios imply that the exact
zero-deletion Hajek contrast is unbiased; and (R2) absolute bias is nondecreasing in the
number `d` of uniformly deleted ties.

`Target` is the negation of exactly that contract; the `example` checks by `Iff.rfl` that it
is the negation of the frozen type. Since `¬ (R1 ∧ R2)` follows from the failure of R1
alone, the assembly refutes R1 at `d = 0`. The bridge nodes are stated for every mask with
`d ≤ 2`, so the same nodes, with `nonmonotone_hajek_counterexample`, also refute R2 at
`d₁ = 0, d₂ = 1` (not needed for `Target`).

Witness (paper proof, record 12): the printed ten-vertex graph `printedAdj` (20 ties) as
the genuine `Network` `printedNetwork`; the design `crMass 10 1` (exactly one treated unit,
uniform); outcomes `y i d = biasBaseline i · (2, 3/2, 5/4, 1)` at `(d11, d10, d01, d00)`;
contrast `k = d01` vs `d00`. Every measured degree under a mask of `≤ 2` ties lies in
`[1, 6]`, so the measured probabilities are `r_i/10` and `(9 - r_i)/10`, every
`hajekObserved` ratio is `some`, and the generic estimator average equals the specialized
`deletionBias d + 23/80`. Since `deletionBias 0 = 890121037/44498644960 ≠ 0`, R1 fails.

Node dependencies are stated as explicit implications, so every node can be proved
independently. Writers prove `theorem nk_proof : Nk` in
`AronowAudit/P045/Wave1/MissingTiesBias/Nk.lean`.
-/

set_option autoImplicit false

namespace AronowAudit.P045.Wave1.MissingTiesBias

open AronowAudit.P045 Finset
open scoped BigOperators

noncomputable section

/-- The frozen statement to be resolved: the negation of the exact recorded contract
`missing_ties_bias_as_printed`. -/
def Target : Prop :=
  ¬ ∀ {n : ℕ}, 0 < n → ∀ (p : Design (Assignment n)) (A : Network n)
    (y : Fin n → Exposure → ℝ) (k : Exposure), k ≠ .d00 →
    ((∀ i, 0 < exposureProb p.mass (exposure A.adj) i k ∧
      0 < exposureProb p.mass (exposure A.adj) i .d00) →
      deletionRatiosDefined p.mass A y k .d00 0 →
      randomDeletionMean p.mass A y k .d00 0=effect y k .d00) ∧
    (∀ d₁ d₂ : ℕ, d₁ ≤ d₂ → d₂ ≤ (networkEdges A).card →
      deletionRatiosDefined p.mass A y k .d00 d₁ → deletionRatiosDefined p.mass A y k .d00 d₂ →
      |randomDeletionMean p.mass A y k .d00 d₁-effect y k .d00| ≤
        |randomDeletionMean p.mass A y k .d00 d₂-effect y k .d00|)

/-- Fidelity check: `Target` is literally `¬` (type of the frozen declaration). Only the
frozen theorem's *type* is read; its `sorry` proof is never used. -/
example : Target ↔ ¬ (type_of% @AronowAudit.P045.missing_ties_bias_as_printed) := Iff.rfl

/-! ## Witness data -/

/-- The printed graph of p. 295 as a genuine undirected `Network 10` (paper proof,
record 12: "These lists are symmetric with no self-neighbor, hence give a Network 10"). -/
def printedNetwork : Network 10 where
  adj := printedAdj
  symmetric := by decide
  loopless := by decide

/-- The single-treated uniform design `crMass 10 1` as a genuine `Design` (paper proof,
record 12: "p=crMass(10,1) is nonnegative and normalized, with mass 1/10 on each of these
ten assignments"). -/
def singleTreatedDesign : Design (Assignment 10) where
  mass := crMass 10 1
  nonneg := (cr_mass_probability (by norm_num)).1
  total := (cr_mass_probability (by norm_num)).2

/-- The dilated true potential outcomes of the witness: `biasBaseline i` times
`2, 3/2, 5/4, 1` at `d11, d10, d01, d00` (`b_1 = 5/2`, all other `b_i = 1`). -/
def yT28 : Fin 10 → Exposure → ℝ := fun i d =>
  biasBaseline i * (match d with
    | .d11 => 2
    | .d10 => 3/2
    | .d01 => 5/4
    | .d00 => 1)

/-- The assignment treating exactly unit `t`. -/
def unitAssignment (t : Fin 10) : Assignment 10 := fun i => decide (i = t)

/-- Observed outcomes generated by the true exposures, exactly the function
`fun i v => y i (exposure A.adj v i)` that the contract feeds to `hajekObserved`. -/
abbrev obsT28 : Fin 10 → Assignment 10 → ℝ :=
  fun i v => yT28 i (exposure printedNetwork.adj v i)

/-! ## Nodes -/

/-- **Node N1** (paper proof, record 12: "Because p has only the ten single-treated support
points, expectation over p is mean_t H_R(t)"): the single-treated design averages over the
ten unit assignments, and these are its only positive-mass assignments.
Suggested route: `cr_subset_average`, `Finset.powersetCard_one`, `subsetAssignment`;
`crMass`, `mem_fixed_assignments_iff`. -/
def N1 : Prop :=
  (∀ F : Assignment 10 → ℝ, expect (crMass 10 1) F = mean (fun t : Fin 10 => F (unitAssignment t))) ∧
    (∀ z : Assignment 10, 0 < crMass 10 1 z → ∃ t, z = unitAssignment t)

/-- **Node N2** (paper proof, record 12: "With one uniformly treated vertex, a unit i has
measured d01 iff the treated vertex is one of its r_i measured neighbors; hence
π_i(d01)=r_i/10 ... π_i(d00)=(9-r_i)/10"): exact measured-exposure probabilities under the
single-treated design, for every deletion mask `R` (the deleted graph is symmetric and
loopless, so `i` is never its own neighbour). -/
def N2 : Prop :=
  ∀ (R : Finset (Fin 10 × Fin 10)) (i : Fin 10),
    exposureProb (crMass 10 1) (exposure (deleteNetwork printedNetwork R)) i .d01 =
        (measuredDegree R i : ℝ) / 10 ∧
      exposureProb (crMass 10 1) (exposure (deleteNetwork printedNetwork R)) i .d00 =
        (9 - (measuredDegree R i : ℝ)) / 10

/-- Content of node N3: the measured-d01 Hajek ratio at a unit assignment is defined and
equals the first ratio of `deletionHajek R t`, whenever the treated unit has a measured
neighbour. -/
def HajekD01Formula : Prop :=
  ∀ (R : Finset (Fin 10 × Fin 10)) (t : Fin 10),
    (univ.filter (fun i => deletedAdj R t i = true)).Nonempty →
    hajekObserved (crMass 10 1) (exposure (deleteNetwork printedNetwork R)) obsT28 .d01
        (unitAssignment t) =
      some ((∑ i ∈ univ.filter (fun i => deletedAdj R t i = true),
          ((5/4)*biasBaseline i)/(measuredDegree R i)) /
        (∑ i ∈ univ.filter (fun i => deletedAdj R t i = true), 1/(measuredDegree R i : ℝ)))

/-- **Node N3** (paper proof, record 12: "In every supported assignment, the measured d01
cell S_R(t) is the neighbor set of t ... For i in S_R(t), the true exposure is d01, so
observed Y_i=(5/4)b_i ... Canceling the common factor 10"): given the exact probabilities
of `N2`, the measured-d01 Hajek ratio is as in `HajekD01Formula`. Every member `i` of the
cell is a measured neighbour of `t`, hence `measuredDegree R i ≥ 1` and the realized
denominator is a nonempty sum of positive weights. -/
def N3 : Prop :=
  N2 → HajekD01Formula

/-- Content of node N4: the measured-d00 Hajek ratio at a unit assignment is defined and
equals the second ratio of `deletionHajek R t`, whenever the measured no-exposure cell is
nonempty. -/
def HajekD00Formula : Prop :=
  ∀ (R : Finset (Fin 10 × Fin 10)) (t : Fin 10),
    (univ \ insert t (univ.filter (fun i => deletedAdj R t i = true))).Nonempty →
    hajekObserved (crMass 10 1) (exposure (deleteNetwork printedNetwork R)) obsT28 .d00
        (unitAssignment t) =
      some ((∑ i ∈ univ \ insert t (univ.filter (fun i => deletedAdj R t i = true)),
          biasBaseline i*(1+(if printedAdj t i then (1/4 : ℝ) else 0))/
            (9-(measuredDegree R i : ℝ))) /
        (∑ i ∈ univ \ insert t (univ.filter (fun i => deletedAdj R t i = true)),
          1/(9-(measuredDegree R i : ℝ))))

/-- **Node N4** (paper proof, record 12: "the measured d00 cell C_R(t) is all vertices
except t and S_R(t) ... For i in C_R(t), it is d01 if i was a true neighbor of t but that
tie was removed, and d00 otherwise. Thus observed Y_i=b_i(1+(1/4)I(i∈N_true(t)))"): given
the exact probabilities of `N2`, the measured-d00 Hajek ratio is as in `HajekD00Formula`.
Every member `i` of the cell has neither `i` nor `t` as a measured neighbour, so
`measuredDegree R i ≤ 8` and `9 - r_i ≥ 1`. -/
def N4 : Prop :=
  N2 → HajekD00Formula

/-- **Node N5** (paper proof, record 12: "Both hajekObserved Options are some, so
deletionRatiosDefined holds for every d≤2 ... Therefore
randomDeletionMean(p,A,y,d01,d00,d)-effect(y,d01,d00)=deletionBias d, for d≤2"): the
generic-to-specialized bridge. For `d ≤ 2` both ratio domains hold at every positive-mass
assignment of every mask, and the generic deletion mean minus the true effect `23/80` is
the certified `deletionBias d`. Uses `deletion_domain_certificate` for the nonempty cells,
`networkEdges printedNetwork = printedEdges` (definitional), and
`mean biasBaseline / 4 = 23/80` (`zero_deletion_hajek_counterexample.2.1`). -/
def N5 : Prop :=
  N1 → HajekD01Formula → HajekD00Formula → ∀ d : ℕ, d ≤ 2 →
    deletionRatiosDefined (crMass 10 1) printedNetwork yT28 .d01 .d00 d ∧
      randomDeletionMean (crMass 10 1) printedNetwork yT28 .d01 .d00 d -
        effect yT28 .d01 .d00 = deletionBias d

/-- **Node N6** (paper proof, record 12: "The original true-graph positivity premise also
holds"; degrees of the printed graph are `(3,4,6,5,5,3,3,4,4,3)`): the true-network
exposure probabilities of `d01` and `d00` are positive for every unit. Route: `N2` at
`R = ∅` (where `deleteNetwork printedNetwork ∅ = printedAdj`) and
`zero_deletion_graph_certificate.1`. -/
def N6 : Prop :=
  N2 → ∀ i : Fin 10,
    0 < exposureProb (crMass 10 1) (exposure printedNetwork.adj) i .d01 ∧
      0 < exposureProb (crMass 10 1) (exposure printedNetwork.adj) i .d00

/-- The nodes suffice: at the witness, R1's antecedents hold (N6, N5 at `d = 0`), so R1
would give `randomDeletionMean … 0 = effect …`, i.e. `deletionBias 0 = 0`, contradicting
`hajek_bias_correction.1 : deletionBias 0 ≠ 0`. -/
theorem assemble (h1 : N1) (h2 : N2) (h3 : N3) (h4 : N4) (h5 : N5) (h6 : N6) : Target := by
  intro h
  have hR1 := (h (n := 10) (by norm_num) singleTreatedDesign printedNetwork yT28 .d01
    (by decide)).1
  -- `singleTreatedDesign.mass` is `crMass 10 1`; `rfl` works but needs a deep
  -- recursion budget, so rewrite with the equation lemma instead.
  rw [show singleTreatedDesign.mass = crMass 10 1 by simp only [singleTreatedDesign]] at hR1
  obtain ⟨hdom, hval⟩ := h5 h1 (h3 h2) (h4 h2) 0 (by norm_num)
  have heq := hR1 (h6 h2) hdom
  apply hajek_bias_correction.1
  rw [← hval]
  exact sub_eq_zero.mpr heq

/-- Nonvacuity record: the witness meets the non-propositional hypotheses of the contract
(`0 < 10`, `d01 ≠ d00`, twenty true ties); the propositional antecedents of R1 are
nodes N6 and N5 (at `d = 0`). -/
example : 0 < (10 : ℕ) ∧ Exposure.d01 ≠ Exposure.d00 ∧ (networkEdges printedNetwork).card = 20 :=
  ⟨by norm_num, by decide, by
    rw [show networkEdges printedNetwork = printedEdges from rfl]
    exact zero_deletion_hajek_counterexample.1⟩

end

end AronowAudit.P045.Wave1.MissingTiesBias
