import Mathlib.Probability.Moments.SubGaussian
import Mathlib.Probability.CentralLimitTheorem
import Mathlib.Probability.Independence.InfinitePi
import Mathlib.MeasureTheory.Function.ConditionalExpectation.PullOut
import Mathlib.Probability.Distributions.Bernoulli
import Mathlib.MeasureTheory.Measure.Lebesgue.Basic
import Mathlib.Tactic

/-!
P047: Rejoinder: Nonparametric Identification Is Not Enough, but Randomized
Controlled Trials Are, Observational Studies 11.1 (2025), pp. 85–90.
The rejoinder has prose bullets, not numbered mathematical results.
The definitions use common known bounds B and ε. All probabilities are
probability measures.
-/

namespace AronowAudit.P047

noncomputable section

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal Topology BigOperators

/-- “averages of bounded potential outcomes”, §1 p.85. One complete unit is
`(W,A,Y(0),Y(1))`, with a real covariate, binary treatment and real outcomes. -/
abbrev UnitData := ℝ × Bool × (ℝ × ℝ)

/-- “at least one continuous covariate”, §1 p.85: the covariate coordinate W. -/
def covariate (u : UnitData) : ℝ := u.1

/-- The binary treatment X, denoted A here; §1 p.85. -/
def arm (a : Bool) (u : UnitData) : ℝ := if u.2.1 = a then 1 else 0

/-- “potential outcomes”, §1 p.85, represented by Y(0) and Y(1). -/
def potential (a : Bool) (u : UnitData) : ℝ := if a then u.2.2.2 else u.2.2.1

/-- Consistency: `Y=(1-A)Y(0)+AY(1)`; rejoinder §1 p.85. -/
def observed (u : UnitData) : ℝ :=
  arm true u * potential true u + arm false u * potential false u

/-- The σ-algebra generated by W, implementing “after adjusting for ...
covariate”, §1 p.85. Conditional expectations below really condition on W. -/
abbrev covariateSigma : MeasurableSpace UnitData :=
  MeasurableSpace.comap covariate inferInstance

/-- “propensity score”, §1 p.85, e(W) for treatment and 1-e(W) for control. -/
def armPropensity (e : ℝ → ℝ) (a : Bool) (u : UnitData) : ℝ :=
  if a then e (covariate u) else 1 - e (covariate u)

/-- Armwise ignorability for binary treatment, used for T1–T2 (§1 p.85):
for each arm and every measurable integrable test f of that potential outcome,
`E[1{A=a} f(Y(a)) | W] = p_a(W) E[f(Y(a)) | W]`.
Indicators f give conditional distributional independence for each potential
outcome separately, not merely conditional mean independence. For a probability
law, taking f=1 also identifies e as P(A=1|W). Joint independence of treatment
and the pair of potential outcomes is the stronger condition `JointIgnorable`
below. -/
def Ignorable (P : Measure UnitData) (e : ℝ → ℝ) : Prop :=
  ∀ (a : Bool) (f : ℝ → ℝ), Measurable f →
    Integrable (fun u => f (potential a u)) P →
    P[fun u => arm a u * f (potential a u) | covariateSigma] =ᵐ[P]
      fun u => armPropensity e a u *
        (P[fun v => f (potential a v) | covariateSigma]) u

/-- One population law with ignorability and its propensity score; §1 p.85.
No estimator, unbiasedness, concentration bound or limit theorem is a field.
Knowing the score means it is supplied to the known-score procedure. -/
structure CausalLaw where
  measure : Measure UnitData
  probability : IsProbabilityMeasure measure
  propensity : ℝ → ℝ
  measurable_propensity : Measurable propensity
  ignorability : Ignorable measure propensity

attribute [instance] CausalLaw.probability

/-- “bounded” and “positivity”, §1 p.85, with fixed common known
constants: |Y(a)|≤B and ε≤e(W)≤1-ε, almost surely.
This definition imposes no smoothness on any function or covariate law. -/
def BoundedOverlap (L : CausalLaw) (B ε : ℝ) : Prop :=
  0 < B ∧ 0 < ε ∧ ε ≤ 1 / 2 ∧
    (∀ a, ∀ᵐ u ∂L.measure, |potential a u| ≤ B) ∧
    (∀ᵐ u ∂L.measure, ε ≤ L.propensity (covariate u) ∧
      L.propensity (covariate u) ≤ 1 - ε)

/-- Horvitz–Thompson contribution for one potential-outcome mean,
target T1(vi); Proposition 2 of the original article. -/
def armIPW (L : CausalLaw) (a : Bool) (u : UnitData) : ℝ :=
  arm a u * potential a u / armPropensity L.propensity a u

/-- “simple estimators”, first bullet §1 p.85, with the observable ATE score
Z=AY/e(W)-(1-A)Y/(1-e(W)) in targets T1 and T2. -/
def score (L : CausalLaw) (u : UnitData) : ℝ :=
  arm true u * observed u / L.propensity (covariate u) -
    arm false u * observed u / (1 - L.propensity (covariate u))

/-- “average treatment effect”, §1 p.85: τ=E[Y(1)-Y(0)]. -/
def ate (L : CausalLaw) : ℝ :=
  ∫ u, potential true u - potential false u ∂L.measure

/-- “averages ... of potential outcomes”, §1 p.85: θ=E[Y(1)]. -/
def treatedMean (L : CausalLaw) : ℝ := ∫ u, potential true u ∂L.measure

/-- Repeated i.i.d. sampling: a countable product of the one-unit
probability law. A sample of size n uses only coordinates 0,...,n-1. -/
def sampleLaw (P : Measure UnitData) [IsProbabilityMeasure P] :
    Measure (ℕ → UnitData) := Measure.infinitePi fun _ : ℕ => P

instance sampleLaw_probability (P : Measure UnitData) [IsProbabilityMeasure P] :
    IsProbabilityMeasure (sampleLaw P) := by unfold sampleLaw; infer_instance

/-- T_n=n⁻¹ΣZ_i, the ATE estimator in targets T1 and T2; first bullet §1 p.85. -/
def estimator (L : CausalLaw) (n : ℕ) (s : ℕ → UnitData) : ℝ :=
  (∑ i ∈ Finset.range n, score L (s i)) / n

/-- θ̂_n=n⁻¹Σ A_iY_i/e(W_i), target T1(vi); first bullet §1 p.85. -/
def treatedEstimator (L : CausalLaw) (n : ℕ) (s : ℕ → UnitData) : ℝ :=
  (∑ i ∈ Finset.range n, armIPW L true (s i)) / n

/-- Concentration interval half-width h_n=(B/ε)√(2log(2/α)/n), the
existential witness for “finite-sample valid” in §1 p.85; target T1(iv). -/
def halfWidth (B ε α : ℝ) (n : ℕ) : ℝ :=
  B / ε * Real.sqrt (2 * Real.log (2 / α) / n)

/-- C_n=[T_n-h_n,T_n+h_n], target T1(iv); §1 p.85. -/
def confidenceInterval (L : CausalLaw) (B ε α : ℝ) (n : ℕ)
    (s : ℕ → UnitData) : Set ℝ :=
  Set.Icc (estimator L n s - halfWidth B ε α n)
    (estimator L n s + halfWidth B ε α n)

/-- The one-mean concentration half-width ε⁻¹√(log(2/α)/(2n)),
target T1(vi), first bullet §1 p.85. -/
def treatedHalfWidth (ε α : ℝ) (n : ℕ) : ℝ :=
  1 / ε * Real.sqrt (Real.log (2 / α) / (2 * n))

/-- Measurability of the covariate used in the §1 model. -/
theorem measurable_covariate : Measurable covariate := measurable_fst

/-- The conditioning σ-algebra in §1 is a sub-σ-algebra of the unit space. -/
theorem covariateSigma_le : covariateSigma ≤ (inferInstance : MeasurableSpace UnitData) :=
  measurable_covariate.comap_le

/-- The covariate is measurable in its own conditioning σ-algebra. -/
theorem measurable_covariate_conditioning : Measurable[covariateSigma] covariate :=
  comap_measurable covariate

/-- Measurability of the binary arm indicator in the §1 model. -/
theorem measurable_arm (a : Bool) : Measurable (arm a) := by
  unfold arm
  exact Measurable.ite ((measurable_snd.fst : Measurable (fun u : UnitData => u.2.1)) (measurableSet_singleton a))
    measurable_const measurable_const

/-- Measurability of both potential-outcome coordinates in the §1 model. -/
theorem measurable_potential (a : Bool) : Measurable (potential a) := by
  cases a
  · exact measurable_snd.snd.fst
  · exact measurable_snd.snd.snd

/-- Measurability of the observed outcome under the §1 consistency equation. -/
theorem measurable_observed : Measurable observed :=
  ((measurable_arm true).mul (measurable_potential true)).add
    ((measurable_arm false).mul (measurable_potential false))

/-- The supplied propensity and its complement are measurable functions of W. -/
theorem measurable_armPropensity_conditioning (L : CausalLaw) (a : Bool) :
    Measurable[covariateSigma] (armPropensity L.propensity a) := by
  cases a
  · exact measurable_const.sub (L.measurable_propensity.comp measurable_covariate_conditioning)
  · exact L.measurable_propensity.comp measurable_covariate_conditioning

/-- Measurability of the arm contribution used in the known-score estimators. -/
theorem measurable_armIPW (L : CausalLaw) (a : Bool) : Measurable (armIPW L a) :=
  ((measurable_arm a).mul (measurable_potential a)).div
    ((measurable_armPropensity_conditioning L a).mono covariateSigma_le le_rfl)

/-- Consistency removes the unobserved outcomes from each arm contribution;
finite identity used in target T1(i), §1 p.85. -/
theorem score_eq_armIPW (L : CausalLaw) (u : UnitData) :
    score L u = armIPW L true u - armIPW L false u := by
  rcases u with ⟨w, a, y0, y1⟩
  cases a <;> simp [score, armIPW, observed, arm, potential, armPropensity]

/-- The observable score is measurable; target T1's estimator is a statistic. -/
theorem measurable_score (L : CausalLaw) : Measurable (score L) := by
  have he : score L = armIPW L true - armIPW L false := funext (score_eq_armIPW L)
  rw [he]
  exact (measurable_armIPW L true).sub (measurable_armIPW L false)

/-- Each potential outcome is integrable under the fixed bounded-outcome
premise; finite lemma for target T1(i), first bullet §1 p.85. -/
theorem integrable_potential (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) (a : Bool) : Integrable (potential a) L.measure := by
  apply Integrable.of_bound (measurable_potential a).aestronglyMeasurable B
  simpa only [Real.norm_eq_abs] using h.2.2.2.1 a

/-- Strong positivity applies to both arm probabilities; target T1(ii). -/
theorem armPropensity_ge (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) (a : Bool) :
    ∀ᵐ u ∂L.measure, ε ≤ armPropensity L.propensity a u := by
  filter_upwards [h.2.2.2.2] with u hu
  cases a <;> simp only [armPropensity, Bool.false_eq_true, ↓reduceIte]
  · linarith [hu.2]
  · exact hu.1

/-- An IPW arm contribution has magnitude at most B/ε; finite bound in T1. -/
theorem armIPW_abs_le (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) (a : Bool) :
    ∀ᵐ u ∂L.measure, |armIPW L a u| ≤ B / ε := by
  filter_upwards [h.2.2.2.1 a, armPropensity_ge L h a] with u hy hp
  have hp0 : 0 < armPropensity L.propensity a u := lt_of_lt_of_le h.2.1 hp
  unfold armIPW arm
  split_ifs
  · simp only [one_mul, abs_div, abs_of_pos hp0]
    exact div_le_div₀ h.1.le hy h.2.1 hp
  · simp only [zero_mul, zero_div, abs_zero]
    exact div_nonneg h.1.le h.2.1.le

/-- Exactly one arm is nonzero: |Z|≤B/ε, rather than the looser sum of
two bounds. This is target T1(ii), first bullet §1 p.85. -/
theorem score_abs_le (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) : ∀ᵐ u ∂L.measure, |score L u| ≤ B / ε := by
  filter_upwards [armIPW_abs_le L h true, armIPW_abs_le L h false] with u ht hf
  rw [score_eq_armIPW]
  by_cases ha : u.2.1 = true
  · have hz : armIPW L false u = 0 := by simp [armIPW, arm, ha]
    simpa [hz] using ht
  · have hz : armIPW L true u = 0 := by simp [armIPW, arm, ha]
    simpa [hz] using hf

/-- Bounded scores have finite moments of every order; finite lemma for
target T2's CLT and variance bound, first bullet §1 p.85. -/
theorem score_memLp (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) (p : ℝ≥0∞) : MemLp (score L) p L.measure := by
  exact MemLp.of_bound (measurable_score L).aestronglyMeasurable (B / ε)
    (by simpa only [Real.norm_eq_abs] using score_abs_le L h)

/-- Target T2's finite variance bound Var(Z)≤B²/ε²; §1 p.85. -/
theorem score_variance_le (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) : variance (score L) L.measure ≤ B ^ 2 / ε ^ 2 := by
  have hi : ∀ᵐ u ∂L.measure, score L u ∈ Set.Icc (-(B / ε)) (B / ε) :=
    (score_abs_le L h).mono fun u hu => abs_le.mp hu
  have hv := variance_le_sq_of_bounded hi (measurable_score L).aemeasurable
  convert hv using 1 <;> ring


/-- The bounded arm numerator is integrable; finite step in T1(i). -/
theorem integrable_arm_numerator (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) (a : Bool) :
    Integrable (fun u => arm a u * potential a u) L.measure := by
  apply Integrable.of_bound
    ((measurable_arm a).mul (measurable_potential a)).aestronglyMeasurable B
  filter_upwards [h.2.2.2.1 a] with u hu
  simp only [Pi.mul_apply, arm]
  split_ifs
  · simpa [Real.norm_eq_abs] using hu
  · simp only [zero_mul, norm_zero]
    exact h.1.le

/-- Integrability of each IPW arm contribution; finite step in T1(i). -/
theorem integrable_armIPW (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) (a : Bool) : Integrable (armIPW L a) L.measure :=
  Integrable.of_bound (measurable_armIPW L a).aestronglyMeasurable (B / ε)
    (by simpa only [Real.norm_eq_abs] using armIPW_abs_le L h a)

/-- Ignorability and a positive arm probability identify the conditional
mean of an IPW arm contribution. General finite lemma used by both ATE and
one-mean parts of target T1(i),(vi), first bullet §1 p.85. -/
theorem conditional_armIPW (L : CausalLaw) (a : Bool)
    (hy : Integrable (potential a) L.measure)
    (hn : Integrable (fun u => arm a u * potential a u) L.measure)
    (hz : Integrable (armIPW L a) L.measure)
    (hp : ∀ᵐ u ∂L.measure, 0 < armPropensity L.propensity a u) :
    L.measure[armIPW L a | covariateSigma] =ᵐ[L.measure]
      L.measure[potential a | covariateSigma] := by
  let f : UnitData → ℝ := fun u => (armPropensity L.propensity a u)⁻¹
  let g : UnitData → ℝ := fun u => arm a u * potential a u
  have hfg : armIPW L a = f * g := by
    funext u
    simp only [armIPW, f, g, Pi.mul_apply, div_eq_mul_inv]
    ring
  have hi : Integrable (f * g) L.measure := hfg ▸ hz
  have hpull := condExp_mul_of_stronglyMeasurable_left
    ((measurable_armPropensity_conditioning L a).inv.stronglyMeasurable) hi hn
  have hign := L.ignorability a id measurable_id hy
  rw [hfg]
  refine hpull.trans ?_
  filter_upwards [hign, hp] with u hu hpu
  simp only [Pi.mul_apply, Pi.inv_apply, f, g, id_eq] at hu ⊢
  rw [hu]
  rw [← mul_assoc, inv_mul_cancel₀ (ne_of_gt hpu), one_mul]

/-- E[Z|W]=E[Y(1)-Y(0)|W], target T1(i), first bullet §1 p.85. -/
theorem conditional_score_identity (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) :
    L.measure[score L | covariateSigma] =ᵐ[L.measure]
      L.measure[fun u => potential true u - potential false u | covariateSigma] := by
  have hc a := conditional_armIPW L a (integrable_potential L h a)
    (integrable_arm_numerator L h a) (integrable_armIPW L h a)
    ((armPropensity_ge L h a).mono fun u hu => lt_of_lt_of_le h.2.1 hu)
  have he : score L = armIPW L true - armIPW L false := funext (score_eq_armIPW L)
  rw [he]
  exact (condExp_sub (integrable_armIPW L h true) (integrable_armIPW L h false) _).trans
    ((hc true).sub (hc false) |>.trans
      (condExp_sub (integrable_potential L h true) (integrable_potential L h false) _).symm)

/-- E[Z]=τ, the exact finite identity in target T1(i); §1 p.85. -/
theorem score_unbiased (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) : (∫ u, score L u ∂L.measure) = ate L := by
  calc
    _ = ∫ u, (L.measure[score L | covariateSigma]) u ∂L.measure :=
      (integral_condExp covariateSigma_le).symm
    _ = ∫ u, (L.measure[fun v => potential true v - potential false v |
        covariateSigma]) u ∂L.measure := integral_congr_ae (conditional_score_identity L h)
    _ = ate L := integral_condExp covariateSigma_le

/-- A sample coordinate has exactly the population law under the
i.i.d. construction. -/
theorem sample_coordinate_hasLaw (P : Measure UnitData) [IsProbabilityMeasure P] (i : ℕ) :
    HasLaw (fun s : ℕ → UnitData => s i) P (sampleLaw P) :=
  ⟨(measurable_pi_apply i).aemeasurable, Measure.infinitePi_map_eval (fun _ => P) i⟩

/-- The scores in the constructed i.i.d. sample are independent; target T1. -/
theorem sample_scores_independent (L : CausalLaw) :
    iIndepFun (fun i (s : ℕ → UnitData) => score L (s i)) (sampleLaw L.measure) :=
  iIndepFun_infinitePi fun _ => measurable_score L

/-- Every sample score has the one-unit score's distribution; target T1. -/
theorem sample_score_identDistrib (L : CausalLaw) (i : ℕ) :
    IdentDistrib (fun s : ℕ → UnitData => score L (s i)) (score L)
      (sampleLaw L.measure) L.measure := by
  have hc : IdentDistrib (fun s : ℕ → UnitData => s i) id
      (sampleLaw L.measure) L.measure :=
    ⟨(measurable_pi_apply i).aemeasurable, measurable_id.aemeasurable,
      by rw [(sample_coordinate_hasLaw L.measure i).map_eq, Measure.map_id]⟩
  exact hc.comp (measurable_score L)

/-- E[T_n]=τ for every n≥1, target T1(i), first bullet §1 p.85. -/
theorem estimator_unbiased (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) {n : ℕ} (hn : 1 ≤ n) :
    (∫ s, estimator L n s ∂sampleLaw L.measure) = ate L := by
  have hi i : Integrable (fun s : ℕ → UnitData => score L (s i)) (sampleLaw L.measure) :=
    (sample_score_identDistrib L i).integrable_iff.mpr ((score_memLp L h 1).integrable (by simp))
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (lt_of_lt_of_le Nat.zero_lt_one hn))
  unfold estimator
  rw [integral_div, integral_finsetSum _ (fun i _ => hi i)]
  simp_rw [(sample_score_identDistrib L _).integral_eq, score_unbiased L h]
  simp [hn0]

/-- Two-sided sub-Gaussian concentration, a finite probability lemma used
in target T1(iii),(vi). It combines the two one-sided Mathlib bounds. -/
theorem subgaussian_abs_tail {Ω : Type*} [MeasurableSpace Ω]
    {P : Measure Ω} [IsProbabilityMeasure P] {X : Ω → ℝ} {c : ℝ≥0}
    (h : HasSubgaussianMGF X c P) {t : ℝ} (ht : 0 ≤ t) :
    P.real {ω | t ≤ |X ω|} ≤ 2 * Real.exp (-t ^ 2 / (2 * c)) := by
  have he : {ω | t ≤ |X ω|} = {ω | t ≤ X ω} ∪ {ω | t ≤ -X ω} := by
    ext ω
    simp only [Set.mem_ofPred_eq, Set.mem_union, abs_eq_max_neg, le_max_iff]
  rw [he]
  exact (measureReal_union_le _ _).trans
    ((add_le_add (h.measure_ge_le ht) (h.neg.measure_ge_le ht)).trans_eq (by ring))

/-- The finite Hoeffding bound for any independent bounded variables with
common mean θ. No concentration hypothesis is assumed; it is proved from
Mathlib's Hoeffding lemma. Used by target T1, first bullet §1 p.85. -/
theorem bounded_independent_average_tail {Ω : Type*} [MeasurableSpace Ω]
    {P : Measure Ω} [IsProbabilityMeasure P] (X : ℕ → Ω → ℝ)
    (hind : iIndepFun X P) (hm : ∀ i, Measurable (X i))
    {a b θ : ℝ} (hab : a < b)
    (hb : ∀ i, ∀ᵐ ω ∂P, X i ω ∈ Set.Icc a b)
    (hmean : ∀ i, (∫ ω, X i ω ∂P) = θ) {n : ℕ} (hn : 1 ≤ n)
    {t : ℝ} (ht : 0 ≤ t) :
    P.real {ω | t ≤ |(∑ i ∈ Finset.range n, X i ω) / n - θ|} ≤
      2 * Real.exp (-(n : ℝ) * t ^ 2 / (2 * ((b - a) / 2) ^ 2)) := by
  let c : ℝ≥0 := (‖b - a‖₊ / 2) ^ 2
  have hsg i : HasSubgaussianMGF (fun ω => X i ω - θ) c P := by
    simpa only [hmean i] using hasSubgaussianMGF_of_mem_Icc (hm i).aemeasurable (hb i)
  have hindc : iIndepFun (fun i ω => X i ω - θ) P :=
    hind.comp (fun _ x => x - θ) (by fun_prop)
  have hsum := HasSubgaussianMGF.sum_of_iIndepFun hindc
    (s := Finset.range n) (c := fun _ => c) (fun i _ => hsg i)
  have hnpos : (0 : ℝ) < n := by exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one hn)
  have hn0 : (n : ℝ) ≠ 0 := ne_of_gt hnpos
  have he : {ω | t ≤ |(∑ i ∈ Finset.range n, X i ω) / n - θ|} =
      {ω | (n : ℝ) * t ≤ |∑ i ∈ Finset.range n, (X i ω - θ)|} := by
    ext ω
    have hsum_eq : (∑ i ∈ Finset.range n, (X i ω - θ)) =
        (n : ℝ) * ((∑ i ∈ Finset.range n, X i ω) / n - θ) := by
      rw [Finset.sum_sub_distrib]
      simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      field_simp
    change t ≤ |(∑ i ∈ Finset.range n, X i ω) / n - θ| ↔
      (n : ℝ) * t ≤ |∑ i ∈ Finset.range n, (X i ω - θ)|
    rw [hsum_eq, abs_mul, abs_of_pos hnpos, mul_le_mul_iff_right₀ hnpos]
  have htbd := subgaussian_abs_tail hsum (mul_nonneg hnpos.le ht)
  rw [he]
  refine htbd.trans_eq ?_
  apply congrArg (fun z : ℝ => 2 * Real.exp z)
  have hc : (c : ℝ) = ((b - a) / 2) ^ 2 := by
    simp [c, coe_nnnorm, Real.norm_eq_abs, abs_of_pos (sub_pos.mpr hab)]
  have hs : ((∑ i ∈ Finset.range n, c : ℝ≥0) : ℝ) =
      (n : ℝ) * ((b - a) / 2) ^ 2 := by
    simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul,
      NNReal.coe_mul, NNReal.coe_natCast]
    rw [hc]
  rw [hs]
  field_simp [hn0, ne_of_gt (sub_pos.mpr hab)] <;> ring

/-- The exact two-sided exponential bound in T1(iii), §1 p.85:
P(|T_n-τ|≥t)≤2exp(-nt²ε²/(2B²)), uniformly for each law in the model. -/
theorem estimator_hoeffding (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) {n : ℕ} (hn : 1 ≤ n) {t : ℝ} (ht : 0 ≤ t) :
    (sampleLaw L.measure).real {s | t ≤ |estimator L n s - ate L|} ≤
      2 * Real.exp (-(n : ℝ) * t ^ 2 * ε ^ 2 / (2 * B ^ 2)) := by
  have hB : 0 < B := h.1
  have hε : 0 < ε := h.2.1
  have hM : 0 < B / ε := div_pos hB hε
  have hb (i : ℕ) : ∀ᵐ s ∂sampleLaw L.measure, score L (s i) ∈ Set.Icc (-(B / ε)) (B / ε) := by
    exact (sample_score_identDistrib L i).symm.ae_mem_snd measurableSet_Icc
      ((score_abs_le L h).mono fun u hu => abs_le.mp hu)
  have hm (i : ℕ) : (∫ s, score L (s i) ∂sampleLaw L.measure) = ate L :=
    (sample_score_identDistrib L i).integral_eq.trans (score_unbiased L h)
  have htbd := bounded_independent_average_tail (P := sampleLaw L.measure)
    (a := -(B / ε)) (b := B / ε) (θ := ate L)
    (fun (i : ℕ) (s : ℕ → UnitData) => score L (s i))
    (sample_scores_independent L) (fun i => (measurable_score L).comp (measurable_pi_apply i))
    (by linarith only [hM] : -(B / ε) < B / ε) hb hm hn ht
  have hexp : -(n : ℝ) * t ^ 2 / (2 * ((B / ε - -(B / ε)) / 2) ^ 2) =
      -(n : ℝ) * t ^ 2 * ε ^ 2 / (2 * B ^ 2) := by
    field_simp [ne_of_gt hB, ne_of_gt hε] <;> ring
  rw [hexp] at htbd
  exact htbd

/-- The normal limit at each fixed law, including zero variance. This is
target T2(b), first bullet §1 p.85, not a uniform normal approximation. -/
theorem estimator_central_limit (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) :
    TendstoInDistribution
      (fun (n : ℕ) s => Real.sqrt n * (estimator L n s - ate L)) atTop id
      (fun _ => sampleLaw L.measure)
      (gaussianReal 0 (variance (score L) L.measure).toNNReal) := by
  let X : ℕ → (ℕ → UnitData) → ℝ := fun i s => score L (s i)
  have hid i : IdentDistrib (X i) (X 0) (sampleLaw L.measure) (sampleLaw L.measure) :=
    (sample_score_identDistrib L i).trans (sample_score_identDistrib L 0).symm
  have hv : variance (X 0) (sampleLaw L.measure) = variance (score L) L.measure :=
    (sample_score_identDistrib L 0).variance_eq
  have hy : HasLaw id (gaussianReal 0 (variance (X 0) (sampleLaw L.measure)).toNNReal)
      (gaussianReal 0 (variance (score L) L.measure).toNNReal) := by
    rw [hv]
    exact ⟨measurable_id.aemeasurable, Measure.map_id⟩
  have hx : MemLp (X 0) 2 (sampleLaw L.measure) :=
    (sample_score_identDistrib L 0).memLp_iff.mpr (score_memLp L h 2)
  have hclt := tendstoInDistribution_inv_sqrt_mul_sum_sub hy hx
    (sample_scores_independent L) hid
  have hm : (∫ s, X 0 s ∂sampleLaw L.measure) = ate L :=
    (sample_score_identDistrib L 0).integral_eq.trans (score_unbiased L h)
  refine hclt.congr (fun n => ae_of_all _ fun s => ?_) (ae_of_all _ fun _ => rfl)
  rw [hm]
  change (Real.sqrt n)⁻¹ * ((∑ i ∈ Finset.range n, score L (s i)) - n * ate L) =
    Real.sqrt n * ((∑ i ∈ Finset.range n, score L (s i)) / n - ate L)
  by_cases hn : n = 0
  · simp [hn]
  · have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn
    have hs : Real.sqrt (n : ℝ) ≠ 0 := Real.sqrt_ne_zero'.mpr (by positivity)
    have hsq := Real.sq_sqrt (show (0 : ℝ) ≤ n by positivity)
    field_simp
    rw [hsq]


/-- The known-score sample mean is measurable; first bullet §1 p.85. -/
theorem measurable_estimator (L : CausalLaw) (n : ℕ) : Measurable (estimator L n) :=
  (Finset.measurable_fun_sum (Finset.range n)
    (fun i _ => (measurable_score L).comp (measurable_pi_apply i))).div_const _


/-- A two-sided tail bound implies coverage for the corresponding symmetric
closed interval. Finite probability step in target T1(iv),(vi), §1 p.85. -/
theorem symmetric_interval_coverage {Ω : Type*} [MeasurableSpace Ω]
    {P : Measure Ω} [IsProbabilityMeasure P] {X : Ω → ℝ} (hm : Measurable X)
    {θ h α : ℝ} (htail : P.real {ω | h ≤ |X ω - θ|} ≤ α) :
    1 - α ≤ P.real {ω | θ ∈ Set.Icc (X ω - h) (X ω + h)} := by
  have hs : {ω | h < |X ω - θ|} ⊆ {ω | h ≤ |X ω - θ|} := by
    intro ω hω
    exact (show h ≤ |X ω - θ| from le_of_lt hω)
  have hbad : P.real {ω | h < |X ω - θ|} ≤ α :=
    (measureReal_mono (μ := P) hs).trans htail
  have hbmeas : MeasurableSet {ω | h < |X ω - θ|} :=
    by simpa only [Real.norm_eq_abs] using
      (measurableSet_lt measurable_const (hm.sub_const θ).norm)
  have he : {ω | θ ∈ Set.Icc (X ω - h) (X ω + h)} =
      {ω | h < |X ω - θ|}ᶜ := by
    ext ω
    simp only [Set.mem_ofPred_eq, Set.mem_Icc, Set.mem_compl_iff, not_lt, abs_le]
    constructor <;> intro hx <;> constructor <;> linarith [hx.1, hx.2]
  rw [he, probReal_compl_eq_one_sub hbmeas]
  linarith

/-- Exact substitution of the concentration radius into the exponential
tail; finite algebra step in target T1(iv), first bullet §1 p.85. -/
theorem halfWidth_exponential {B ε α : ℝ} (hB : 0 < B) (hε : 0 < ε)
    (hα0 : 0 < α) (hα1 : α < 1) {n : ℕ} (hn : 1 ≤ n) :
    2 * Real.exp (-(n : ℝ) * (halfWidth B ε α n) ^ 2 * ε ^ 2 / (2 * B ^ 2)) = α := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (lt_of_lt_of_le Nat.zero_lt_one hn))
  have hq : 1 < 2 / α := (lt_div_iff₀ hα0).mpr (by linarith)
  have hlog : 0 ≤ Real.log (2 / α) := (Real.log_pos hq).le
  have hrad : 0 ≤ 2 * Real.log (2 / α) / (n : ℝ) := by positivity
  have he : -(n : ℝ) * (halfWidth B ε α n) ^ 2 * ε ^ 2 / (2 * B ^ 2) =
      -Real.log (2 / α) := by
    unfold halfWidth
    rw [mul_pow, Real.sq_sqrt hrad]
    field_simp [ne_of_gt hB, ne_of_gt hε, hn0] <;> ring
  rw [he, Real.exp_neg, Real.exp_log (div_pos (by norm_num) hα0)]
  field_simp

/-- Target T1(iv): the concentration interval covers τ with probability
at least 1-α at EVERY n≥1, first bullet §1 p.85. -/
theorem confidenceInterval_coverage (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) {n : ℕ} (hn : 1 ≤ n) {α : ℝ}
    (hα0 : 0 < α) (hα1 : α < 1) :
    1 - α ≤ (sampleLaw L.measure).real
      {s | ate L ∈ confidenceInterval L B ε α n s} := by
  have ht := estimator_hoeffding L h hn
    (t := halfWidth B ε α n) (mul_nonneg (div_nonneg h.1.le h.2.1.le) (Real.sqrt_nonneg _))
  rw [halfWidth_exponential h.1 h.2.1 hα0 hα1 hn] at ht
  exact symmetric_interval_coverage (measurable_estimator L n) ht

/-- Target T1(v): √n times the deterministic full interval width is
the constant (2B/ε)√(2log(2/α)), first bullet §1 p.85. -/
theorem confidenceInterval_root_width {B ε α : ℝ} (hB : 0 < B) (hε : 0 < ε)
    (hα0 : 0 < α) (hα1 : α < 1) {n : ℕ} (hn : 1 ≤ n) :
    Real.sqrt n * (2 * halfWidth B ε α n) =
      2 * B / ε * Real.sqrt (2 * Real.log (2 / α)) := by
  have hnpos : (0 : ℝ) < n := by exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one hn)
  have hs : Real.sqrt (n : ℝ) ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr hnpos)
  have hlog : 0 ≤ Real.log (2 / α) :=
    (Real.log_pos ((lt_div_iff₀ hα0).mpr (by linarith))).le
  unfold halfWidth
  rw [Real.sqrt_div (by positivity) (n : ℝ)]
  field_simp <;> ring

/-- Target T1(i)–(v) together, first bullet's second sentence, §1 p.85.
The explicit interval is a concentration interval centered on T_n. The
unbiasedness, score bound, finite tail bound and exact root-n width are all
included, uniformly for each law sharing the stated constants. -/
theorem known_propensity_finite_sample (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) :
    (L.measure[score L | covariateSigma] =ᵐ[L.measure]
      L.measure[fun u => potential true u - potential false u | covariateSigma]) ∧
    ((∫ u, score L u ∂L.measure) = ate L) ∧
    (∀ᵐ u ∂L.measure, |score L u| ≤ B / ε) ∧
    (∀ n : ℕ, 1 ≤ n →
      ((∫ s, estimator L n s ∂sampleLaw L.measure) = ate L) ∧
      (∀ t : ℝ, 0 ≤ t → (sampleLaw L.measure).real
        {s | t ≤ |estimator L n s - ate L|} ≤
          2 * Real.exp (-(n : ℝ) * t ^ 2 * ε ^ 2 / (2 * B ^ 2))) ∧
      (∀ α : ℝ, 0 < α → α < 1 →
        (1 - α ≤ (sampleLaw L.measure).real
          {s | ate L ∈ confidenceInterval L B ε α n s}) ∧
        (Real.sqrt n * (2 * halfWidth B ε α n) =
          2 * B / ε * Real.sqrt (2 * Real.log (2 / α))))) := by
  refine ⟨conditional_score_identity L h, score_unbiased L h, score_abs_le L h, ?_⟩
  intro n hn
  exact ⟨estimator_unbiased L h hn, fun _ ht => estimator_hoeffding L h hn ht,
    fun _ hα0 hα1 => ⟨confidenceInterval_coverage L h hn hα0 hα1,
      confidenceInterval_root_width h.1 h.2.1 hα0 hα1 hn⟩⟩

/-- The one-mean assumptions in target T1(vi), first bullet §1 p.85:
0≤Y(1)≤1 and a known positive lower propensity bound. No bound on Y(0)
or on the control probability is added to this substatement. -/
def TreatedMeanModel (L : CausalLaw) (ε : ℝ) : Prop :=
  0 < ε ∧ (∀ᵐ u ∂L.measure, potential true u ∈ Set.Icc 0 1) ∧
    (∀ᵐ u ∂L.measure, ε ≤ L.propensity (covariate u))

/-- Target T1(vi), first bullet §1 p.85: for the potential-outcome mean,
the HT estimator is unbiased, its contribution lies in [0,1/ε], its
two-sided tail is ≤2exp(-2nε²t²), and its stated concentration interval
has finite-sample coverage at least 1-α. -/
theorem treated_mean_finite_sample (L : CausalLaw) {ε : ℝ}
    (h : TreatedMeanModel L ε) :
    (∀ᵐ u ∂L.measure, armIPW L true u ∈ Set.Icc 0 (1 / ε)) ∧
    (∀ n : ℕ, 1 ≤ n →
      ((∫ s, treatedEstimator L n s ∂sampleLaw L.measure) = treatedMean L) ∧
      (∀ t : ℝ, 0 ≤ t → (sampleLaw L.measure).real
        {s | t ≤ |treatedEstimator L n s - treatedMean L|} ≤
          2 * Real.exp (-2 * n * ε ^ 2 * t ^ 2)) ∧
      (∀ α : ℝ, 0 < α → α < 1 →
        1 - α ≤ (sampleLaw L.measure).real
          {s | treatedMean L ∈ Set.Icc
            (treatedEstimator L n s - treatedHalfWidth ε α n)
            (treatedEstimator L n s + treatedHalfWidth ε α n)})) := by
  have hε : 0 < ε := h.1
  have hb : ∀ᵐ u ∂L.measure, armIPW L true u ∈ Set.Icc 0 (1 / ε) := by
    filter_upwards [h.2.1, h.2.2] with u hy hp
    have hp0 : 0 < L.propensity (covariate u) := lt_of_lt_of_le h.1 hp
    simp only [armIPW, armPropensity, Bool.true_eq, ↓reduceIte]
    unfold arm
    split_ifs
    · simp only [one_mul]
      exact ⟨div_nonneg hy.1 hp0.le, div_le_div₀ (by norm_num) hy.2 h.1 hp⟩
    · simp only [zero_mul, zero_div, Set.mem_Icc, le_refl, true_and]
      positivity
  have hy : Integrable (potential true) L.measure :=
    Integrable.of_mem_Icc 0 1 (measurable_potential true).aemeasurable h.2.1
  have hnum : Integrable (fun u => arm true u * potential true u) L.measure := by
    apply Integrable.of_bound
      ((measurable_arm true).mul (measurable_potential true)).aestronglyMeasurable 1
    filter_upwards [h.2.1] with u hu
    simp only [Pi.mul_apply, arm]
    split_ifs
    · simp only [one_mul, Real.norm_eq_abs, abs_of_nonneg hu.1]
      exact hu.2
    · simp
  have hz : Integrable (armIPW L true) L.measure :=
    Integrable.of_mem_Icc 0 (1 / ε) (measurable_armIPW L true).aemeasurable hb
  have hc := conditional_armIPW L true hy hnum hz
    (h.2.2.mono fun u hu => lt_of_lt_of_le h.1 hu)
  have hmu : (∫ u, armIPW L true u ∂L.measure) = treatedMean L := by
    calc
      _ = ∫ u, (L.measure[armIPW L true | covariateSigma]) u ∂L.measure :=
        (integral_condExp covariateSigma_le).symm
      _ = ∫ u, (L.measure[potential true | covariateSigma]) u ∂L.measure := integral_congr_ae hc
      _ = treatedMean L := integral_condExp covariateSigma_le
  have hid i : IdentDistrib (fun s : ℕ → UnitData => armIPW L true (s i))
      (armIPW L true) (sampleLaw L.measure) L.measure := by
    have hi : IdentDistrib (fun s : ℕ → UnitData => s i) id (sampleLaw L.measure) L.measure :=
      ⟨(measurable_pi_apply i).aemeasurable, measurable_id.aemeasurable,
        by rw [(sample_coordinate_hasLaw L.measure i).map_eq, Measure.map_id]⟩
    exact hi.comp (measurable_armIPW L true)
  have hbs i : ∀ᵐ s ∂sampleLaw L.measure, armIPW L true (s i) ∈ Set.Icc 0 (1 / ε) :=
    (hid i).symm.ae_mem_snd measurableSet_Icc hb
  have hmeans i : (∫ s, armIPW L true (s i) ∂sampleLaw L.measure) = treatedMean L :=
    (hid i).integral_eq.trans hmu
  have hmeas n : Measurable (treatedEstimator L n) :=
    (Finset.measurable_fun_sum (Finset.range n)
      (fun i _ => (measurable_armIPW L true).comp (measurable_pi_apply i))).div_const _
  refine ⟨hb, ?_⟩
  intro n hn
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (lt_of_lt_of_le Nat.zero_lt_one hn))
  have htail (t : ℝ) (ht : 0 ≤ t) :
      (sampleLaw L.measure).real {s | t ≤ |treatedEstimator L n s - treatedMean L|} ≤
        2 * Real.exp (-2 * n * ε ^ 2 * t ^ 2) := by
    have hr := bounded_independent_average_tail
      (fun i (s : ℕ → UnitData) => armIPW L true (s i))
      (iIndepFun_infinitePi fun _ => measurable_armIPW L true)
      (fun i => (measurable_armIPW L true).comp (measurable_pi_apply i))
      (by positivity : (0 : ℝ) < 1 / ε) hbs hmeans hn ht
    have he : -(n : ℝ) * t ^ 2 / (2 * ((1 / ε - 0) / 2) ^ 2) =
        -2 * n * ε ^ 2 * t ^ 2 := by
      field_simp [ne_of_gt hε] <;> ring
    rw [he] at hr
    exact hr
  refine ⟨?_, htail, ?_⟩
  · unfold treatedEstimator
    rw [integral_div, integral_finsetSum _ (fun i _ => (hid i).integrable_iff.mpr hz)]
    simp_rw [hmeans]
    simp [hn0]
  · intro α hα0 hα1
    have hq : 1 < 2 / α := (lt_div_iff₀ hα0).mpr (by linarith)
    have hlog : 0 ≤ Real.log (2 / α) := (Real.log_pos hq).le
    have hrad : 0 ≤ Real.log (2 / α) / (2 * (n : ℝ)) := by positivity
    have he : -2 * (n : ℝ) * ε ^ 2 * (treatedHalfWidth ε α n) ^ 2 =
        -Real.log (2 / α) := by
      unfold treatedHalfWidth
      rw [mul_pow, Real.sq_sqrt hrad]
      field_simp [ne_of_gt hε, hn0] <;> ring
    have hr := htail (treatedHalfWidth ε α n) (by unfold treatedHalfWidth; positivity)
    rw [he, Real.exp_neg, Real.exp_log (div_pos (by norm_num) hα0)] at hr
    have halpha : 2 * (2 / α)⁻¹ = α := by field_simp
    rw [halpha] at hr
    exact symmetric_interval_coverage (hmeas n) hr

/-- The suprema over laws and n in target T2(a), §1 p.85. Inserting zero
only makes the empty-class convention explicit; all probabilities are
nonnegative, so it does not change any nonempty model's supremum. Each law
uses ITS OWN supplied propensity in T_n. -/
def knownRootRisk (B ε K : ℝ) : ℝ :=
  sSup (insert 0 {r | ∃ L : CausalLaw, BoundedOverlap L B ε ∧
    ∃ n : ℕ, 1 ≤ n ∧ r = (sampleLaw L.measure).real
      {s | K < Real.sqrt n * |estimator L n s - ate L|}})

/-- The explicit uniform exponential bound in target T2(a), §1 p.85. -/
theorem estimator_root_tail (L : CausalLaw) {B ε : ℝ}
    (h : BoundedOverlap L B ε) {n : ℕ} (hn : 1 ≤ n) {K : ℝ} (hK : 0 ≤ K) :
    (sampleLaw L.measure).real {s | K ≤ Real.sqrt n * |estimator L n s - ate L|} ≤
      2 * Real.exp (-K ^ 2 * ε ^ 2 / (2 * B ^ 2)) := by
  have hnpos : (0 : ℝ) < n := by exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one hn)
  have hs : 0 < Real.sqrt (n : ℝ) := Real.sqrt_pos.mpr hnpos
  have ht := estimator_hoeffding L h hn (t := K / Real.sqrt n) (by positivity)
  have he : {s | K ≤ Real.sqrt n * |estimator L n s - ate L|} =
      {s | K / Real.sqrt n ≤ |estimator L n s - ate L|} := by
    ext s
    change K ≤ Real.sqrt n * |estimator L n s - ate L| ↔
      K / Real.sqrt n ≤ |estimator L n s - ate L|
    rw [div_le_iff₀ hs, mul_comm]
  rw [he]
  refine ht.trans_eq ?_
  apply congrArg (fun z : ℝ => 2 * Real.exp z)
  rw [div_pow, Real.sq_sqrt hnpos.le]
  field_simp

/-- Target T2(a), §1 p.85: uniform root-n tightness is the actual limit
of the supremum over ALL n≥1 and ALL population laws, with fixed B and ε. -/
theorem estimator_uniform_root_consistency {B ε : ℝ}
    (hB : 0 < B) (hε : 0 < ε) (hε1 : ε ≤ 1 / 2) :
    Tendsto (knownRootRisk B ε) atTop (𝓝 0) := by
  have hbdd K : BddAbove (insert 0 {r | ∃ L : CausalLaw, BoundedOverlap L B ε ∧
      ∃ n : ℕ, 1 ≤ n ∧ r = (sampleLaw L.measure).real
        {s | K < Real.sqrt n * |estimator L n s - ate L|}}) := by
    refine ⟨1, ?_⟩
    intro r hr
    rcases hr with rfl | ⟨L, hL, n, hn, rfl⟩
    · norm_num
    · exact (measureReal_mono (Set.subset_univ _)).trans_eq probReal_univ
  have hnonneg K : 0 ≤ knownRootRisk B ε K :=
    le_csSup (hbdd K) (Set.mem_insert _ _)
  have hbound K (hK : 0 ≤ K) : knownRootRisk B ε K ≤
      2 * Real.exp (-K ^ 2 * ε ^ 2 / (2 * B ^ 2)) := by
    apply csSup_le (Set.insert_nonempty _ _)
    intro r hr
    rcases hr with rfl | ⟨L, hL, n, hn, rfl⟩
    · positivity
    · have hsub : {s | K < Real.sqrt n * |estimator L n s - ate L|} ⊆
          {s | K ≤ Real.sqrt n * |estimator L n s - ate L|} := by
        intro s hs
        exact (show K ≤ Real.sqrt n * |estimator L n s - ate L| from le_of_lt hs)
      exact (measureReal_mono (μ := sampleLaw L.measure) hsub).trans
        (estimator_root_tail L hL hn hK)
  have hc : 0 < ε ^ 2 / (2 * B ^ 2) := by positivity
  have hp : Tendsto (fun K : ℝ => K ^ 2) atTop atTop := tendsto_pow_atTop (by norm_num)
  have he : Tendsto (fun K : ℝ => -K ^ 2 * ε ^ 2 / (2 * B ^ 2)) atTop atBot := by
    convert tendsto_neg_atTop_atBot.comp (hp.atTop_mul_const hc) using 1
    funext K
    simp only [Function.comp_def]
    ring
  have hexp : Tendsto (fun K : ℝ => 2 * Real.exp (-K ^ 2 * ε ^ 2 / (2 * B ^ 2)))
      atTop (𝓝 0) := by
    simpa using (Real.tendsto_exp_atBot.comp he).const_mul 2
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hexp
    (Eventually.of_forall hnonneg) ((eventually_ge_atTop 0).mono fun K hK => hbound K hK)

/-- Target T2 in full, first bullet's first sentence §1 p.85: uniform
root-n consistency, its explicit exponential inequality, and a pointwise
normal limit with variance Var(Z)≤B²/ε². `gaussianReal 0 0` is the point
mass at zero; nondegeneracy is not imposed. -/
theorem known_propensity_asymptotics {B ε : ℝ}
    (hB : 0 < B) (hε : 0 < ε) (hε1 : ε ≤ 1 / 2) :
    Tendsto (knownRootRisk B ε) atTop (𝓝 0) ∧
    (∀ (L : CausalLaw), BoundedOverlap L B ε →
      (∀ (n : ℕ), 1 ≤ n → ∀ K : ℝ, 0 ≤ K →
        (sampleLaw L.measure).real
          {s | K ≤ Real.sqrt n * |estimator L n s - ate L|} ≤
            2 * Real.exp (-K ^ 2 * ε ^ 2 / (2 * B ^ 2))) ∧
      variance (score L) L.measure ≤ B ^ 2 / ε ^ 2 ∧
      TendstoInDistribution (fun (n : ℕ) s => Real.sqrt n * (estimator L n s - ate L))
        atTop id (fun _ => sampleLaw L.measure)
        (gaussianReal 0 (variance (score L) L.measure).toNNReal)) := by
  exact ⟨estimator_uniform_root_consistency hB hε hε1,
    fun L h => ⟨fun _ hn _ hK => estimator_root_tail L h hn hK,
      score_variance_le L h, estimator_central_limit L h⟩⟩

/-- The covariate law Uniform(0,1), target T3, second bullet pp.85–86.
Lebesgue measure restricted to (0,1] has total mass one; endpoints have
zero probability, so it is exactly the stated uniform distribution. -/
def uniform01 : Measure ℝ := volume.restrict (Set.Ioc (0 : ℝ) 1)

instance uniform01_probability : IsProbabilityMeasure uniform01 := by
  constructor
  simp [uniform01, Real.volume_Ioc]

/-- Joint ignorability for T3's binary-outcome subclass, pp.85–86, as the
conditional factorization for every integrable measurable test of the
pair of potential outcomes. This is stronger than armwise ignorability. -/
def JointIgnorable (L : CausalLaw) : Prop :=
  ∀ (a : Bool) (f : ℝ × ℝ → ℝ), Measurable f →
    Integrable (fun u => f (potential false u, potential true u)) L.measure →
    L.measure[fun u => arm a u * f (potential false u, potential true u) |
      covariateSigma] =ᵐ[L.measure]
      fun u => armPropensity L.propensity a u *
        (L.measure[fun v => f (potential false v, potential true v) |
          covariateSigma]) u

/-- The unrestricted class P in target T3, second bullet pp.85–86:
uniform continuous W, binary potential outcomes, joint ignorability and
1/4≤e(W)≤3/4. Both e and outcome regressions remain arbitrary measurable
functions. The unknown procedure below is never given L.propensity. -/
def UnknownModel (L : CausalLaw) : Prop :=
  L.measure.map covariate = uniform01 ∧ JointIgnorable L ∧
    (∀ a, ∀ᵐ u ∂L.measure, potential a u = 0 ∨ potential a u = 1) ∧
    (∀ᵐ u ∂L.measure, (1 / 4 : ℝ) ≤ L.propensity (covariate u) ∧
      L.propensity (covariate u) ≤ 3 / 4)

/-- The actual observed unit (W,A,Y), used by the unknown-score procedures
of target T3, second bullet pp.85–86. -/
abbrev ObservedUnit := ℝ × Bool × ℝ

/-- The observed n-unit sample; hidden potential outcomes and e are omitted
from the input to T3's estimator, second bullet pp.85–86. -/
def observedSample (n : ℕ) (s : ℕ → UnitData) : Fin n → ObservedUnit :=
  fun i => (covariate (s i.val), (s i.val).2.1, observed (s i.val))


/-- A fair binary distribution, used only to construct the fixed law S
in target T3(b), pp.85–86. -/
def fairBool : Measure Bool :=
  bernoulliMeasure true false ⟨(1 / 2 : ℝ), by constructor <;> norm_num⟩

instance fairBool_probability : IsProbabilityMeasure fairBool := by
  unfold fairBool
  infer_instance

/-- The fixed law S in target T3(b): independent uniform W, fair A and
fair Y(1), with Y(0)=0. It is a concrete probability measure, not an
arbitrary law assumed to satisfy an indistinguishability conclusion. -/
def baselineLaw : Measure UnitData :=
  (uniform01.prod (fairBool.prod fairBool)).map
    (fun x => (x.1, x.2.1, (0, if x.2.2 then (1 : ℝ) else 0)))

instance baselineLaw_probability : IsProbabilityMeasure baselineLaw := by
  unfold baselineLaw
  infer_instance


/-- Cell treatment probability in the two families specified in T3's
finite construction: e_high=3/4 and e_low=1/4. The construction formalizes
the second bullet, pp.85–86, and is not printed in the rejoinder. -/
def cellPropensity (high : Bool) : ℝ := if high then 3 / 4 else 1 / 4

/-- Cell outcome mean in T3's finite construction: family A (true) has
m_high=1/3,m_low=1; family B (false) has m_high=2/3,m_low=0. -/
def cellMean (family high : Bool) : ℝ :=
  if family then (if high then 1 / 3 else 1) else (if high then 2 / 3 else 0)

/-- Observable probabilities of (A,Y)=(1,1),(1,0),(0,0), respectively,
in a fixed cell with conditionally independent A and Y(1), Y(0)=0.
Finite construction supplied in target T3(a), second bullet pp.85–86. -/
def cellObservable (family high : Bool) (k : Fin 3) : ℝ :=
  if k = 0 then cellPropensity high * cellMean family high
  else if k = 1 then cellPropensity high * (1 - cellMean family high)
  else 1 - cellPropensity high

/-- Both cell propensities obey the common overlap bound; T3 finite step. -/
theorem cell_overlap (high : Bool) : cellPropensity high ∈ Set.Icc (1 / 4 : ℝ) (3 / 4) := by
  cases high <;> norm_num [cellPropensity]

/-- The outcome means in both families are probabilities; T3 finite step. -/
theorem cell_mean_bounds (family high : Bool) : cellMean family high ∈ Set.Icc (0 : ℝ) 1 := by
  cases family <;> cases high <;> norm_num [cellMean]

/-- T3 finite step (a): mixing high/low cells with fair type gives EXACTLY
the same observable probabilities (1/4,1/4,1/2) in families A and B and
in the fixed baseline S. This is exact real arithmetic, not a simulation. -/
theorem single_cell_observable_agreement (family : Bool) (k : Fin 3) :
    (cellObservable family true k + cellObservable family false k) / 2 =
      if k = 2 then (1 / 2 : ℝ) else 1 / 4 := by
  cases family <;> fin_cases k <;> norm_num [cellObservable, cellPropensity, cellMean]

/-- Indicator of high cell type for T3's independent fair cell-type prior. -/
def highIndicator (b : Bool) : ℝ := if b then 1 else 0

/-- The proportion U of high cells in a type vector; T3 finite step (d). -/
def highProportion (M : ℕ) (σ : Fin M → Bool) : ℝ :=
  (M : ℝ)⁻¹ * ∑ j, highIndicator (σ j)

/-- The actual independent fair type prior on the M cells, T3 finite
construction. It is a finite product probability law, including at M=0. -/
def typePrior (M : ℕ) : Measure (Fin M → Bool) :=
  Measure.pi fun _ : Fin M => fairBool

instance typePrior_probability (M : ℕ) : IsProbabilityMeasure (typePrior M) := by
  unfold typePrior
  infer_instance

/-- The effects τ_A=1-(2/3)U and τ_B=(2/3)U from equal-length uniform
covariate cells, T3 finite step (d). These scalar functions record the
finite construction's effects, not additional model assumptions. -/
def familyEffect (family : Bool) (M : ℕ) (σ : Fin M → Bool) : ℝ :=
  if family then 1 - (2 / 3 : ℝ) * highProportion M σ
    else (2 / 3 : ℝ) * highProportion M σ

/-- The prior centers 2/3 for family A and 1/3 for family B; T3 finite (d). -/
def familyCenter (family : Bool) : ℝ := if family then 2 / 3 else 1 / 3

/-- Measurability of the high-cell indicator in T3's finite construction. -/
theorem measurable_highIndicator : Measurable highIndicator := by measurability

/-- Every high-cell indicator has finite moments; T3 finite construction. -/
theorem highIndicator_memLp (p : ℝ≥0∞) : MemLp highIndicator p fairBool := by
  apply MemLp.of_bound measurable_highIndicator.aestronglyMeasurable 1
  exact ae_of_all _ fun b => by cases b <;> norm_num [highIndicator]

/-- A fair high-cell indicator has mean exactly 1/2; T3 finite (d). -/
theorem highIndicator_mean : (∫ b, highIndicator b ∂fairBool) = (1 / 2 : ℝ) := by
  simp [fairBool, integral_bernoulliMeasure, highIndicator]

/-- A fair high-cell indicator has variance exactly 1/4; T3 finite (d). -/
theorem highIndicator_variance : variance highIndicator fairBool = (1 / 4 : ℝ) := by
  rw [variance_eq_sub (highIndicator_memLp 2), highIndicator_mean]
  have he : highIndicator ^ (2 : ℕ) = highIndicator := by
    funext b
    cases b <;> norm_num [highIndicator]
  rw [he, highIndicator_mean]
  norm_num

/-- Measurability of the high-cell proportion, T3 finite construction. -/
theorem measurable_highProportion (M : ℕ) : Measurable (highProportion M) :=
  (Finset.measurable_fun_sum Finset.univ
    (fun j _ => measurable_highIndicator.comp (measurable_pi_apply j))).const_mul _

/-- T3 finite step (d): the independent fair prior gives E[U]=1/2
and Var(U)=1/(4M) for every positive M. -/
theorem highProportion_moments {M : ℕ} (hM : 1 ≤ M) :
    ((∫ σ, highProportion M σ ∂typePrior M) = (1 / 2 : ℝ)) ∧
    variance (highProportion M) (typePrior M) = 1 / (4 * M) := by
  have hM0 : (M : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (lt_of_lt_of_le Nat.zero_lt_one hM))
  have hi (j : Fin M) : Integrable (fun σ => highIndicator (σ j)) (typePrior M) :=
    integrable_comp_eval ((highIndicator_memLp 1).integrable (by simp))
  constructor
  · unfold highProportion
    rw [integral_const_mul, integral_finsetSum _ (fun j _ => hi j)]
    have hj (j : Fin M) : (∫ σ, highIndicator (σ j) ∂typePrior M) = (1 / 2 : ℝ) := by
      exact (integral_comp_eval (μ := fun _ : Fin M => fairBool) (i := j)
        (f := highIndicator) measurable_highIndicator.aestronglyMeasurable).trans highIndicator_mean
    simp_rw [hj]
    simp [hM0]
  · unfold highProportion typePrior
    rw [variance_const_mul]
    have hv := variance_sum_pi (μ := fun _ : Fin M => fairBool)
      (X := fun _ => highIndicator) (fun _ => highIndicator_memLp 2)
    have hf : (∑ j : Fin M, fun σ : Fin M → Bool => highIndicator (σ j)) =
        (fun σ => ∑ j : Fin M, highIndicator (σ j)) := by
      funext σ
      simp only [Finset.sum_apply]
    rw [hf] at hv
    have he : variance (fun σ : Fin M → Bool => ∑ j, highIndicator (σ j))
        (Measure.pi fun _ : Fin M => fairBool) = (M : ℝ) * (1 / 4) := by
      simpa only [Finset.sum_apply, highIndicator_variance, Finset.sum_const,
        Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] using hv
    rw [he]
    field_simp

/-- T3 finite step (d): averaging the conditional means over the equal
length cells gives exactly the effects familyEffect, not just their
prior centers. -/
theorem familyEffect_eq_cell_average (family : Bool) {M : ℕ} (hM : 1 ≤ M)
    (σ : Fin M → Bool) :
    familyEffect family M σ = (∑ j, cellMean family (σ j)) / M := by
  have hM0 : (M : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (lt_of_lt_of_le Nat.zero_lt_one hM))
  have hc (b : Bool) : cellMean family b =
      if family then 1 - (2 / 3 : ℝ) * highIndicator b
        else (2 / 3 : ℝ) * highIndicator b := by
    cases family <;> cases b <;> norm_num [cellMean, highIndicator]
  simp_rw [hc]
  cases family <;> simp [familyEffect, highProportion, Finset.sum_sub_distrib,
    ← Finset.mul_sum, hM0] <;> field_simp [hM0] <;> ring

/-- The probability union step for T3's collision bound. Pair-collision
probabilities are hypotheses here; the link from continuous uniform
covariates to uniform cell labels is NOT claimed proved by this lemma. -/
theorem collision_union_bound {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [IsProbabilityMeasure P] (label : ℕ → Ω → ℕ) {M : ℝ} (hM : 0 < M)
    (hp : ∀ i j : ℕ, i < j → P.real {ω | label i ω = label j ω} ≤ 1 / M)
    (n : ℕ) :
    P.real {ω | ∃ i j : ℕ, i < j ∧ j < n ∧ label i ω = label j ω} ≤
      (n : ℝ) * (n - 1) / (2 * M) := by
  induction n with
  | zero => simp
  | succ n ih =>
    have hs : {ω | ∃ i j : ℕ, i < j ∧ j < n + 1 ∧ label i ω = label j ω} ⊆
        {ω | ∃ i j : ℕ, i < j ∧ j < n ∧ label i ω = label j ω} ∪
          ⋃ i ∈ Finset.range n, {ω | label i ω = label n ω} := by
      intro ω ⟨i, j, hij, hj, he⟩
      by_cases hjn : j < n
      · exact Or.inl ⟨i, j, hij, hjn, he⟩
      · have hj0 : j = n := by omega
        subst j
        exact Or.inr (Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨Finset.mem_range.mpr hij, he⟩⟩)
    calc
      _ ≤ P.real ({ω | ∃ i j : ℕ, i < j ∧ j < n ∧ label i ω = label j ω} ∪
          ⋃ i ∈ Finset.range n, {ω | label i ω = label n ω}) := measureReal_mono hs
      _ ≤ P.real {ω | ∃ i j : ℕ, i < j ∧ j < n ∧ label i ω = label j ω} +
          P.real (⋃ i ∈ Finset.range n, {ω | label i ω = label n ω}) := measureReal_union_le _ _
      _ ≤ (n : ℝ) * (n - 1) / (2 * M) + ∑ i ∈ Finset.range n, 1 / M := by
        apply add_le_add ih
        exact (measureReal_biUnion_finset_le _ _).trans
          (Finset.sum_le_sum fun i hi => hp i n (Finset.mem_range.mp hi))
      _ = ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) - 1) / (2 * M) := by
        simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul, Nat.cast_add, Nat.cast_one]
        ring

/-- Deterministic algebra in T3's two-point estimator step (e): given
the testing probabilities already obtained from separation and TV,
η≥1/2-16/M-n(n-1)/(4M). It does not assume or prove those TV premises. -/
theorem two_point_estimator_algebra {η pA pB M : ℝ} (n : ℕ)
    (hA : 1 - η - 16 / M ≤ pA) (hB : pB ≤ η + 16 / M)
    (hTV : pA - pB ≤ (n : ℝ) * (n - 1) / (2 * M)) :
    1 / 2 - 16 / M - (n : ℝ) * (n - 1) / (4 * M) ≤ η := by
  ring_nf at hA hB hTV ⊢
  linarith

/-- The exact interval geometry in T3's finite step (f): containing
one point from each separated open effect band forces width>1/6. -/
theorem separated_bands_force_width {lo hi x y : ℝ}
    (hx : x ∈ Set.Ioo (7 / 12 : ℝ) (3 / 4))
    (hy : y ∈ Set.Ioo (1 / 4 : ℝ) (5 / 12))
    (hCx : x ∈ Set.Icc lo hi) (hCy : y ∈ Set.Icc lo hi) :
    (1 / 6 : ℝ) < hi - lo := by
  linarith [hx.1, hy.2, hCx.2, hCy.1]


/-- The supplied propensity really is the conditional probability of
treatment, a consequence of the ALL-tests ignorability definition; §1 p.85. -/
theorem propensity_is_conditional_probability (L : CausalLaw) :
    L.measure[arm true | covariateSigma] =ᵐ[L.measure]
      fun u => L.propensity (covariate u) := by
  have h := L.ignorability true (fun _ => (1 : ℝ)) measurable_const (integrable_const 1)
  simpa only [mul_one, condExp_const covariateSigma_le, armPropensity, ↓reduceIte] using h

/-- The width of the actual endpoints of C_n is the deterministic 2h_n,
target T1(v), first bullet §1 p.85. -/
theorem confidenceInterval_endpoint_width (L : CausalLaw) (B ε α : ℝ) (n : ℕ)
    (s : ℕ → UnitData) :
    (estimator L n s + halfWidth B ε α n) -
      (estimator L n s - halfWidth B ε α n) = 2 * halfWidth B ε α n := by ring

/-- For positive M, every type vector's high proportion is between zero
and one; finite construction for target T3(d), pp.85–86. -/
theorem highProportion_bounds {M : ℕ} (hM : 1 ≤ M) (σ : Fin M → Bool) :
    highProportion M σ ∈ Set.Icc (0 : ℝ) 1 := by
  have hp : (0 : ℝ) < M := by exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one hM)
  have hx (b : Bool) : highIndicator b ∈ Set.Icc (0 : ℝ) 1 := by
    cases b <;> norm_num [highIndicator]
  have hsum0 : (0 : ℝ) ≤ ∑ j : Fin M, highIndicator (σ j) :=
    Finset.sum_nonneg fun j _ => (hx (σ j)).1
  have hsum1 : (∑ j : Fin M, highIndicator (σ j)) ≤ M := by
    simpa only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, mul_one]
      using (Finset.sum_le_sum (s := Finset.univ) (fun j _ => (hx (σ j)).2))
  unfold highProportion
  constructor
  · exact mul_nonneg (inv_nonneg.mpr hp.le) hsum0
  · rw [mul_comm, ← div_eq_mul_inv, div_le_iff₀ hp]
    simpa using hsum1

/-- Measurability of the finite family effects in target T3(d). -/
theorem measurable_familyEffect (family : Bool) (M : ℕ) : Measurable (familyEffect family M) := by
  cases family
  · exact (measurable_highProportion M).const_mul _
  · exact measurable_const.sub ((measurable_highProportion M).const_mul _)

/-- The cell-family effects lie in [0,1]; finite step for T3's prior bounds. -/
theorem familyEffect_bounds (family : Bool) {M : ℕ} (hM : 1 ≤ M) (σ : Fin M → Bool) :
    familyEffect family M σ ∈ Set.Icc (0 : ℝ) 1 := by
  have hu := highProportion_bounds hM σ
  cases family
  · change 0 ≤ (2 / 3 : ℝ) * highProportion M σ ∧ (2 / 3 : ℝ) * highProportion M σ ≤ 1
    constructor <;> linarith [hu.1, hu.2]
  · change 0 ≤ 1 - (2 / 3 : ℝ) * highProportion M σ ∧ 1 - (2 / 3 : ℝ) * highProportion M σ ≤ 1
    constructor <;> linarith [hu.1, hu.2]

/-- Finite moments of the type-prior effects, without enumerating 2^M
type vectors; finite lemma for target T3(d), pp.85–86. -/
theorem familyEffect_memLp (family : Bool) {M : ℕ} (hM : 1 ≤ M) (p : ℝ≥0∞) :
    MemLp (familyEffect family M) p (typePrior M) := by
  apply MemLp.of_bound (measurable_familyEffect family M).aestronglyMeasurable 1
  exact ae_of_all _ fun σ => by
    rw [Real.norm_eq_abs, abs_of_nonneg (familyEffect_bounds family hM σ).1]
    exact (familyEffect_bounds family hM σ).2

/-- T3 finite step (d): effects have exact prior means 2/3 and 1/3 and
variance 1/(9M), from the independent fair type prior for every M≥1. -/
theorem familyEffect_moments (family : Bool) {M : ℕ} (hM : 1 ≤ M) :
    ((∫ σ, familyEffect family M σ ∂typePrior M) = familyCenter family) ∧
    variance (familyEffect family M) (typePrior M) = 1 / (9 * M) := by
  have hu := highProportion_moments hM
  have hM0 : (M : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (lt_of_lt_of_le Nat.zero_lt_one hM))
  have hi : Integrable (highProportion M) (typePrior M) := by
    apply Integrable.of_mem_Icc 0 1 (measurable_highProportion M).aemeasurable
    exact ae_of_all _ (highProportion_bounds hM)
  cases family
  · constructor
    · change (∫ σ, (2 / 3 : ℝ) * highProportion M σ ∂typePrior M) = 1 / 3
      rw [integral_const_mul, hu.1]
      norm_num
    · change variance (fun σ => (2 / 3 : ℝ) * highProportion M σ) (typePrior M) = _
      rw [variance_const_mul, hu.2]
      field_simp <;> ring
  · constructor
    · change (∫ σ, 1 - (2 / 3 : ℝ) * highProportion M σ ∂typePrior M) = 2 / 3
      rw [integral_sub (integrable_const 1) (hi.const_mul _), integral_const_mul, hu.1]
      norm_num
    · change variance (fun σ => 1 - (2 / 3 : ℝ) * highProportion M σ) (typePrior M) = _
      rw [variance_const_sub ((measurable_highProportion M).const_mul _).aestronglyMeasurable,
        variance_const_mul, hu.2]
      field_simp <;> ring

/-- T3 finite step (d): the two prior effects deviate from their respective
centers by at least 1/12 with probability at most 16/M. This is a genuine
finite-prior Chebyshev bound for every positive M, not an assumed bound. -/
theorem familyEffect_prior_concentration (family : Bool) {M : ℕ} (hM : 1 ≤ M) :
    (typePrior M).real {σ | (1 / 12 : ℝ) ≤ |familyEffect family M σ - familyCenter family|} ≤
      16 / M := by
  have hh := meas_ge_le_variance_div_sq (familyEffect_memLp family hM 2)
    (by norm_num : (0 : ℝ) < 1 / 12)
  have hv := familyEffect_moments family hM
  rw [hv.1, hv.2] at hh
  have hpos : 0 ≤ (1 / (9 * (M : ℝ))) / (1 / 12 : ℝ) ^ 2 := by positivity
  have hr := ENNReal.toReal_mono ENNReal.ofReal_ne_top hh
  rw [ENNReal.toReal_ofReal hpos] at hr
  refine hr.trans_eq ?_
  field_simp <;> ring

/-- Probability-transfer algebra in T3's interval step (f). The hypotheses
are the two mixture marginal event bounds, two total-variation transfers
to S and the union/intersection bound. Their conclusion is the finite
lower bound; the mixture transfer bounds are hypotheses of this lemma. -/
theorem two_point_interval_algebra {α pA pB sA sB sAB q M : ℝ} (n : ℕ)
    (hA : 1 - α - 16 / M ≤ pA) (hB : 1 - α - 16 / M ≤ pB)
    (hSA : pA - (n : ℝ) * (n - 1) / (2 * M) ≤ sA)
    (hSB : pB - (n : ℝ) * (n - 1) / (2 * M) ≤ sB)
    (hInter : sA + sB - 1 ≤ sAB) (hWidth : sAB ≤ q) :
    1 - 2 * α - 32 / M - (n : ℝ) * (n - 1) / M ≤ q := by
  ring_nf at hA hB hSA hSB ⊢
  linarith


/-- Independent uniform cell labels collide with probability exactly 1/M.
This is the probability calculation underlying T3's finite step (b),
with uniform cell labels explicitly assumed, not a conclusion assumed. -/
theorem uniform_labels_pair_collision {Ω : Type*} [MeasurableSpace Ω]
    {P : Measure Ω} [IsProbabilityMeasure P] {M : ℕ} (hM : 1 ≤ M)
    (X Y : Ω → Fin M) (hX : Measurable X) (hY : Measurable Y)
    (hind : IndepFun X Y P)
    (hUX : ∀ k : Fin M, P.real {ω | X ω = k} = 1 / M)
    (hUY : ∀ k : Fin M, P.real {ω | Y ω = k} = 1 / M) :
    P.real {ω | X ω = Y ω} = 1 / M := by
  have he : {ω | X ω = Y ω} = ⋃ k : Fin M, {ω | X ω = k ∧ Y ω = k} := by
    ext ω
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion]
    constructor
    · intro hh
      exact ⟨X ω, rfl, hh.symm⟩
    · rintro ⟨k, hx, hy⟩
      exact hx.trans hy.symm
  have hm k : MeasurableSet {ω | X ω = k ∧ Y ω = k} :=
    (hX (measurableSet_singleton k)).inter (hY (measurableSet_singleton k))
  have hd : Pairwise (fun j k : Fin M => Disjoint
      {ω | X ω = j ∧ Y ω = j} {ω | X ω = k ∧ Y ω = k}) := by
    intro j k hjk
    apply Set.disjoint_left.mpr
    intro ω hωj hωk
    exact hjk (hωj.1.symm.trans hωk.1)
  have hp k : P.real {ω | X ω = k ∧ Y ω = k} = (1 / (M : ℝ)) ^ 2 := by
    have hi := hind.measure_inter_preimage_eq_mul {k} {k}
      (measurableSet_singleton k) (measurableSet_singleton k)
    have hr := congrArg ENNReal.toReal hi
    change P.real {ω | X ω = k ∧ Y ω = k} =
      (P {ω | X ω = k} * P {ω | Y ω = k}).toReal at hr
    rw [ENNReal.toReal_mul] at hr
    change P.real {ω | X ω = k ∧ Y ω = k} =
      P.real {ω | X ω = k} * P.real {ω | Y ω = k} at hr
    rw [hUX k, hUY k] at hr
    simpa only [pow_two] using hr
  rw [he, measureReal_iUnion_fintype hd hm]
  simp_rw [hp]
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hM0 : (M : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (lt_of_lt_of_le Nat.zero_lt_one hM))
  field_simp

/-- T3 finite step (b) for the induced independent uniform cell labels:
P(any repeated label among n observations)≤n(n-1)/(2M).
The separate analytic fact that equal-length Uniform(0,1) cells induce
these uniform labels is not included in this theorem. -/
theorem iid_uniform_labels_collision {Ω : Type*} [MeasurableSpace Ω]
    {P : Measure Ω} [IsProbabilityMeasure P] {M : ℕ} (hM : 1 ≤ M)
    (X : ℕ → Ω → Fin M) (hm : ∀ i, Measurable (X i)) (hind : iIndepFun X P)
    (hU : ∀ (i : ℕ) (k : Fin M), P.real {ω | X i ω = k} = 1 / M) (n : ℕ) :
    P.real {ω | ∃ i j : ℕ, i < j ∧ j < n ∧ X i ω = X j ω} ≤
      (n : ℝ) * (n - 1) / (2 * M) := by
  have hMp : (0 : ℝ) < M := by exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one hM)
  have hp i j (hij : i < j) : P.real {ω | (X i ω).val = (X j ω).val} ≤ 1 / M := by
    have he : {ω | (X i ω).val = (X j ω).val} = {ω | X i ω = X j ω} := by
      ext ω
      exact Fin.val_injective.eq_iff
    rw [he, uniform_labels_pair_collision hM (X i) (X j) (hm i) (hm j)
      (hind.indepFun (Nat.ne_of_lt hij)) (hU i) (hU j)]
  have hh := collision_union_bound (fun i ω => (X i ω).val) hMp hp n
  have he : {ω | ∃ i j : ℕ, i < j ∧ j < n ∧ X i ω = X j ω} =
      {ω | ∃ i j : ℕ, i < j ∧ j < n ∧ (X i ω).val = (X j ω).val} := by
    ext ω
    simp only [Set.mem_ofPred_eq, Fin.val_inj]
  rw [he]
  exact hh

/-- The total-variation transfer step used in T3(c): if two laws agree
on every measurable event restricted to a common event G, and each law
gives Gᶜ probability at most d, their probabilities differ by at most d
for every measurable event. Agreement on G is a hypothesis of this lemma. -/
theorem event_difference_of_agreement_on_good {Ω : Type*} [MeasurableSpace Ω]
    {P Q : Measure Ω} [IsProbabilityMeasure P] [IsProbabilityMeasure Q]
    {G : Set Ω} (hG : MeasurableSet G) {d : ℝ}
    (hag : ∀ E : Set Ω, MeasurableSet E → P.real (E ∩ G) = Q.real (E ∩ G))
    (hP : P.real Gᶜ ≤ d) (hQ : Q.real Gᶜ ≤ d)
    (E : Set Ω) (hE : MeasurableSet E) : |P.real E - Q.real E| ≤ d := by
  have hsp := measureReal_inter_add_sdiff (μ := P) hG (s := E)
  have hsq := measureReal_inter_add_sdiff (μ := Q) hG (s := E)
  have hEp : P.real (E \ G) ≤ d :=
    (measureReal_mono (μ := P) (Set.sdiff_subset_compl E G)).trans hP
  have hEq : Q.real (E \ G) ≤ d :=
    (measureReal_mono (μ := Q) (Set.sdiff_subset_compl E G)).trans hQ
  have hg := hag E hE
  rw [abs_le]
  constructor <;> linarith [measureReal_nonneg (μ := P) (s := E \ G),
    measureReal_nonneg (μ := Q) (s := E \ G)]


/-- Consistency gives 1{A=a}Y(a)=1{A=a}Y, so each HT arm contribution
is computed from observed data; target T1(vi), first bullet §1 p.85. -/
theorem armIPW_eq_observed (L : CausalLaw) (a : Bool) (u : UnitData) :
    armIPW L a u = arm a u * observed u / armPropensity L.propensity a u := by
  rcases u with ⟨w, t, y0, y1⟩
  cases a <;> cases t <;> simp [armIPW, arm, observed, potential]

/-- The one-mean estimator is literally n⁻¹Σ A_iY_i/e(W_i) as in
target T1(vi), first bullet §1 p.85. Its use of the potential-outcome
coordinate in armIPW is algebraically identical to this observed-data form. -/
theorem treatedEstimator_eq_observed_sum (L : CausalLaw) (n : ℕ) (s : ℕ → UnitData) :
    treatedEstimator L n s =
      (∑ i ∈ Finset.range n, arm true (s i) * observed (s i) /
        L.propensity (covariate (s i))) / n := by
  simp only [treatedEstimator, armIPW_eq_observed, armPropensity, ↓reduceIte]


/-- Measurability of the explicit construction of the fixed law S in
T3(b), second bullet pp.85–86. Its map is not a nonmeasurable fallback. -/
theorem measurable_baseline_map : Measurable
    (fun x : ℝ × Bool × Bool => (x.1, x.2.1, ((0 : ℝ), if x.2.2 then (1 : ℝ) else 0))) :=
  measurable_fst.prodMk (measurable_snd.fst.prodMk
    (measurable_const.prodMk (measurable_highIndicator.comp measurable_snd.snd)))

/-- The fixed law S really has the uniform continuous covariate law,
as required by target T3(b), second bullet pp.85–86. -/
theorem baseline_covariate_law : baselineLaw.map covariate = uniform01 := by
  unfold baselineLaw
  rw [Measure.map_map measurable_covariate measurable_baseline_map]
  change (uniform01.prod (fairBool.prod fairBool)).map Prod.fst = uniform01
  simp

/-- T3 finite step (d): the effect of the ONE fixed concrete law S is
exactly 1/2. This is an integral under baselineLaw, not a stipulated parameter. -/
theorem baseline_ate :
    (∫ u, potential true u - potential false u ∂baselineLaw) = (1 / 2 : ℝ) := by
  unfold baselineLaw
  have hm : AEStronglyMeasurable (fun u : UnitData => potential true u - potential false u)
      ((uniform01.prod (fairBool.prod fairBool)).map
        (fun x => (x.1, x.2.1, ((0 : ℝ), if x.2.2 then (1 : ℝ) else 0)))) :=
    ((measurable_potential true).sub (measurable_potential false)).aestronglyMeasurable
  rw [integral_map (f := fun u : UnitData => potential true u - potential false u)
    measurable_baseline_map.aemeasurable hm]
  simp only [potential, Bool.false_eq_true, ↓reduceIte, sub_zero]
  change (∫ x : ℝ × Bool × Bool, highIndicator x.2.2 ∂uniform01.prod (fairBool.prod fairBool)) = _
  have hs : HasLaw (fun x : ℝ × Bool × Bool => x.2.2) fairBool
      (uniform01.prod (fairBool.prod fairBool)) := by
    refine ⟨measurable_snd.snd.aemeasurable, ?_⟩
    change (uniform01.prod (fairBool.prod fairBool)).map (Prod.snd ∘ Prod.snd) = fairBool
    rw [← Measure.map_map measurable_snd measurable_snd]
    simp only [Measure.map_snd_prod, measure_univ, one_smul]
  exact (hs.integral_comp measurable_highIndicator.aestronglyMeasurable).trans highIndicator_mean


end

