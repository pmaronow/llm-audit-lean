import Mathlib

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace SAP.P001f

open MeasureTheory ProbabilityTheory
open scoped BigOperators ENNReal

noncomputable section
local instance (p : Prop) : Decidable p := Classical.propDecidable p

/-- An integrable version of the conditional expectation as a function of the covariate. -/
def ConditionalMean {Ω E : Type*} [MeasurableSpace Ω] [MeasurableSpace E]
    (μ : Measure Ω) (X : Ω → E) (Y : Ω → ℝ) (m : E → ℝ) : Prop :=
  Measurable m ∧ Integrable Y μ ∧ Integrable (m ∘ X) μ ∧
    ∀ A : Set E, MeasurableSet A →
      (∫ ω in X ⁻¹' A, Y ω ∂μ) = ∫ ω in X ⁻¹' A, m (X ω) ∂μ

/-- Eventwise conditional independence given the sigma algebra generated by X. -/
def ConditionallyIndependent {Ω E F G : Type*} [MeasurableSpace Ω]
    [MeasurableSpace E] [MeasurableSpace F] [MeasurableSpace G]
    (μ : Measure Ω) (X : Ω → E) (hX : Measurable X) (Y : Ω → F) (Z : Ω → G) : Prop :=
  ∀ (A : Set F) (B : Set G), MeasurableSet A → MeasurableSet B →
    (μ[(fun ω => if Y ω ∈ A ∧ Z ω ∈ B then (1 : ℝ) else 0) |
      MeasurableSpace.comap X inferInstance]) =ᵐ[μ]
    (fun ω => (μ[(fun ω => if Y ω ∈ A then (1 : ℝ) else 0) |
      MeasurableSpace.comap X inferInstance]) ω *
      (μ[(fun ω => if Z ω ∈ B then (1 : ℝ) else 0) |
        MeasurableSpace.comap X inferInstance]) ω)

/-- An infinite measurable independent sequence with a common law. -/
def IndependentCopies {Ω E : Type*} [MeasurableSpace Ω] [MeasurableSpace E]
    (μ : Measure Ω) (X : ℕ → Ω → E) : Prop :=
  (∀ i, Measurable (X i)) ∧ iIndepFun X μ ∧
    ∀ i, IdentDistrib (X i) (X 0) μ μ

/-- Average of the first n observations; all uses as a sample mean require n positive. -/
def sampleAverage {Ω : Type*} (X : ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  (∑ i ∈ Finset.range n, X i ω) / (n : ℝ)

/-- A real nonnegative Lebesgue density for a law. -/
def RealDensity {E : Type*} [MeasureSpace E]
    (ν : Measure E) (f : E → ℝ) : Prop :=
  AEMeasurable f volume ∧ (∀ x, 0 ≤ f x) ∧ Integrable f volume ∧
    ν = volume.withDensity (fun x => ENNReal.ofReal (f x))

/-- Conditional mean on a positive-probability conditioning event. -/
def eventMean {Ω E : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (X : Ω → E) (Y : Ω → ℝ) (x : E) : ℝ :=
  (∫ ω in {ω | X ω = x}, Y ω ∂μ) / (μ {ω | X ω = x}).toReal

def censoredOutcome (y r : ℝ) : ℝ := y * r + (-99) * (1 - r)

def realizedOutcome (y0 y1 d : ℝ) : ℝ := y1 * d + y0 * (1 - d)

def lowerATE (y d a b : ℝ) : ℝ := y * d + a * (1 - d) - y * (1 - d) - b * d

def upperATE (y d a b : ℝ) : ℝ := y * d + b * (1 - d) - y * (1 - d) - a * d

/-- Finite-law operations use the explicitly displayed probability weights. -/
def finiteMean {n : ℕ} (w Y : Fin n → ℝ) : ℝ := ∑ i, w i * Y i

def finiteProbability {n : ℕ} (w : Fin n → ℝ) (A : Fin n → Prop) : ℝ :=
  ∑ i, if A i then w i else 0

def finiteEventMean {n : ℕ} (w Y X : Fin n → ℝ) (x : ℝ) : ℝ :=
  (∑ i, if X i = x then w i * Y i else 0) / finiteProbability w (fun i => X i = x)

def FiniteConditionalIndependence {n : ℕ} {E F G : Type*} (w : Fin n → ℝ)
    (Y : Fin n → E) (Z : Fin n → F) (X : Fin n → G) : Prop :=
  ∀ (x : G) (y : E) (z : F), 0 < finiteProbability w (fun i => X i = x) →
    finiteProbability w (fun i => X i = x ∧ Y i = y ∧ Z i = z) *
      finiteProbability w (fun i => X i = x) =
    finiteProbability w (fun i => X i = x ∧ Y i = y) *
      finiteProbability w (fun i => X i = x ∧ Z i = z)

def attWeights : Fin 2 → ℝ := ![3 / 4, 1 / 4]

def exampleCensored : Fin 6 → ℝ := ![1, -99, 1, 0, 1, -99]
def exampleIndicator : Fin 6 → ℝ := ![1, 0, 1, 1, 1, 0]
def exampleCovariate : Fin 6 → Fin 2 := ![0, 0, 0, 0, 1, 1]
def exampleOutcome : Fin 6 → ℝ := ![1, 1, 1, 0, 1, 0]

/-- Respondent estimator, used below on a sample with four respondents. -/
def respondentAverage {n : ℕ} (ystar r : Fin n → ℝ) : ℝ :=
  (∑ i, ystar i * r i) / (∑ i, r i)

/-- Post-stratified estimator, used below with a respondent in each observed cell. -/
def poststratifiedAverage {n : ℕ} {E : Type*} [Fintype E] [DecidableEq E]
    (ystar r : Fin n → ℝ) (x : Fin n → E) : ℝ :=
  ∑ t, ((∑ i, if x i = t then ystar i * r i else 0) /
    (∑ i, if x i = t then r i else 0)) *
    ((∑ i, if x i = t then (1 : ℝ) else 0) / (n : ℝ))

end
end SAP.P001f
