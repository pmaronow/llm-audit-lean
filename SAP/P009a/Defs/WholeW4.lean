import Mathlib
import SAP.P009a.Defs

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace SAP.P009a

open Filter
open scoped BigOperators Topology Classical

noncomputable section

/-- The other half of the population; Lean units 0 and 1 are paper units 1 and 2. -/
def wholeSecondHalf (r : ℕ) : Finset (Fin (4*r+2)) := Finset.univ \ firstHalf r

/-- Integer treated counts, used only with an explicit fixed-total support condition. -/
def wholeTreatedCount {n : ℕ} (H : Finset (Fin n)) (z : TreatmentVector n) : ℕ :=
  ∑ j ∈ H, if z j then 1 else 0

/-- Exactly the incoming interference sets of the two exceptional units and the ordinary units. -/
def wholeHalfParents (r : ℕ) (j : Fin (4*r+2)) : Finset (Fin (4*r+2)) :=
  if j = 0 then firstHalf r else if j = 1 then wholeSecondHalf r else {j}

def wholeMajorityA (r : ℕ) (z : TreatmentVector (4*r+2)) : Prop :=
  r+1 ≤ wholeTreatedCount (firstHalf r) z

def wholeMinorityB (r : ℕ) (z : TreatmentVector (4*r+2)) : Prop :=
  wholeTreatedCount (wholeSecondHalf r) z ≤ r

/-- The full-cube schedule, all marginals, and all finite moment orders in Assumption 1. -/
def WholeHalfDesignFacts (r : ℕ) (E : FiniteExperiment (4*r+2)) : Prop :=
  FixedSizeDesign E (2*r+1) ∧ E.outcome = halfPopulationResponse r ∧
  (∀ i z, 0 ≤ E.outcome i z ∧ E.outcome i z ≤ 1) ∧
  (∀ i, armProbability E i true = 1/2) ∧
  (∀ q s : ℝ, 2 ≤ q → 1 ≤ s → Regularity E 2 q s)

/-- Exact partition, entrywise interference, dependence total, and outgoing counts. -/
def WholeHalfGraphFacts (r : ℕ) (E : FiniteExperiment (4*r+2)) : Prop :=
  (firstHalf r).card = 2*r+1 ∧ (wholeSecondHalf r).card = 2*r+1 ∧
  Disjoint (firstHalf r) (wholeSecondHalf r) ∧
  firstHalf r ∪ wholeSecondHalf r = Finset.univ ∧
  (∀ i j, interferenceIndicator E i j = if i ∈ wholeHalfParents r j then 1 else 0) ∧
  dependenceIndicator E 0 1 = 0 ∧
  (∑ i, ∑ j, dependenceIndicator E i j) = 3*((4*r+2 : ℕ) : ℝ)-4 ∧
  averageDependence E = 3-4/(4*r+2 : ℕ) ∧ averageDependence E < 3 ∧
  (∀ i, outgoingCount E i = if i = 0 ∨ i = 1 then 1 else 2) ∧
  averageOutgoing E = 2-2/(4*r+2 : ℕ) ∧ maximumOutgoing E = 2

/-- Majority events are preimages under the two masks, coincide on positive-mass assignments,
and witness the sharp mixing coefficient. The count identity prevents truncated subtraction. -/
def WholeHalfEventFacts (r : ℕ) (E : FiniteExperiment (4*r+2)) : Prop :=
  (∀ z, 0 < E.design.mass z →
    wholeTreatedCount (firstHalf r) z + wholeTreatedCount (wholeSecondHalf r) z = 2*r+1 ∧
    wholeTreatedCount (wholeSecondHalf r) z = 2*r+1-wholeTreatedCount (firstHalf r) z ∧
    (wholeMajorityA r z ↔ wholeMinorityB r z)) ∧
  (∃ U V : Set (TreatmentVector (4*r+2)),
    {z | wholeMajorityA r z} = relevantTreatments E 0 ⁻¹' U ∧
    {z | wholeMinorityB r z} = relevantTreatments E 1 ⁻¹' V) ∧
  probability E.design (wholeMajorityA r) = 1/2 ∧
  probability E.design (wholeMinorityB r) = 1/2 ∧
  probability E.design (fun z => wholeMajorityA r z ∧ wholeMinorityB r z) = 1/2 ∧
  |probability E.design (fun z => wholeMajorityA r z ∧ wholeMinorityB r z) -
    probability E.design (wholeMajorityA r) * probability E.design (wholeMinorityB r)| = 1/4 ∧
  mixingCoefficient E.design (relevantTreatments E 0) (relevantTreatments E 1) = 1/4

/--
P009-T9. p. 688 (PDF p. 16), first paragraph before Proposition 5, third sentence.
The printed claim is false: for every r ≥ 1, n = 4r+2 and h = 2r+1, complete
randomization with h treated units admits the stated half-population outcome schedule.
All outcomes are in [0,1], all treatment marginals are 1/2, and Assumption 1 holds
with k = 2 at every finite q ≥ 2 and s ≥ 1. The incoming sets are the disjoint
halves A and B for units 1 and 2 and singletons for the other units. Thus d₁₂ = 0,
the dependence sum is 3n-4, d_AVG = 3-4/n < 3, c₁ = c₂ = 1 and all other cᵢ = 2,
C₁ = 2-2/n and C_∞ = 2. On the design support T_B = h-T_A. The respective
majority and minority events belong to the sigma-algebras generated by the two
masked assignments, coincide almost surely, and each, as well as their intersection,
has probability 1/2. Their discrepancy and the pair mixing coefficient are 1/4
for every r, refuting all-pairs vanishing along this growing family.
-/
def T9WholeStatement : Prop :=
  ∀ r : ℕ, 1 ≤ r → ∃ E : FiniteExperiment (4*r+2),
    WholeHalfDesignFacts r E ∧ WholeHalfGraphFacts r E ∧ WholeHalfEventFacts r E

/-- Ordered pairs whose incoming interference sets are disjoint; diagonals are excluded. -/
def wholeZeroPairs {n : ℕ} (E : FiniteExperiment n) : Finset (Fin n × Fin n) :=
  Finset.univ.filter (fun ij => dependenceIndicator E ij.1 ij.2 = 0)

def wholePairMixing {n : ℕ} (E : FiniteExperiment n) (ij : Fin n × Fin n) : ℝ :=
  mixingCoefficient E.design (relevantTreatments E ij.1) (relevantTreatments E ij.2)

/-- The ordinary finite maximum on nonempty pair sets, with value zero on empty initial sets.
The theorem below proves that the sets in its limit are eventually nonempty. -/
def wholeMaximumMixing {n : ℕ} (E : FiniteExperiment n) (F : Finset (Fin n × Fin n)) : ℝ :=
  if h : F.Nonempty then F.sup' h (wholePairMixing E) else 0

/-- Both the literal maximum limit and its uniform epsilon formulation, with eventual domains. -/
def WholeExceptionalMixing (S : ExperimentSequence)
    (exceptions : (t : ℕ) → Finset (Fin (S.N t) × Fin (S.N t))) : Prop :=
  (∀ t, exceptions t ⊆ wholeZeroPairs (S.experiment t)) ∧
  (∀ᶠ t in atTop, 0 < (wholeZeroPairs (S.experiment t)).card ∧
    (wholeZeroPairs (S.experiment t) \ exceptions t).Nonempty) ∧
  Tendsto (fun t => ((exceptions t).card : ℝ) / (wholeZeroPairs (S.experiment t)).card)
    atTop (nhds 0) ∧
  Tendsto (fun t => wholeMaximumMixing (S.experiment t)
    (wholeZeroPairs (S.experiment t) \ exceptions t)) atTop (nhds 0) ∧
  (∀ ε > 0, ∀ᶠ t in atTop, ∀ i j, dependenceIndicator (S.experiment t) i j = 0 →
    (i,j) ∉ exceptions t → wholePairMixing (S.experiment t) (i,j) < ε)

/-- A regular growing complete-randomization sequence with a fixed exceptional pair.
The last clause explicitly says that uniform convergence with empty exceptions fails. -/
def WholeExceptionsNecessary : Prop :=
  ∃ S : ExperimentSequence,
    (∀ t, S.N t = 4*(t+1)+2) ∧ SequenceRegularity S 2 4 1 ∧
    (∀ t, ∃ m, FixedSizeDesign (S.experiment t) m) ∧
    (∀ t, averageDependence (S.experiment t) < 3) ∧
    ∃ a b : (t : ℕ) → Fin (S.N t),
      (∀ t, (a t).val = 0 ∧ (b t).val = 1 ∧
        dependenceIndicator (S.experiment t) (a t) (b t) = 0 ∧
        wholePairMixing (S.experiment t) (a t,b t) = 1/4) ∧
      ¬ (∀ ε > 0, ∀ᶠ t in atTop, ∀ i j,
        dependenceIndicator (S.experiment t) i j = 0 →
        wholePairMixing (S.experiment t) (i,j) < ε)

/--
P009-T10. p. 688 (PDF p. 16), first paragraph before Proposition 5, corrected sentence.
For every growing sequence of complete-randomization experiments with 0 < m < n
and eventually bounded average interference, there are exceptional sets E_n of
zero-dependence ordered pairs N₀ whose fraction |E_n|/|N₀| tends to zero. The
maximum mixing coefficient on N₀ minus E_n tends to zero, equivalently the
coefficients there become uniformly small. The denominator and the maximum's
index set are nonempty eventually, without assumptions on initial pair sets.
Exceptions cannot always be empty: a regular sequence with n = 4r+2 and d_AVG < 3
has the fixed pair of units 1 and 2 in N₀ with mixing coefficient 1/4 throughout.
-/
def T10WholeStatement : Prop :=
  (∀ S : ExperimentSequence,
    (∀ t, ∃ m, FixedSizeDesign (S.experiment t) m) →
    (∃ D : ℝ, ∀ᶠ t in atTop, averageDependence (S.experiment t) ≤ D) →
    ∃ exceptions, WholeExceptionalMixing S exceptions) ∧ WholeExceptionsNecessary

end
end SAP.P009a
