/-- T13 shared arithmetic: rounded nonnegative rational intervals preserve
ratios, products, natural scalar products, finite list sums, and rescaling.
Prove quotient bounds from Nat.div_mul_le_self and Nat.lt_mul_div_succ; for
ceilings use the positive-denominator identity ceil(n/d)=(n+d-1)/d.
Cast to the reals, obtain nonnegativity from Encloses, and use mul_le_mul.
Induct on List.Forall₂ for the fold. About 150–250 lines; no probability theory. -/
def T13_L1 : Prop := IntervalArithmeticSound

/-- T13 powers, using L1: binary exponentiation and the forward power table
preserve enclosures. Strong-induct on n for boundsPow, using n=2*(n/2)+n%2
and n%2<2, and induct on count for boundsPowersFrom. The latter returns a
Forall₂ relation to the list of actual powers, so no out-of-range entry is used.
About 80–150 lines, using pow_add, pow_mul, and List.range_succ_eq_map. -/
def T13_L2 : Prop := IntervalArithmeticSound → IntervalPowersSound

/-- T13 mixture enclosure, using L1 and the resulting power soundness:
the evaluator bounds the real binomialMixture for all positive scales and M,
and c≤B. Relate equal-length zipped power tables to the CDF terms; reversing
the q table gives exponents B-k. For k≤c≤B, (B-c)+(c-k)=B-k; for r<M,
M-(r+1) is nonnegative and casts to the real difference. Replace fast_choose
by Nat.choose using Nat.choose_eq_fast_choose. Apply the sum, ratio, product,
and rescaling rules. Fin.sum_univ_eq_sum_range identifies the outer sum.
About 180–300 lines; the zip lengths and the two subtraction guards are essential. -/
def T13_L3 : Prop :=
  IntervalArithmeticSound → IntervalPowersSound → MixtureEnclosureSound

/-- T13 weak cutoff, B=1000: the finite integer evaluator certifies the open
prefix interval (0.051792651792,0.051792651793). Prove by kernel-checked
integer evaluation. Cache the fast_choose coefficient list, split the 6435
rows into blocks of 32, prove block evaluations separately, then combine the
integer bounds. scratch/numeric_bounds.py generates outward block bounds and
records the output enclosure [5179265179265179265,5179265179265179266]/10^20.
No real-arithmetic proof is required in this leaf. -/
def T13_L4 : Prop := PrefixCertificate 1000 25 51792651792 51792651793 12

/-- T13 weak cutoff, B=10000: certify the open prefix interval
(0.050039580346,0.050039580347) by the same block evaluation as L4.
The integer output enclosure is
[5003958034654964961,5003958034654964962]/10^20.
The largest table has 251 entries. Precompute coefficients once; do not
expand the Pascal recursion for Nat.choose or enumerate assignments. -/
def T13_L5 : Prop := PrefixCertificate 10000 250 50039580346 50039580347 12

/-- T13 strict cutoff, B=1000: certify the open prefix interval
(0.049794649794,0.049794649795), with integer output enclosure
[4979464979464979464,4979464979464979465]/10^20.
Use the independently checked blocks generated by scratch/numeric_bounds.py,
as for L4. This is a finite integer certificate, not a simulation. -/
def T13_L6 : Prop := PrefixCertificate 1000 24 49794649794 49794649795 12

/-- T13 strict cutoff, B=10000: certify the open prefix interval
(0.049839600344,0.049839600345), with integer output enclosure
[4983960034454984959,4983960034454984960]/10^20.
Use cached coefficients and 32-row kernel-checked blocks as for L4–L5. -/
def T13_L7 : Prop := PrefixCertificate 10000 249 49839600344 49839600345 12

/-- T13 zero-p probability, B=1000: certify the open prefix interval
(0.001846625,0.001846626), with integer output enclosure
[184662509647353397,184662509647353398]/10^20.
Use the same evaluator with c=0; each row is just a rounded binary power.
The existing zero-event and power-sum identities are supplied in the assembly. -/
def T13_L8 : Prop := PrefixCertificate 1000 0 1846625 1846626 9

/-- Convert the natural-number prefix certificate to real open bounds. -/
private theorem prefix_bounds (hm : MixtureEnclosureSound)
    (B c lower upper digits : ℕ) (hc : c ≤ B)
    (h : PrefixCertificate B c lower upper digits) :
    (lower : ℝ)/(10 : ℝ)^digits < binomialMixture 6435 B c ∧
      binomialMixture 6435 B c < (upper : ℝ)/(10 : ℝ)^digits := by
  let a := mixtureBounds (10^600) (10^20) 6435 B c
  have hb : Encloses (10^20) a (binomialMixture 6435 B c) :=
    hm (10^600) (10^20) 6435 B c (by positivity) (by positivity) (by decide) hc
  have hlo : (lower : ℝ)*(10 : ℝ)^20 < (a.lo : ℝ)*(10 : ℝ)^digits := by
    exact_mod_cast h.1
  have hhi : (a.hi : ℝ)*(10 : ℝ)^digits < (upper : ℝ)*(10 : ℝ)^20 := by
    exact_mod_cast h.2
  have hb' : (a.lo : ℝ) ≤ (10 : ℝ)^20 * binomialMixture 6435 B c ∧
      (10 : ℝ)^20 * binomialMixture 6435 B c ≤ a.hi := by
    simpa only [Encloses, Nat.cast_pow, Nat.cast_ofNat] using hb
  have hs : (0 : ℝ) < (10 : ℝ)^20 := by positivity
  have hd : (0 : ℝ) < (10 : ℝ)^digits := by positivity
  constructor
  · apply (div_lt_iff₀ hd).mpr
    apply (mul_lt_mul_iff_right₀ hs).mp
    calc
      (10 : ℝ)^20 * lower = (lower : ℝ)*(10 : ℝ)^20 := by ring
      _ < (a.lo : ℝ)*(10 : ℝ)^digits := hlo
      _ ≤ ((10 : ℝ)^20 * binomialMixture 6435 B c)*(10 : ℝ)^digits :=
        mul_le_mul_of_nonneg_right hb'.1 hd.le
      _ = (10 : ℝ)^20 * (binomialMixture 6435 B c * (10 : ℝ)^digits) := by ring
  · apply (lt_div_iff₀ hd).mpr
    apply (mul_lt_mul_iff_right₀ hs).mp
    calc
      (10 : ℝ)^20 * (binomialMixture 6435 B c * (10 : ℝ)^digits) =
          ((10 : ℝ)^20 * binomialMixture 6435 B c)*(10 : ℝ)^digits := by ring
      _ ≤ (a.hi : ℝ)*(10 : ℝ)^digits := mul_le_mul_of_nonneg_right hb'.2 hd.le
      _ < (upper : ℝ)*(10 : ℝ)^20 := hhi
      _ = (10 : ℝ)^20 * upper := by ring

theorem T12_assembly : T12WholeStatement := by
  refine ⟨?_, Bridge.ks_not_effectIncreasingOnGroups, Bridge.exactValidity, ?_,
    AronowAudit.P016.t12_ks_p_table, AronowAudit.P016.t12_ks_size⟩
  · intro n
    exact AronowAudit.P016.t12_mean_effect_increasing
  · intro k
    exact (AronowAudit.P016.t1_design_tables.1 k).2

theorem T13_assembly (h1 : T13_L1) (h2 : T13_L2) (h3 : T13_L3)
    (h4 : T13_L4) (h5 : T13_L5) (h6 : T13_L6) (h7 : T13_L7) (h8 : T13_L8) :
    T13WholeStatement := by
  have hwhole : NoTiesWholeLaw := by
    intro B hB μ _ hex hnt α hα c hc hd
    by_cases ha : α < 1
    · exact AronowAudit.P016.t13_no_ties hB μ hex hnt α hα ha c hc hd
    · have hbase := AronowAudit.P016.t13_no_ties hB μ hex hnt 0
        (by norm_num) (by norm_num) 0 (by simp) (by omega)
      refine ⟨hbase.1, hbase.2.1, ?_⟩
      have ha1 : 1 ≤ α := le_of_not_gt ha
      have hf : α * B / 2 < (c : ℝ) + 1 := by
        simpa only [← hc] using Nat.lt_floor_add_one (α * (B : ℝ) / 2)
      have hBre : (B : ℝ) < 2 * (c : ℝ) + 2 := by
        have hBB : (B : ℝ) ≤ α * B := by nlinarith
        linarith
      have hBn : B < 2*c+2 := by exact_mod_cast hBre
      have hBodd : B = 2*c+1 := by omega
      have he : {t : ReferenceVector B | rawP (fun b => t b.succ) (t 0) ≤ α} = Set.univ := by
        ext t
        simp only [Set.mem_ofPred_eq, Set.mem_univ, iff_true]
        exact (min_le_left (1 : ℝ) _).trans ha1
      rw [he, probReal_univ, hBodd]
      push_cast
      field_simp
      ring
  refine ⟨hwhole, ?_, ?_, AronowAudit.P016.t13_finite_design, ?_,
    AronowAudit.P016.Wave1.t13_finite_rejection_proof, ?_,
    AronowAudit.P016.t13_numeric_certificates.1,
    AronowAudit.P016.t13_numeric_certificates.2.2.2.1,
    AronowAudit.P016.t13_numeric_certificates.2.2.2.2, ?_⟩
  · intro μ _ hex hnt
    have h := (hwhole 1000 (by decide) μ hex hnt
      (1/20) (by norm_num) 25 (by norm_num) (by decide)).2.2
    norm_num at h
    exact ⟨h, h.symm ▸ lt_of_lt_of_eq AronowAudit.P016.t13_numeric_certificates.2.1
      AronowAudit.P016.t13_numeric_certificates.1⟩
  · intro μ _ hex hnt
    have h := (hwhole 10000 (by decide) μ hex hnt
      (1/20) (by norm_num) 250 (by norm_num) (by decide)).2.2
    norm_num at h
    exact ⟨h, h.symm ▸ AronowAudit.P016.t13_numeric_certificates.2.2.1⟩
  · intro v hv
    exact AronowAudit.P016.Wave1.t13b_ssr_fibers v hv
  · intro B hB
    have hcut : 2*(B/40) < B := by
      have h := Nat.div_mul_le_self B 40
      omega
    have hfloor : Nat.floor ((1/20 : ℝ)*B/2) = B/40 := by
      rw [show (1/20 : ℝ)*B/2 = (B : ℝ)/(40 : ℕ) by norm_num; ring]
      exact Nat.floor_div_eq_div B 40
    let y : Outcome 16 := fun i => (2 : ℝ)^i.val
    have hmix : uniformMass (Fin (B+1) → Balanced 16 8) (fun draw =>
        lowerCount (fun b => rss y (draw b.succ).val) (rss y (draw 0).val) ≤ B/40 ∨
        upperCount (fun b => rss y (draw b.succ).val) (rss y (draw 0).val) ≤ B/40) =
        binomialMixture 6435 B (B/40) :=
      AronowAudit.P016.Wave1.t13b_concrete_mixture hcut
    apply (AronowAudit.P016.Wave1.t13b_uniform_congr _ _ ?_).trans hmix
    intro draw
    simpa only [SAP.P016b.rawP, SAP.P016b.doubledP, hfloor] using
      AronowAudit.P016.weak_integer_tail hB (1/20) (by norm_num) (by norm_num)
        (lowerCount (fun b => rss (fun i => (2 : ℝ)^i.val) (draw b.succ).val)
          (rss (fun i => (2 : ℝ)^i.val) (draw 0).val))
        (upperCount (fun b => rss (fun i => (2 : ℝ)^i.val) (draw b.succ).val)
          (rss (fun i => (2 : ℝ)^i.val) (draw 0).val))
  · have hm : MixtureEnclosureSound := h3 h1 (h2 h1)
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · convert prefix_bounds hm 1000 25 51792651792 51792651793 12 (by decide) h4 using 1 <;> norm_num
    · convert prefix_bounds hm 10000 250 50039580346 50039580347 12 (by decide) h5 using 1 <;> norm_num
    · convert prefix_bounds hm 1000 24 49794649794 49794649795 12 (by decide) h6 using 1 <;> norm_num
    · convert prefix_bounds hm 10000 249 49839600344 49839600345 12 (by decide) h7 using 1 <;> norm_num
    · convert prefix_bounds hm 1000 0 1846625 1846626 9 (by decide) h8 using 1 <;> norm_num

theorem T16_assembly : T16WholeStatement := by
  refine ⟨?_, ?_, ?_, AronowAudit.P016.t16_joint_hypothesis⟩
  · intro n Y z i t t' a a' ha ha'
    exact AronowAudit.P016.t16_group_adjustments Y z i t t' a a' ha ha'
  · intro n Y z t a x _ ha
    exact AronowAudit.P016.t16_control_ecdf Y z t a x ha
  · intro n _ u x
    exact AronowAudit.P016.t16_ecdf_argument u x

end
