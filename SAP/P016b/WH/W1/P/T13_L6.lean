def rowSum (start count : ℕ) : NatBounds :=
  boundsSum ((List.range' start count).map fun r => mixtureRowBounds (10^600) 6435 1000 24 (r+1) coeffs)

theorem fold_eq (xs : List NatBounds) (a : NatBounds) :
    xs.foldl boundsAdd a =
      ⟨a.lo + (xs.map NatBounds.lo).sum, a.hi + (xs.map NatBounds.hi).sum⟩ := by
  induction xs generalizing a with
  | nil => cases a; simp
  | cons x xs ih =>
    simp only [List.foldl_cons, ih, List.map_cons, List.sum_cons, boundsAdd]
    simp only [Nat.add_assoc]

theorem sum_append (xs ys : List NatBounds) :
    boundsSum (xs ++ ys) = boundsAdd (boundsSum xs) (boundsSum ys) := by
  simp [boundsSum, fold_eq, boundsAdd, boundsZero]

theorem rowSum_split (start n m : ℕ) :
    rowSum start (n+m) = boundsAdd (rowSum start n) (rowSum (start+n) m) := by
  unfold rowSum
  rw [← List.range'_append_1, List.map_append, sum_append]

