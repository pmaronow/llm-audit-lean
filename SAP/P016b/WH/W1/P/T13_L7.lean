theorem boundsSum_foldl (a : NatBounds) (xs : List NatBounds) :
    List.foldl boundsAdd a xs = boundsAdd a (boundsSum xs) := by
  induction xs generalizing a with
  | nil => simp [boundsSum, boundsAdd, boundsZero]
  | cons b xs ih =>
      simp only [List.foldl_cons]
      rw [ih]
      have hs : boundsSum (b :: xs) = boundsAdd b (boundsSum xs) := by
        change List.foldl boundsAdd (boundsAdd boundsZero b) xs = _
        have hz : boundsAdd boundsZero b = b := by cases b; simp [boundsAdd, boundsZero]
        rw [hz, ih b]
      rw [hs]
      cases a; cases b; simp [boundsAdd, Nat.add_assoc]

theorem boundsSum_cons (a : NatBounds) (xs : List NatBounds) :
    boundsSum (a :: xs) = boundsAdd a (boundsSum xs) := by
  change List.foldl boundsAdd (boundsAdd boundsZero a) xs = _
  have hz : boundsAdd boundsZero a = a := by cases a; simp [boundsAdd, boundsZero]
  rw [hz, boundsSum_foldl]

theorem boundsSum_append (xs ys : List NatBounds) :
    boundsSum (xs ++ ys) = boundsAdd (boundsSum xs) (boundsSum ys) := by
  unfold boundsSum
  rw [List.foldl_append]
  rw [boundsSum_foldl]
  rfl

theorem boundsSum_flatMap {α : Type} (xs : List α) (f : α → List NatBounds) :
    boundsSum (xs.flatMap f) = boundsSum (xs.map fun x => boundsSum (f x)) := by
  induction xs with
  | nil => simp [boundsSum]
  | cons x xs ih =>
      simp only [List.flatMap_cons, List.map_cons]
      rw [boundsSum_append, ih]
      rw [boundsSum_cons]

theorem map_join_chunks (f : ℕ → NatBounds) (k : ℕ) :
    List.flatMap (fun b => (List.range 32).map fun r => f (32*b+r)) (List.range k) =
      (List.range (32*k)).map f := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hk : List.range (k+1) = List.range k ++ [k] := by simp [List.range_succ]
      rw [hk]
      simp only [List.flatMap_append, List.flatMap_cons, List.flatMap_nil]
      rw [ih]
      have hm : 32*(k+1) = 32*k+32 := by omega
      rw [hm, List.range_add]
      simp only [List.map_append, List.map_map]
      congr 1

theorem rows_split (f : ℕ → NatBounds) :
    (List.range 6435).map f =
      List.flatMap (fun b => (List.range 32).map fun r => f (32*b+r)) (List.range 201) ++
        (List.range 3).map fun j => f (6432+j) := by
  rw [show 6435 = 6432 + 3 by norm_num, List.range_add]
  simp only [List.map_append, List.map_map]
  rw [show 6432 = 32*201 by norm_num, ← map_join_chunks f 201]
  rfl

private theorem rowSum_split :
    boundsSum ((List.range 6435).map evalRow) =
      boundsAdd (boundsSum ((List.range 201).map cachedBlock))
        (boundsSum ((List.range 3).map fun j => evalRow (6432+j))) := by
  rw [rows_split evalRow, boundsSum_append, boundsSum_flatMap]
  rfl

private theorem rowSum_cached :
    boundsSum ((List.range 6435).map evalRow) = (⟨, ⟩ : NatBounds) := by
  have htail : boundsSum ((List.range 3).map fun j => evalRow (6432+j)) = (⟨0, ⟩ : NatBounds) := by
    simpa only [cachedTail] using block_tail
  rw [rowSum_split, blocks_sum, htail]
