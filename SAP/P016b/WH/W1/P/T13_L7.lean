private theorem rowSum_actual :
    boundsSum ((List.range 6435).map fun r =>
      mixtureRowBounds (10^600) 6435 10000 249 (r+1)
        ((List.range 250).map (Nat.fast_choose 10000))) = (⟨, ⟩ : NatBounds) := by
  rw [← rowSum_cached]
  apply congrArg boundsSum
  apply List.map_congr_left
  intro r hr
