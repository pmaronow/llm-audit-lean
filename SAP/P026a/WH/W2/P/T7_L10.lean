theorem feVarianceCache_correct : ∀ w : W2Allocation,
    w2FeVariance w = feVarianceCache w.1 w.2 := by
  intro w
  fin_cases w
  all_goals
    simp only [w2FeVariance, w2ClusterHC1, Matrix.inv_def, Ring.inverse_eq_inv,
      Matrix.det_fin_three, Matrix.adjugate_fin_three]
    decide +kernel

