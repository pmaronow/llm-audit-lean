import Mathlib

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace SAP.P036

open MeasureTheory
open scoped BigOperators

noncomputable section

/-- The peer regressor is one on the peer arm and zero on its complement. -/
def peers {ι : Type*} (peerArm : Set ι) (i : ι) : ℝ :=
  peerArm.indicator (fun _ => 1) i

/-- The finite covariate vector multiplied by its real coefficient vector. -/
def covariateContribution {Ω : Type*} {k : ℕ}
    (X : Ω → Fin k → ℝ) (γ : Fin k → ℝ) (ω : Ω) : ℝ :=
  ∑ j, X ω j * γ j

/-- The predictor in the corrected Section III regression model. -/
def linearPredictor {Ω : Type*} {k : ℕ} (peer : Set Ω)
    (X : Ω → Fin k → ℝ) (β₀ β₁ : ℝ) (γ : Fin k → ℝ) (ω : Ω) : ℝ :=
  β₀ + β₁ * peers peer ω + covariateContribution X γ ω

/-- The sigma-algebra generated by the assignment indicator and covariates. -/
def regressorSigma {Ω : Type*} {k : ℕ} (peer : Set Ω)
    (X : Ω → Fin k → ℝ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω => (peers peer ω, X ω)) inferInstance

/-- The sigma-algebra generated by the assignment indicator alone. -/
def assignmentSigma {Ω : Type*} (peer : Set Ω) : MeasurableSpace Ω :=
  MeasurableSpace.comap (peers peer) inferInstance

/-- The arm's integral divided by its probability; T1 requires positive arm probabilities. -/
def conditionalArmMean {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (arm : Set Ω) (Y : Ω → ℝ) : ℝ :=
  (∫ ω in arm, Y ω ∂μ) / μ.real arm

/-- An arm mean; its uses in T1 and T2 have nonempty arms. -/
def armMean {ι : Type*} (s : Finset ι) (Y : ι → ℝ) : ℝ :=
  (∑ i ∈ s, Y i) / (s.card : ℝ)

/-- The sum of squares about an arm's mean. -/
def armSS {ι : Type*} (s : Finset ι) (Y : ι → ℝ) : ℝ :=
  ∑ i ∈ s, (Y i - armMean s Y) ^ 2

/-- The sample variance with divisor equal to arm size minus one. -/
def sampleVariance {ι : Type*} (s : Finset ι) (Y : ι → ℝ) : ℝ :=
  armSS s Y / ((s.card : ℝ) - 1)

/-- The unadjusted least-squares objective, with an intercept and peer indicator. -/
def rss {ι : Type*} [Fintype ι] (s : Finset ι) (Y : ι → ℝ)
    (b₀ b₁ : ℝ) : ℝ :=
  ∑ i, (Y i - b₀ - b₁ * peers (s : Set ι) i) ^ 2

/-- The candidate intercept and slope, certified as the unique minimizer in T1. -/
def olsCoefficients {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : Finset ι) (Y : ι → ℝ) : ℝ × ℝ :=
  (armMean sᶜ Y, armMean s Y - armMean sᶜ Y)

/-- Coefficients calculated from response counts in arms of sizes 94 and 95. -/
def tableCoefficients (k₁ k₀ : ℕ) : ℝ × ℝ :=
  ((k₀ : ℝ) / 95, (k₁ : ℝ) / 94 - (k₀ : ℝ) / 95)

/-- Three-decimal rounding, with a half-open interval and upward ties. -/
def roundsToThree (x displayed : ℝ) : Prop :=
  displayed - 1 / 2000 ≤ x ∧ x < displayed + 1 / 2000

end

end SAP.P036
